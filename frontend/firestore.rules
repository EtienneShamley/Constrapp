rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Comments here are deliberately brief: Firestore refuses a ruleset over 256 KB
    // of source (ADR-51, ADR-60). The rationale, enforced controls and client-only
    // gaps for every collection live in docs/SECURITY.md and the ADRs in
    // docs/PROJECT_DECISIONS.md.
    // ── Shared helpers (ADR-60) ──────────────────────────────────────────────
    // Declared once here and visible to every match below (functions declared
    // in an outer match are in scope in nested matches). Path wildcards are NOT
    // in scope at this level, so tenant helpers take companyId / projectId from
    // the calling match. Bodies are byte-for-byte the per-block helpers they
    // replace; no helper reads a document its callers did not already read.

    // The caller's role, from their membership document.
    function memberRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    // Any provisioned member of THIS company, regardless of role.
    function sameCompany(companyId) {
      return request.auth != null
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
    }
    // The internal financial roles (ADR-56) of THIS company.
    function financialMember(companyId) {
      return request.auth != null
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['company_admin', 'project_manager', 'qs'];
    }
    // Keys this update changes.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // Every write path stamps the caller and the server time.
    function updateStamped() {
      return request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
    }
    // MONEY IS DECIMAL; IEEE-754 IS NOT. Rules numbers are doubles, so an exact
    // `subtotal + gstTotal == grossTotal` REJECTS legitimate cent values (0.10 +
    // 0.20 is 0.30000000000000004). Both sides are therefore compared as WHOLE
    // CENTS via math.round() — a REPRESENTATION FIX, NOT A WEAKENED INVARIANT:
    // exactly a half-cent tolerance, so any discrepancy of one cent or more still
    // fails. lib/purchaseOrders.js → roundMoney() and lib/payments.js → toCents()
    // mirror this, so a write the client considers valid is never rejected here.
    function cents(v) {
      return math.round(v * 100);
    }
    // GST (flat 10%) on a non-negative whole-cent amount, round-half-up. Mirrors
    // roundMoney(x * GST_RATE) / lib/retention.js → cumulativeRetentionGst.
    //
    // ⚠️ DO NOT "SIMPLIFY" THIS TO math.round(c / 10). Firestore Rules and
    // JavaScript DISAGREE there, and it was proven in the emulator: Rules `/` on
    // two integers TRUNCATES, so 10005/10 yields 1000 while JS Math.round(1000.5)
    // yields 1001 — a one-cent divergence that would reject legitimate client
    // writes in production while every unit test passed. `math.floor((c + 5) / 10)`
    // is round-half-up for non-negative c and is correct under EITHER division
    // semantics. Every caller validates its operands >= 0 before reaching this
    // (pinned by tests/rules/retentionReleases.rules.test.js).
    function gstCents(c) {
      return math.floor((c + 5) / 10);
    }
    // `revision` EXACTLY +1 on every update, a missing key reading as 0 (the
    // progressClaims / variations idiom, ADR-58 / ADR-59: rules-ASSISTED
    // concurrency for the client's revision-guarded transactions, not
    // rules-proven — DC36 / DC37).
    function revisionIncremented() {
      return request.resource.data.revision is number
          && request.resource.data.revision == resource.data.get('revision', 0) + 1;
    }
    // A DATE-ONLY string, YYYY-MM-DD (string comparison is exact for zero-padded ISO).
    function isIsoDate(v) {
      return v is string
          && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }
    // Cash records (clientReceipts / supplierPayments): the one arithmetic
    // guarantee rules CAN give — a record may never claim to have allocated more
    // money than it received or paid.
    function amountInvariant() {
      return request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.allocatedTotal is number
          && request.resource.data.allocatedTotal >= 0
          && request.resource.data.unallocatedAmount is number
          && request.resource.data.unallocatedAmount >= 0
          && cents(request.resource.data.allocatedTotal + request.resource.data.unallocatedAmount)
             == cents(request.resource.data.amount);
    }
    // The calling match's project, and the PO the incoming document names.
    function projectPath(companyId, projectId) {
      return /databases/$(database)/documents/companies/$(companyId)/projects/$(projectId);
    }
    function poPath(companyId, projectId) {
      return /databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/purchaseOrders/$(request.resource.data.poId);
    }
    // lib/currency.js → resolveProjectCurrency, mirrored: the project's
    // well-formed `currency`, else the company's well-formed `baseCurrency`, else
    // AUD. Checked at CREATE only (the field is frozen afterwards).
    function resolvedCurrency(companyId, projectId) {
      let pc = get(projectPath(companyId, projectId)).data.get('currency', '');
      let cc = get(/databases/$(database)/documents/companies/$(companyId)).data.get('baseCurrency', '');
      return (pc is string && pc.matches('^[A-Z]{3}$')) ? pc
           : ((cc is string && cc.matches('^[A-Z]{3}$')) ? cc : 'AUD');
    }


    // Membership documents — a user may READ THEIR OWN PROFILE AND NOTHING ELSE.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // Companies — readable by members; create / delete blocked (provisioned by admin
    // tooling); company_admin may update the FOUR currency fields only, codes
    // shape-tested, not enumerated (an enum here would drift from lib/currency.js).
    match /companies/{companyId} {
      allow read: if request.auth != null
                  && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
      allow create, delete: if false;
      allow update: if request.auth != null
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'company_admin'
                  && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['countryCode', 'baseCurrency', 'currencyUpdatedAt', 'currencyUpdatedBy'])
                  && request.resource.data.countryCode is string
                  && request.resource.data.countryCode.matches('^[A-Z]{2}$')
                  && request.resource.data.baseCurrency is string
                  && request.resource.data.baseCurrency.matches('^[A-Z]{3}$');
    }

    // Projects — read by any member of the company; create / update company_admin
    // and project_manager (plus the QS currency-lock ratchet); delete blocked.
    match /companies/{companyId}/projects/{projectId} {
      // Status vocabulary mirrors lib/projects.js → PROJECT_STATUSES (short and
      // product-owned, so enumerated — unlike the shape-tested currency codes).
      function validProjectStatus(s) {
        return s in ['Planning', 'In Progress', 'Backlogged', 'On Hold', 'Completed'];
      }
      // Field is untouched by this write, or the incoming value is well-formed.
      function statusOk() {
        return request.resource.data.get('status', '') == resource.data.get('status', '')
            || validProjectStatus(request.resource.data.get('status', ''));
      }
      function nameOk() {
        return request.resource.data.get('name', '') == resource.data.get('name', '')
            || (request.resource.data.get('name', '') is string
                && request.resource.data.get('name', '').size() > 0
                && request.resource.data.get('name', '').size() <= 200);
      }
      function progressOk() {
        return request.resource.data.get('progress', 0) == resource.data.get('progress', 0)
            || (request.resource.data.get('progress', 0) is number
                && request.resource.data.get('progress', 0) >= 0
                && request.resource.data.get('progress', 0) <= 100);
      }
      function locationOk() {
        return request.resource.data.get('location', '') == resource.data.get('location', '')
            || (request.resource.data.get('location', '') is string
                && request.resource.data.get('location', '').size() <= 200);
      }
      function startDateOk() {
        return request.resource.data.get('startDate', null) == resource.data.get('startDate', null)
            || request.resource.data.get('startDate', null) == null
            || request.resource.data.get('startDate', null) is timestamp;
      }
      // The headline budget and the provenance stamps that NO update may move.
      function projectCorePreserved() {
        return request.resource.data.get('budget', 0) == resource.data.get('budget', 0)
            && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
            && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null);
      }
      allow read: if request.auth != null
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;

      allow create: if request.auth != null
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['company_admin', 'project_manager']
                  && (!('currency' in request.resource.data)
                      || (request.resource.data.currency is string
                          && request.resource.data.currency.matches('^[A-Z]{3}$')))
                  && (!('currencyLocked' in request.resource.data)
                      || request.resource.data.currencyLocked is bool);

      allow update: if request.auth != null
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
                  && (
                       // (a) Normal project write — company_admin / project_manager,
                       //     subject to the currency ratchet.
                       (
                         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['company_admin', 'project_manager']
                         && (!('currency' in request.resource.data)
                             || (request.resource.data.currency is string
                                 && request.resource.data.currency.matches('^[A-Z]{3}$')))
                         && (!('currencyLocked' in request.resource.data)
                             || request.resource.data.currencyLocked is bool)
                         // Never unlock.
                         && (resource.data.get('currencyLocked', false) == false
                             || request.resource.data.get('currencyLocked', false) == true)
                         // Currency frozen while locked — with exactly ONE
                         // carve-out: a locked project that stores NO
                         // well-formed currency may receive its FIRST explicit
                         // code (see LEGACY INITIALISATION above). The stored
                         // code is shape-tested with the same '^[A-Z]{3}$'
                         // pattern the request is validated against, so the
                         // carve-out and the freeze partition every possible
                         // stored value between them with no gap.
                         && (resource.data.get('currencyLocked', false) == false
                             || !(resource.data.get('currency', '') is string
                                  && resource.data.get('currency', '').matches('^[A-Z]{3}$'))
                             || request.resource.data.get('currency', '') == resource.data.get('currency', ''))
                         // ADR-39 metadata correction: headline budget and
                         // provenance frozen, editable fields shape-validated
                         // on change. See the METADATA CORRECTION note above.
                         && projectCorePreserved()
                         && statusOk()
                         && nameOk()
                         && progressOk()
                         && locationOk()
                         && startDateOk()
                       )
                       ||
                       // (b) QS currency-lock ratchet ONLY: false/absent -> true,
                       //     affecting that single key and nothing else.
                       (
                         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'qs'
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currencyLocked'])
                         && request.resource.data.currencyLocked == true
                         && resource.data.get('currencyLocked', false) == false
                       )
                     );

      allow delete: if false;
    }

    // Company Cost Codes — the company-wide taxonomy. Financial roles read and
    // write (ADR-56); delete blocked (isActive: false instead).
    match /companies/{companyId}/costCodes/{costCodeId} {
      // Same three roles write; kept as a named alias for the update rule below.
      function costCodeWriter() {
        return financialMember(companyId);
      }
      allow read: if financialMember(companyId);

      allow create: if costCodeWriter();

      allow update: if costCodeWriter()
                  // Provenance is immutable.
                  && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
                  && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
                  // Only the content fields and the audit stamps may move.
                  && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['code', 'name', 'category', 'unit', 'isActive', 'updatedAt', 'updatedBy'])
                  && request.resource.data.code is string
                  && request.resource.data.code.size() > 0
                  && request.resource.data.code.size() <= 40
                  && request.resource.data.name is string
                  && request.resource.data.name.size() > 0
                  && request.resource.data.name.size() <= 120
                  && request.resource.data.get('category', '') is string
                  && request.resource.data.get('category', '').size() <= 80
                  && request.resource.data.get('unit', '') is string
                  && request.resource.data.get('unit', '').size() <= 24
                  // Absent means ACTIVE (legacy documents predate the flag), so
                  // presence is not required — but a stored value must be bool.
                  && request.resource.data.get('isActive', true) is bool;

      allow delete: if false;
    }

    // Budget Lines — project-scoped allocations against a company cost code.
    // Reads: internal financial roles only (ADR-56). Same role set writes; delete blocked.
    match /companies/{companyId}/projects/{projectId}/budgetLines/{lineId} {
      function budgetLineWriter() {
        return financialMember(companyId);
      }
      allow read: if financialMember(companyId);

      allow create: if budgetLineWriter()
                  && request.resource.data.costCodeId is string
                  && request.resource.data.costCodeId.size() > 0
                  && request.resource.data.budgeted is number
                  && request.resource.data.budgeted >= 0;

      allow update: if budgetLineWriter()
                  // The cost-code spine and the provenance no update may move.
                  && request.resource.data.costCodeId   == resource.data.costCodeId
                  && request.resource.data.get('costCodeName', '') == resource.data.get('costCodeName', '')
                  && request.resource.data.get('createdAt', null)  == resource.data.get('createdAt', null)
                  && request.resource.data.get('createdBy', null)  == resource.data.get('createdBy', null)
                  // Only the two authored values and the stamps may move — this
                  // is also what freezes the vestigial committed/actual/invoiced.
                  && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['budgeted', 'notes', 'updatedAt', 'updatedBy'])
                  && request.resource.data.budgeted is number
                  && request.resource.data.budgeted >= 0
                  && request.resource.data.get('notes', '') is string
                  && request.resource.data.get('notes', '').size() <= 2000
                  // Stamps verified against the caller and the server clock.
                  && request.resource.data.updatedBy == request.auth.uid
                  && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // BOQ items — the project's measured Bill of Quantities: description,
    // quantity, unit, cost code (mandatory spine, frozen name snapshot), and —
    // once priced — a rate with a DERIVED amount (ADR-32 Part 1).
    match /companies/{companyId}/projects/{projectId}/boqItems/{itemId} {
      function corePreserved() {
        return request.resource.data.currency  == resource.data.currency
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.revision  == resource.data.revision;
      }
      // rate and amount travel together: both null (unpriced), or both
      // non-negative numbers with amount == quantity × rate to the cent.
      function pricingValid() {
        return (request.resource.data.rate == null
                && request.resource.data.amount == null)
            || (request.resource.data.rate is number
                && request.resource.data.rate >= 0
                && request.resource.data.amount is number
                && request.resource.data.amount >= 0
                && cents(request.resource.data.quantity * request.resource.data.rate)
                   == cents(request.resource.data.amount));
      }
      // Shape required of every stored ACTIVE state (create and edit alike).
      function shapeValid() {
        return request.resource.data.revision == 1
            && request.resource.data.itemNumber is string
            && request.resource.data.itemNumber.size() <= 40
            && request.resource.data.section is string
            && request.resource.data.description is string
            && request.resource.data.description.trim().size() > 0
            && request.resource.data.unit is string
            && request.resource.data.unit.size() > 0
            && request.resource.data.unit.size() <= 40
            // A measurement, not money — non-negative; zero is a real
            // measured quantity.
            && request.resource.data.quantity is number
            && request.resource.data.quantity >= 0
            && pricingValid()
            // Cost-code spine: MANDATORY on every item (frozen name snapshot).
            && request.resource.data.costCodeId is string
            && request.resource.data.costCodeId.size() > 0
            && request.resource.data.costCodeName is string
            && request.resource.data.costCodeName.size() > 0
            && request.resource.data.notes is string
            && request.resource.data.currency is string
            && request.resource.data.currency.matches('^[A-Z]{3}$');
      }
      // Quant 1B provenance (ADR-52): the LATEST explicit application of a
      // measured total. Optional. Either preserved exactly as stored (a manual
      // edit carries it along) or freshly written by the caller, now, with the
      // quantity being written. It records one confirmed action, nothing more.
      // `evidence` is the client's deterministic fingerprint of the reviewed
      // measurements (shape-checked only — rules cannot recompute it).
      function quantAppliedShape(q) {
        return q is map
            && q.keys().hasOnly(['at', 'by', 'quantity', 'measurementCount', 'evidence'])
            && q.keys().hasAll(['at', 'by', 'quantity', 'measurementCount', 'evidence'])
            && q.at is timestamp
            && q.by is string && q.by.size() > 0
            && q.quantity is number && q.quantity >= 0
            && q.measurementCount is int && q.measurementCount >= 1
            && q.evidence is string && q.evidence.size() > 0 && q.evidence.size() <= 128;
      }
      function quantAppliedPreserved() {
        return !('quantApplied' in request.resource.data)
            || (('quantApplied' in resource.data) && request.resource.data.quantApplied == resource.data.quantApplied);
      }
      function quantAppliedFresh() {
        return quantAppliedShape(request.resource.data.quantApplied)
            && request.resource.data.quantApplied.by == request.auth.uid
            && request.resource.data.quantApplied.at == request.time
            && request.resource.data.quantApplied.quantity == request.resource.data.quantity;
      }

      allow read: if financialMember(companyId);

      allow create: if financialMember(companyId)
                  && shapeValid()
                  && request.resource.data.status == 'active'
                  && request.resource.data.createdBy == request.auth.uid
                  && request.resource.data.createdAt == request.time
                  && updateStamped()
                  // Void stamps cannot be forged at creation.
                  && request.resource.data.voidedAt == null
                  && request.resource.data.voidedBy == null
                  // Provenance is written only by an application to an existing item.
                  && !('quantApplied' in request.resource.data);

      allow update: if financialMember(companyId) && corePreserved() && updateStamped() && (
                    // (a) ACTIVE EDIT — content (measurement, pricing, cost
                    //     code, labels) is freely editable while active, but
                    //     the status may not move and no void stamp may be
                    //     forged. `quantApplied` is either untouched or a
                    //     fresh, caller-stamped record of THIS write.
                    (
                      resource.data.status == 'active'
                      && request.resource.data.status == 'active'
                      && shapeValid()
                      && request.resource.data.voidedAt == resource.data.voidedAt
                      && request.resource.data.voidedBy == resource.data.voidedBy
                      && (quantAppliedPreserved() || quantAppliedFresh())
                    )
                    ||
                    // (b) ACTIVE -> VOID (terminal). Voiding is the only exit:
                    //     it may touch nothing but the void audit fields, so a
                    //     voided item is immutable retained history.
                    (
                      resource.data.status == 'active'
                      && request.resource.data.status == 'void'
                      && changedKeys().hasOnly(['status', 'voidedAt', 'voidedBy', 'voidReason', 'updatedAt', 'updatedBy'])
                      && request.resource.data.voidedBy == request.auth.uid
                      && request.resource.data.voidedAt == request.time
                      && request.resource.data.voidReason is string
                      && request.resource.data.voidReason.trim().size() > 0
                    )
                  );

      allow delete: if false;
    }

    // Purchase Orders — supplier commitments against company cost codes. Financial
    // roles only (ADR-56). Lifecycle RULES-ENFORCED (ADR-57, M2-B1): born draft,
    // draft-only content edits, stamps-only transitions, identity and money frozen
    // after send, whole-cent headers; delete blocked. What rules cannot verify
    // (lineItems, the cancel policy) is docs/SECURITY.md → Deferred Control 35.
    match /companies/{companyId}/projects/{projectId}/purchaseOrders/{poId} {
      // Exact key set of a document the app creates (hooks/usePurchaseOrders.jsx).
      // The three M3-A source keys (ADR-61) are OPTIONAL at create: absent on a
      // manual or legacy PO, all present on an award-raised one.
      function exactKeys() {
        return request.resource.data.keys().hasOnly(['poNumber', 'status', 'supplierName', 'supplierId', 'description', 'lineItems', 'subtotal', 'gst', 'total', 'currency', 'revision', 'notes', 'sentAt', 'sentBy', 'closedAt', 'closedBy', 'cancelledAt', 'cancelledBy', 'externalRefs', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'sourceTenderPackageId', 'sourceTenderBidId', 'sourceTenderNumber'])
            && request.resource.data.keys().hasAll(['poNumber', 'status', 'supplierName', 'supplierId', 'description', 'lineItems', 'subtotal', 'gst', 'total', 'currency', 'revision', 'notes', 'sentAt', 'sentBy', 'closedAt', 'closedBy', 'cancelledAt', 'cancelledBy', 'externalRefs', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy']);
      }
      // M3-A (ADR-61): an award-raised PO cites its source. Either all three
      // keys are absent (manual / legacy), or all three are present and
      // get()-verified: the package is awarded, its winning bid is the cited
      // bid, that bid is received and names this PO's supplier, and — through
      // getAfter(), because the raise is ONE transaction — the package points
      // back at this PO once the commit lands. No source can be spoofed onto
      // a PO without the package's own branch (f)/(g) admitting the link.
      function tenderPkgPath() {
        return /databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/tenderPackages/$(request.resource.data.sourceTenderPackageId);
      }
      function tenderBidPath() {
        return /databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/tenderBids/$(request.resource.data.sourceTenderBidId);
      }
      function sourceAbsent() {
        return !request.resource.data.keys().hasAny(['sourceTenderPackageId', 'sourceTenderBidId', 'sourceTenderNumber']);
      }
      function sourceTenderValid() {
        let d = request.resource.data;
        let pkg = get(tenderPkgPath()).data;
        let bid = get(tenderBidPath()).data;
        return d.sourceTenderPackageId is string
            && d.sourceTenderPackageId.size() > 0
            && d.sourceTenderBidId is string
            && d.sourceTenderBidId.size() > 0
            && d.sourceTenderNumber is string
            && d.sourceTenderNumber.size() > 0
            && pkg.status == 'awarded'
            && pkg.awardedBidId == d.sourceTenderBidId
            && pkg.tenderNumber == d.sourceTenderNumber
            && bid.tenderPackageId == d.sourceTenderPackageId
            && bid.status == 'received'
            && bid.bidderContactId == d.supplierId
            && bid.bidderName == d.supplierName
            && getAfter(tenderPkgPath()).data.raisedPoId == poId;
      }
      // Identity written once. `supplierId` is null on a pre-Contacts PO
      // (ADR-15) and is never backfilled.
      function identityShapeValid() {
        let d = request.resource.data;
        return d.poNumber is string
            && d.poNumber.matches('^PO-[0-9]{4,}$')
            && d.supplierName is string
            && d.supplierName.size() > 0
            && d.supplierName.size() <= 200
            && (d.supplierId == null || (d.supplierId is string && d.supplierId.size() > 0))
            && d.currency is string
            && d.currency.matches('^[A-Z]{3}$')
            && d.revision is number
            && d.externalRefs is map;
      }
      // Authored content. Bounds stop unbounded strings, not business cases;
      // the line COUNT is the honest ceiling on what rules can say about
      // `lineItems` (no iteration — Deferred Control 35).
      function contentShapeValid() {
        let d = request.resource.data;
        return d.description is string
            && d.description.size() <= 2000
            && d.notes is string
            && d.notes.size() <= 5000
            && d.lineItems is list
            && d.lineItems.size() >= 1
            && d.lineItems.size() <= 200;
      }
      function moneyTypesValid() {
        let d = request.resource.data;
        return d.subtotal is number
            && d.gst is number
            && d.total is number
            && d.subtotal >= 0
            && d.gst >= 0
            && d.total >= 0;
      }
      // subtotal + gst == total EXACTLY, in cents. gst is 10% of subtotal
      // round-half-up EXACTLY — except on a half-cent boundary (subtotal cents
      // ending in 5), where ONE cent below is also accepted: lib/purchaseOrders
      // .js → poTotals computes roundMoney(subtotal × 0.1) in binary floating
      // point, and there the product can land a hair below .5 and round DOWN
      // (40.15 → 4.01 where half-up gives 4.02). Swept exhaustively to $1M and
      // sampled to $90M: the deviation is always −1, never +1, and never off a
      // boundary — so this admits exactly the app's own output and nothing else
      // (ADR-57). GST_RATE is a flat 10% regardless of currency.
      function moneyBalanced() {
        let d = request.resource.data;
        let sub = cents(d.subtotal);
        let gst = cents(d.gst);
        return sub + gst == cents(d.total)
            && (gst == gstCents(sub)
                || (sub % 10 == 5 && gst == gstCents(sub) - 1));
      }
      function moneyValid() {
        return moneyTypesValid() && moneyBalanced();
      }
      // Born draft, stamped by its creator, every lifecycle stamp null.
      function createValid() {
        let d = request.resource.data;
        return d.status == 'draft'
            && d.createdBy == request.auth.uid
            && d.createdAt == request.time
            && d.sentAt == null
            && d.sentBy == null
            && d.closedAt == null
            && d.closedBy == null
            && d.cancelledAt == null
            && d.cancelledBy == null;
      }
      // The identity no update may rewrite. Optional keys are read through
      // get(key, null) on BOTH sides so a document written before ADR-57 (no
      // `*By` stamps, possibly no `externalRefs`) compares equal and stays
      // writable; `hasOnly` on changedKeys() in every branch below is what
      // freezes the lifecycle stamps a transition does not own.
      function corePreserved() {
        let d = request.resource.data;
        let p = resource.data;
        return d.poNumber == p.poNumber
            && d.supplierName == p.supplierName
            && d.get('supplierId', null) == p.get('supplierId', null)
            && d.get('currency', null) == p.get('currency', null)
            && d.get('revision', null) == p.get('revision', null)
            && d.get('externalRefs', null) == p.get('externalRefs', null)
            && d.get('sourceTenderPackageId', null) == p.get('sourceTenderPackageId', null)
            && d.get('sourceTenderBidId', null) == p.get('sourceTenderBidId', null)
            && d.get('sourceTenderNumber', null) == p.get('sourceTenderNumber', null)
            && d.createdAt == p.createdAt
            && d.createdBy == p.createdBy;
      }

      allow read: if financialMember(companyId);

      allow create: if financialMember(companyId)
                  && exactKeys()
                  && createValid()
                  && updateStamped()
                  && identityShapeValid()
                  && contentShapeValid()
                  && moneyValid()
                  && exists(projectPath(companyId, projectId))
                  && request.resource.data.currency == resolvedCurrency(companyId, projectId)
                  && (sourceAbsent() || sourceTenderValid());

      // `resource != null` first — a denied create is also measured against
      // this rule (see the supplierInvoices note on the 1000-expression ceiling).
      allow update: if resource != null
                  && financialMember(companyId) && corePreserved() && updateStamped() && (
                    // (a) DRAFT EDIT — the authored content and the derived
                    //     header only (hooks/usePurchaseOrders.jsx →
                    //     updatePurchaseOrder). Status and every stamp are
                    //     outside the list, so they cannot move here.
                    (
                      resource.data.status == 'draft'
                      && changedKeys().hasOnly(['description', 'notes', 'lineItems', 'subtotal', 'gst', 'total', 'updatedAt', 'updatedBy'])
                      && contentShapeValid()
                      && moneyValid()
                    )
                    ||
                    // (b) SEND — THE FREEZE AND COMMITMENT POINT. From draft
                    //     (or the reserved pending_approval, which nothing
                    //     enters). The stored lines are what gets frozen, so a
                    //     draft with no line cannot be sent. Stamps only.
                    (
                      resource.data.status in ['draft', 'pending_approval']
                      && request.resource.data.status == 'sent'
                      && resource.data.lineItems is list
                      && resource.data.lineItems.size() >= 1
                      && changedKeys().hasOnly(['status', 'sentAt', 'sentBy', 'updatedAt', 'updatedBy'])
                      && request.resource.data.sentBy == request.auth.uid
                      && request.resource.data.sentAt == request.time
                    )
                    ||
                    // (c) CLOSE — sent only. Stamps only.
                    (
                      resource.data.status == 'sent'
                      && request.resource.data.status == 'closed'
                      && changedKeys().hasOnly(['status', 'closedAt', 'closedBy', 'updatedAt', 'updatedBy'])
                      && request.resource.data.closedBy == request.auth.uid
                      && request.resource.data.closedAt == request.time
                    )
                    ||
                    // (d) CANCEL (terminal) — from any non-terminal status.
                    //     Stamps only; no reason field exists on this model.
                    //     Whether a claim or invoice still counts against the
                    //     PO is NOT checked here (no sibling reads) — the
                    //     strict policy is the client's (DC35).
                    (
                      resource.data.status in ['draft', 'pending_approval', 'sent']
                      && request.resource.data.status == 'cancelled'
                      && changedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy', 'updatedAt', 'updatedBy'])
                      && request.resource.data.cancelledBy == request.auth.uid
                      && request.resource.data.cancelledAt == request.time
                    )
                  );

      allow delete: if false;
    }

    // Progress Claims — assessed against a SENT purchase order. Financial roles
    // only (ADR-56). Lifecycle RULES-ENFORCED (ADR-58, M2-B2): born draft against
    // a get()-verified PO, draft-only edits with the line count fixed, stamps-only
    // transitions, claimed money frozen at submit and approved money forever,
    // revision +1; delete blocked. What rules cannot verify (lineItems, one open
    // claim per PO, cumulative claiming) is docs/SECURITY.md → Deferred Control 36.
    match /companies/{companyId}/projects/{projectId}/progressClaims/{claimId} {
      // lib/progressClaims.js → claimTotals computes roundMoney(net × 0.1) in
      // binary floating point, which on some half-cent boundaries lands a hair
      // below .5 and rounds DOWN (the ADR-57 finding, same helper, swept again
      // for claimTotals in tests/unit/progressClaims.test.js): the GST must be
      // EXACTLY half-up, or ONE cent below it on a boundary only. `-5` admits
      // the same deviation on the negative net a LEGACY negative retention can
      // still produce at approval (new writes require retention >= 0).
      function gstPinned(netC, gstC) {
        return gstC == gstCents(netC)
            || ((netC % 10 == 5 || netC % 10 == -5) && gstC == gstCents(netC) - 1);
      }
      // Exact key set of a document the app creates (hooks/useProgressClaims.jsx).
      // M3-B2 (ADR-63): `variationLineCount` — the number of variation-origin
      // lines after the PO lines — is REQUIRED by this FINAL file (the STAGE-1
      // transitional ruleset makes it optional for the M3-B1 bundle; marked line).
      function exactKeys() {
        return request.resource.data.keys().hasOnly(['claimNumber', 'status', 'poId', 'poNumber', 'supplierName', 'supplierId', 'claimRef', 'periodEnding', 'variationId', 'variationLineCount', 'lineItems', 'retention', 'claimedSubtotal', 'claimedGst', 'claimedTotal', 'approvedSubtotal', 'approvedGst', 'approvedTotal', 'notes', 'assessmentNotes', 'currency', 'revision', 'submittedAt', 'submittedBy', 'approvedAt', 'approvedBy', 'rejectedAt', 'rejectedBy', 'invoicedAt', 'externalRefs', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
            && request.resource.data.keys().hasAll(['claimNumber', 'status', 'poId', 'poNumber', 'supplierName', 'supplierId', 'claimRef', 'periodEnding', 'variationId', 'variationLineCount', 'lineItems', 'retention', 'claimedSubtotal', 'claimedGst', 'claimedTotal', 'approvedSubtotal', 'approvedGst', 'approvedTotal', 'notes', 'assessmentNotes', 'currency', 'revision', 'submittedAt', 'submittedBy', 'approvedAt', 'approvedBy', 'rejectedAt', 'rejectedBy', 'invoicedAt', 'externalRefs', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy']); // ADR-63 FINAL: variationLineCount is REQUIRED at create
      }
      // The number of variation-origin lines a claim declares (absent reads 0 —
      // every pre-M3-B2 document).
      function variationLineCount(d) {
        return d.get('variationLineCount', 0);
      }
      // The honest rules-level shape of a line set with `n` variation-origin
      // lines after the PO lines (ADR-63): rules cannot iterate `lineItems`,
      // but they can INDEX it — the FIRST and LAST variation-origin lines must
      // carry a null `poLineIndex` and a string `variationId`, and with n == 0
      // the last line must carry no `variationId`. A pre-M3-B2 client's
      // rebuild writes every line with a numeric index and no variation id, so
      // its draft edit of a claim that holds variation lines is REFUSED here
      // (nothing written) instead of silently moving those lines to PO line 0.
      // Element contents beyond this stay client-only (DC40).
      function variationLinesShaped(lines, n) {
        return n == 0
            ? lines[lines.size() - 1].get('variationId', null) == null
            : (lines[lines.size() - 1].get('poLineIndex', 0) == null
               && lines[lines.size() - 1].get('variationId', null) is string
               && lines[lines.size() - n].get('poLineIndex', 0) == null
               && lines[lines.size() - n].get('variationId', null) is string);
      }
      // On an update the first and last variation-origin lines must also keep
      // the stored identity (variation id and line index).
      function variationLinesPreserved() {
        let n = variationLineCount(resource.data);
        let d = request.resource.data.lineItems;
        let p = resource.data.lineItems;
        return variationLinesShaped(d, n)
            && (n == 0
                || (d[d.size() - 1].get('variationId', null) == p[p.size() - 1].get('variationId', null)
                    && d[d.size() - 1].get('variationLineIndex', null) == p[p.size() - 1].get('variationLineIndex', null)
                    && d[d.size() - n].get('variationId', null) == p[p.size() - n].get('variationId', null)
                    && d[d.size() - n].get('variationLineIndex', null) == p[p.size() - n].get('variationLineIndex', null)));
      }
      // Identity written once. `supplierId` is null on a claim raised from a
      // pre-Contacts PO (ADR-15); `variationId` is a RESERVED header and stays
      // null — several variations may share one claim, so the variation
      // identity lives on the LINES (ADR-63); `variationLineCount` is a
      // non-negative integer.
      function identityShapeValid() {
        let d = request.resource.data;
        return d.claimNumber is string
            && d.claimNumber.matches('^PC-[0-9]{4,}$')
            && d.poId is string
            && d.poId.size() > 0
            && d.poNumber is string
            && d.supplierName is string
            && d.supplierName.size() <= 200
            && (d.supplierId == null || (d.supplierId is string && d.supplierId.size() > 0))
            && d.variationId == null
            && d.get('variationLineCount', 0) is int
            && d.get('variationLineCount', 0) >= 0
            && d.currency is string
            && d.currency.matches('^[A-Z]{3}$')
            && d.revision == 1
            && d.externalRefs is map
            && d.assessmentNotes == '';
      }
      // Authored content. Bounds stop unbounded strings, not business cases;
      // the line COUNT is the honest ceiling on what rules can say about
      // `lineItems` (no iteration — Deferred Control 36).
      function contentShapeValid() {
        let d = request.resource.data;
        return d.claimRef is string
            && d.claimRef.size() <= 200
            && d.periodEnding is string
            && (d.periodEnding == '' || d.periodEnding.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
            && d.notes is string
            && d.notes.size() <= 5000
            && d.lineItems is list
            && d.lineItems.size() >= 1
            && d.lineItems.size() <= 200;
      }
      // The CLAIMED header, as lib/progressClaims.js → claimTotals writes it:
      // retention >= 0 (the ADR-40 floor — a negative retention would raise the
      // payable above the claim) and <= subtotal (the clamp), subtotal > 0 (at
      // least one line claims something — validateClaimDraft), gst pinned to
      // 10% of (subtotal − retention), total == net + gst exactly.
      function claimedMoneyTypesValid() {
        let d = request.resource.data;
        return d.retention is number
            && d.claimedSubtotal is number
            && d.claimedGst is number
            && d.claimedTotal is number
            && d.retention >= 0
            && d.claimedSubtotal > 0;
      }
      function claimedMoneyBalanced() {
        let d   = request.resource.data;
        let sub = cents(d.claimedSubtotal);
        let ret = cents(d.retention);
        let gst = cents(d.claimedGst);
        return ret <= sub
            && gstPinned(sub - ret, gst)
            && sub - ret + gst == cents(d.claimedTotal);
      }
      function claimedMoneyValid() {
        return claimedMoneyTypesValid() && claimedMoneyBalanced();
      }
      // The APPROVED header, as claimTotals(approvedAmounts, claim.retention)
      // writes it at approval: the STORED retention (never rewritten) is
      // clamped to the approved subtotal; the approved subtotal can never
      // exceed the STORED claimed subtotal (certify at most what was claimed —
      // approvedLineError per line, here in aggregate). The stored retention
      // is validated by identity only, so a legacy claim approves exactly as
      // the app computes it.
      function approvedMoneyTypesValid() {
        let d = request.resource.data;
        let p = resource.data;
        return d.approvedSubtotal is number
            && d.approvedGst is number
            && d.approvedTotal is number
            && d.approvedSubtotal >= 0
            && p.retention is number
            && p.claimedSubtotal is number;
      }
      function approvedMoneyBalanced() {
        let d   = request.resource.data;
        let sub = cents(d.approvedSubtotal);
        let ret = cents(resource.data.retention);
        let r   = ret < sub ? ret : sub;
        let gst = cents(d.approvedGst);
        return sub <= cents(resource.data.claimedSubtotal)
            && gstPinned(sub - r, gst)
            && sub - r + gst == cents(d.approvedTotal);
      }
      function approvedMoneyValid() {
        return approvedMoneyTypesValid() && approvedMoneyBalanced();
      }
      // Born draft, stamped by its creator, every lifecycle stamp and every
      // approved value null.
      function createValid() {
        let d = request.resource.data;
        return d.status == 'draft'
            && d.createdBy == request.auth.uid
            && d.createdAt == request.time
            && d.submittedAt == null
            && d.submittedBy == null
            && d.approvedAt == null
            && d.approvedBy == null
            && d.rejectedAt == null
            && d.rejectedBy == null
            && d.invoicedAt == null
            && d.approvedSubtotal == null
            && d.approvedGst == null
            && d.approvedTotal == null;
      }
      // Tier-2 source validation — CREATE ONLY. The PO is a scalar reference,
      // so it CAN be get()-ed: it must exist in THIS project and be `sent`
      // (lib/progressClaims.js → CLAIMABLE_PO_STATUSES), and the claim's
      // number, supplier snapshot and line COUNT must be the PO's lines plus
      // the declared variation-origin lines (one per PO line, ADR-37; plus the
      // new-scope lines, ADR-63, whose shape is pinned at the ends). The path
      // is built inside the guarded branch, never before it. Repeated access to
      // one document within one evaluation is a single billed read.
      // The PO is bound ONCE (`let po`) — every repeated `get(poPath(…)).data`
      // spent from the engine's 1000-expression ceiling, which the create
      // evaluation reached in the emulator once the ADR-63 checks were added.
      // A missing PO makes `.data` error, which denies exactly as `exists()` did.
      function sourcePoValid() {
        let d = request.resource.data;
        let po = get(poPath(companyId, projectId)).data;
        let n = d.get('variationLineCount', 0);
        return po.status == 'sent'
            && po.poNumber == d.poNumber
            && po.supplierName == d.supplierName
            && po.get('supplierId', null) == d.supplierId
            && po.lineItems is list
            && po.lineItems.size() + n == d.lineItems.size()
            && variationLinesShaped(d.lineItems, n);
      }
      // The identity no update may rewrite. Optional keys are read through
      // get(key, null) on BOTH sides so a document written before ADR-58 (no
      // `submittedBy` / `rejectedBy` / audit keys) compares equal and stays
      // writable; `hasOnly` on changedKeys() in every branch below is what
      // freezes the stamps and the money a transition does not own.
      function corePreserved() {
        let d = request.resource.data;
        let p = resource.data;
        return d.claimNumber == p.claimNumber
            && d.poId == p.poId
            && d.poNumber == p.poNumber
            && d.supplierName == p.supplierName
            && d.get('supplierId', null) == p.get('supplierId', null)
            && d.get('variationId', null) == p.get('variationId', null)
            && d.get('variationLineCount', null) == p.get('variationLineCount', null)
            && d.get('currency', null) == p.get('currency', null)
            && d.get('externalRefs', null) == p.get('externalRefs', null)
            && d.createdAt == p.createdAt
            && d.createdBy == p.createdBy;
      }
      function notesBounded() {
        return request.resource.data.assessmentNotes is string
            && request.resource.data.assessmentNotes.size() <= 5000;
      }

      allow read: if financialMember(companyId);

      allow create: if financialMember(companyId)
                  && exactKeys()
                  && createValid()
                  && updateStamped()
                  && identityShapeValid()
                  && contentShapeValid()
                  && claimedMoneyValid()
                  && exists(projectPath(companyId, projectId))
                  && request.resource.data.currency == resolvedCurrency(companyId, projectId)
                  && sourcePoValid();

      // `resource != null` first — a denied create is also measured against
      // this rule (see the supplierInvoices note on the 1000-expression ceiling).
      allow update: if resource != null
                  && financialMember(companyId) && corePreserved() && updateStamped() && revisionIncremented() && (
                    // (a) DRAFT EDIT — the authored content and the derived
                    //     claimed header only (hooks/useProgressClaims.jsx →
                    //     updateProgressClaim). Status, every stamp, every
                    //     approved value and the assessment notes are outside
                    //     the list. The line COUNT is pinned: the set is fixed
                    //     one-per-PO-line and a draft edit re-authors amounts,
                    //     never lines.
                    (
                      resource.data.status == 'draft'
                      && changedKeys().hasOnly(['claimRef', 'periodEnding', 'notes', 'lineItems', 'retention', 'claimedSubtotal', 'claimedGst', 'claimedTotal', 'revision', 'updatedAt', 'updatedBy'])
                      && contentShapeValid()
                      && claimedMoneyValid()
                      && request.resource.data.lineItems.size() == resource.data.lineItems.size()
                      && variationLinesPreserved()
                    )
                    ||
                    // (b) SUBMIT — THE CLAIMED-MONEY FREEZE POINT and the
                    //     moment the claim starts counting as Claimed. Stamps
                    //     only; the stored lines are what gets frozen, so a
                    //     draft with no line cannot be submitted.
                    (
                      resource.data.status == 'draft'
                      && request.resource.data.status == 'submitted'
                      && resource.data.lineItems is list
                      && resource.data.lineItems.size() >= 1
                      && changedKeys().hasOnly(['status', 'submittedAt', 'submittedBy', 'revision', 'updatedAt', 'updatedBy'])
                      && request.resource.data.submittedBy == request.auth.uid
                      && request.resource.data.submittedAt == request.time
                    )
                    ||
                    // (c) APPROVE — THE CERTIFICATION POINT (Actual starts
                    //     recognising the certified value). From submitted, or
                    //     the reserved under_review which nothing enters. It
                    //     writes the certified lines (contents unverifiable —
                    //     the count is pinned), the approved header, the
                    //     assessment notes and its own stamps — the claimed
                    //     header and the retention are untouched, and the
                    //     approved subtotal cannot exceed the claimed one.
                    (
                      resource.data.status in ['submitted', 'under_review']
                      && request.resource.data.status == 'approved'
                      && changedKeys().hasOnly(['status', 'lineItems', 'approvedSubtotal', 'approvedGst', 'approvedTotal', 'assessmentNotes', 'approvedAt', 'approvedBy', 'revision', 'updatedAt', 'updatedBy'])
                      && request.resource.data.approvedBy == request.auth.uid
                      && request.resource.data.approvedAt == request.time
                      && request.resource.data.lineItems is list
                      && request.resource.data.lineItems.size() == resource.data.lineItems.size()
                      && variationLinesPreserved()
                      && notesBounded()
                      && approvedMoneyValid()
                    )
                    ||
                    // (d) REJECT (terminal) — from any open status; a draft
                    //     rejection is a withdrawal. Stamps plus the optional
                    //     assessment notes; nothing else moves.
                    (
                      resource.data.status in ['draft', 'submitted', 'under_review']
                      && request.resource.data.status == 'rejected'
                      && changedKeys().hasOnly(['status', 'rejectedAt', 'rejectedBy', 'assessmentNotes', 'revision', 'updatedAt', 'updatedBy'])
                      && request.resource.data.rejectedBy == request.auth.uid
                      && request.resource.data.rejectedAt == request.time
                      && notesBounded()
                    )
                  );

      allow delete: if false;
    }

    // Supplier Invoices — project-scoped accounts-payable bills against a sent/
    // closed PO, optionally sourced from one approved progress claim.
    match /companies/{companyId}/projects/{projectId}/supplierInvoices/{invoiceId} {
      // The document identity that no update of any kind may rewrite. Wider than
      // the cash collections, because a supplier invoice's identity includes both
      // counterparty snapshots and BOTH source references — repointing either
      // would move cost between POs, claims, or suppliers with no audit trail,
      // and would invalidate the create-time source checks that can never run
      // again.
      //
      // `paidAt` and `adjustsInvoiceId` are frozen here at the null they are born
      // with. Both are dead fields kept for shape stability — payment state is
      // DERIVED from posted Supplier Payment allocations (ADR-24) and the credit
      // link lives on the credit note (ADR-31) — so freezing them is how rules
      // guarantee no second source of payment truth is ever authored.
      function corePreserved() {
        let d = request.resource.data;
        let p = resource.data;
        return d.invoiceNumber    == p.invoiceNumber
            && d.docType          == p.docType
            && d.source           == p.source
            && d.currency         == p.currency
            && d.revision         == p.revision
            && d.createdAt        == p.createdAt
            && d.createdBy        == p.createdBy
            && d.supplierId       == p.supplierId
            && d.supplierName     == p.supplierName
            && d.poId             == p.poId
            && d.poNumber         == p.poNumber
            && d.progressClaimId  == p.progressClaimId
            && d.claimNumber      == p.claimNumber
            && d.paymentTerms     == p.paymentTerms
            && d.paidAt           == p.paidAt
            && d.adjustsInvoiceId == p.adjustsInvoiceId
            && d.get('variationLineCount', null) == p.get('variationLineCount', null);
      }
      // Lifecycle stamps a content edit may not forge. `cancelledBy` is read
      // through get(key, null) on BOTH sides: it is an ADR-40 addition, so every
      // invoice raised before this branch stores no such key and a direct
      // `resource.data.cancelledBy` would error and deny a legitimate draft edit.
      // Absent == null on both sides, so a legacy document compares equal.
      function stampsFrozen() {
        let d = request.resource.data;
        let p = resource.data;
        return d.approvedAt  == p.approvedAt
            && d.approvedBy  == p.approvedBy
            && d.postedAt    == p.postedAt
            && d.postedBy    == p.postedBy
            && d.cancelledAt == p.cancelledAt
            && d.get('cancelledBy', null) == p.get('cancelledBy', null);
      }
      // The AUTHORED header both sources may edit while draft. Bounds are
      // deliberately generous — they exist to stop unbounded strings, not to
      // impose a business rule the UI does not impose.
      function headerShapeValid() {
        let d = request.resource.data;
        return d.supplierInvoiceNumber is string
            && d.supplierInvoiceNumber.size() <= 200
            && d.invoiceDate is string
            && d.invoiceDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.receivedDate is string
            && (d.receivedDate == '' || d.receivedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
            && d.dueDate is string
            && (d.dueDate == '' || d.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
            && d.notes is string
            && d.notes.size() <= 5000;
      }
      // Identity and container shape. `supplierId` may legitimately be NULL on an
      // invoice raised from a pre-Contacts PO and is never backfilled (ADR-15);
      // `supplierName` is therefore required to be a string but NOT required
      // non-empty, because a historical PO with a blank supplier name would
      // otherwise become permanently unwritable. `poId`/`progressClaimId` are
      // nullable HERE for the same legacy reason — a NEW document's references
      // are pinned by sourceRefsValid() on create instead.
      function identityShapeValid() {
        let d = request.resource.data;
        return d.invoiceNumber is string
            && d.invoiceNumber.size() > 0
            && d.docType == 'invoice'
            && d.source in ['direct_po', 'progress_claim']
            && d.currency is string
            && d.currency.matches('^[A-Z]{3}$')
            && d.revision is number
            && (d.supplierId == null || (d.supplierId is string && d.supplierId.size() > 0))
            && d.supplierName is string
            && (d.poId == null || (d.poId is string && d.poId.size() > 0))
            && (d.poNumber == null || d.poNumber is string)
            && (d.progressClaimId == null || (d.progressClaimId is string && d.progressClaimId.size() > 0))
            && (d.claimNumber == null || d.claimNumber is string)
            && (d.paymentTerms == null || d.paymentTerms is map)
            && d.lineItems is list
            && d.lineItems.size() >= 1
            && d.lineItems.size() <= 200
            && d.attachments is list
            && d.externalRefs is map
            && variationLinesShaped(d);
      }
      // M3-B2 (ADR-63): `variationLineCount` — the number of variation-origin
      // lines (copied from the source claim; 0 on a direct PO invoice) — is a
      // non-negative integer when present (absent reads 0: every pre-M3-B2
      // document), and the LAST line matches it: a null `poLineIndex` and a
      // string `variationId` when > 0, no `variationId` when 0. Rules cannot
      // iterate the list; this is the honest ceiling (DC40).
      function variationLinesShaped(d) {
        let n = d.get('variationLineCount', 0);
        let last = d.lineItems[d.lineItems.size() - 1];
        return n is int
            && n >= 0
            && (n == 0
                ? last.get('variationId', null) == null
                : (last.get('poLineIndex', 0) == null && last.get('variationId', null) is string));
      }
      // The SCALAR arithmetic guarantee rules CAN give: every stored total must
      // agree with every other stored total, in whole cents. The lines themselves
      // are unverifiable (see the block comment), so this bounds what a document
      // can CLAIM, not what its lines say.
      //
      // The five identities mirror lib/supplierInvoices.js → invoiceTotals term
      // for term, and the sixth pins `retentionGst` to the exact rounding of
      // `retention × 10%` rather than accepting any self-consistent pair.
      //
      // `retention <= subtotal` mirrors invoiceTotals' UPPER clamp; `retention >=
      // 0` is the floor invoiceTotals deliberately does NOT apply, closing the
      // create-path asymmetry in which a negative retention made the payable
      // exceed the gross invoice value (ADR-38 D6 applied it to edits only).
      //
      // Deliberately ABSENT: payableGst >= 0, payableTotal >= 0, and any ceiling
      // on gstTotal. See the block comment — all three would reject app-reachable
      // documents under the current financial model.
      function moneyTypesValid() {
        let d = request.resource.data;
        return d.subtotal is number
            && d.gstTotal is number
            && d.grossTotal is number
            && d.retention is number
            && d.retentionGst is number
            && d.retentionTotal is number
            && d.net is number
            && d.payableGst is number
            && d.payableTotal is number
            && d.subtotal > 0
            && d.gstTotal >= 0
            && d.grossTotal > 0
            && d.retention >= 0
            && d.retentionGst >= 0
            && d.retentionTotal >= 0
            && d.net >= 0;
      }
      // The five identities, plus the retention-GST pin and the upper clamp.
      //
      // ⚠️ SPLIT FROM moneyTypesValid() DELIBERATELY, AND THE ORDER MATTERS.
      // Firestore Rules evaluate at most 1000 expressions per request, and every
      // repeated `request.resource.data.X` and `cents(...)` spends from that
      // budget — an earlier single-function version of this exceeded it and the
      // emulator denied writes with "maximum of 1000 expressions to evaluate has
      // been reached". Each figure is therefore converted to cents ONCE into a
      // let binding. The split also guarantees the `is number` guards have
      // already passed (`&&` short-circuits in moneyValid below), so no
      // math.round() is ever handed a string or null.
      function moneyBalanced() {
        let d     = request.resource.data;
        let sub   = cents(d.subtotal);
        let gst   = cents(d.gstTotal);
        let gross = cents(d.grossTotal);
        let ret   = cents(d.retention);
        let rgst  = cents(d.retentionGst);
        let rtot  = cents(d.retentionTotal);
        return ret <= sub
            && sub + gst == gross
            && ret + rgst == rtot
            && sub - ret == cents(d.net)
            && gst - rgst == cents(d.payableGst)
            && gross - rtot == cents(d.payableTotal)
            && rgst == gstCents(ret);
      }
      function moneyValid() {
        return moneyTypesValid() && moneyBalanced();
      }
      // Shape required of every stored DRAFT state a caller authors money into
      // (create, and the direct_po draft edit).
      function shapeValid() {
        return headerShapeValid() && identityShapeValid() && moneyValid();
      }
      // ── Tier-2 source-document validation — CREATE ONLY ────────────────────
      // Both references are SCALARS, so unlike an allocations array they CAN be
      // get()-ed. An invoice raised against nothing is the forgery these stop.
      // The path is built inside the guarded branch, never before it: the `&&`
      // short-circuit is what guarantees the id is a non-empty string before it
      // is interpolated. Repeated access to the same document within one
      // evaluation is a single billed read.
      function claimPath() {
        return /databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/progressClaims/$(request.resource.data.progressClaimId);
      }
      function sourcePoValid() {
        return request.resource.data.poId is string
            && request.resource.data.poId.size() > 0
            && exists(poPath(companyId, projectId))
            && get(poPath(companyId, projectId)).data.status in ['sent', 'closed'];
      }
      // The claim is bound ONCE (`let claim`, read after the id is known to be
      // a non-empty string by the caller's short-circuit) — the create
      // evaluation sits near the engine's 1000-expression ceiling (see below).
      // M3-B2 (ADR-63): a claim that carries variation-origin lines may be
      // invoiced only by a client that DECLARES a variation-line count (at most
      // the claim's — lines certified at zero are not stored). The pre-M3-B2
      // bundle writes no such key and is refused, so it can never raise an
      // invoice that attributes those lines to PO line 0. A claim without
      // variation lines takes an absent key or 0.
      function sourceClaimValid() {
        let claim = get(claimPath()).data;
        let cc = claim.get('variationLineCount', 0);
        let ic = request.resource.data.get('variationLineCount', null);
        return claim.status == 'approved'
            && (cc == 0 ? (ic == null || ic == 0) : (ic is int && ic >= 0 && ic <= cc));
      }
      // A direct_po invoice must carry NO claim reference: a posted invoice's
      // progressClaimId excludes that claim from the claim side of Actual
      // (lib/supplierInvoices.js → invoicedClaimIds), so a forged one would
      // silently erase an approved claim from the cost position — and no
      // variation-origin line (ADR-63: new scope is invoiced from the claim).
      function sourceRefsValid() {
        return sourcePoValid()
            && (request.resource.data.source == 'direct_po'
                  ? (request.resource.data.progressClaimId == null
                     && request.resource.data.get('variationLineCount', 0) == 0)
                  : (request.resource.data.progressClaimId is string
                     && request.resource.data.progressClaimId.size() > 0
                     && sourceClaimValid()));
      }

      // A document is BORN DRAFT, STAMPED BY ITS CREATOR, AND UNSTAMPED BY EVERY
      // LIFECYCLE. Folded into one let-bound function, and ordered cheapest
      // discriminator first, to keep the create evaluation well inside the
      // engine's 1000-expression ceiling (see the note on `allow update`).
      function createValid() {
        let d = request.resource.data;
        return d.status == 'draft'
            && d.createdBy == request.auth.uid
            && d.createdAt == request.time
            && d.approvedAt  == null
            && d.approvedBy  == null
            && d.postedAt    == null
            && d.postedBy    == null
            && d.cancelledAt == null
            && d.cancelledBy == null
            && d.paidAt == null
            && d.adjustsInvoiceId == null;
      }

      allow read: if financialMember(companyId);

      allow create: if financialMember(companyId)
                  && createValid()
                  && updateStamped()
                  && shapeValid()
                  && sourceRefsValid();

      // ⚠️ `resource != null` COMES FIRST, AND IT IS NOT DECORATION. Firestore
      // evaluates the allow statements in a match block until one grants, so a
      // DENIED create is also measured against this rule — with a null
      // `resource`, which makes corePreserved() and every branch below
      // meaningless work on a document that does not exist. This block is large
      // enough that the combined evaluation exceeded the engine's
      // 1000-EXPRESSION CEILING, and the emulator then reports "Unable to
      // evaluate the expression as the maximum of 1000 expressions to evaluate
      // has been reached" instead of a clean denial. The outcome was still deny,
      // but the headroom was gone — a slightly larger rule would have started
      // erroring on LEGITIMATE writes. Short-circuiting here restores it. A
      // create can never satisfy this guard, so nothing is widened.
      allow update: if resource != null
                  && financialMember(companyId) && corePreserved() && updateStamped() && (
                    // (a) DRAFT EDIT — progress_claim: HEADER ONLY.
                    //     The line amounts, tax codes and retention ARE the
                    //     approved claim's certified values, and the invoice must
                    //     keep paying exactly that claim's certified GST and
                    //     total. `hasOnly` is what makes that structural rather
                    //     than merely validated: there is NO channel — client,
                    //     editor, or direct SDK — through which certified money
                    //     can move on this path. The list is exactly the payload
                    //     hooks/useSupplierInvoices.jsx writes for a claim-sourced
                    //     draft (ADR-38 D1).
                    //
                    //     moneyValid() is deliberately NOT applied here: nothing
                    //     financial can change, and re-validating STORED totals
                    //     would trap a legacy document with an internal
                    //     inconsistency in the one state where the app can still
                    //     surface it (claimSourcedDriftError).
                    (
                      resource.data.status == 'draft'
                      && request.resource.data.status == 'draft'
                      && resource.data.source == 'progress_claim'
                      && changedKeys().hasOnly(['supplierInvoiceNumber', 'invoiceDate', 'receivedDate', 'dueDate', 'notes', 'updatedAt', 'updatedBy'])
                      && headerShapeValid()
                    )
                    ||
                    // (b) DRAFT EDIT — direct_po: header + per-line money.
                    //     Line amounts, tax codes and retention are re-authored,
                    //     so the full shape and every scalar identity are
                    //     re-checked. The stored line COUNT is fixed — that is
                    //     the honest rules ceiling on ADR-38's "the stored line
                    //     set is fixed" (rules cannot iterate an array, so per-
                    //     element identity stays client-enforced). The status may
                    //     not move and no lifecycle stamp may be forged.
                    (
                      resource.data.status == 'draft'
                      && request.resource.data.status == 'draft'
                      && resource.data.source == 'direct_po'
                      && shapeValid()
                      && request.resource.data.lineItems.size() == resource.data.lineItems.size()
                      && stampsFrozen()
                    )
                    ||
                    // (c) DRAFT -> APPROVED. THE AUTHORING FREEZE POINT. A
                    //     separate operation carrying no content change
                    //     whatsoever — the lines and totals that were reviewed
                    //     are the ones frozen.
                    (
                      resource.data.status == 'draft'
                      && request.resource.data.status == 'approved'
                      && changedKeys().hasOnly(['status', 'approvedAt', 'approvedBy', 'updatedAt', 'updatedBy'])
                      && request.resource.data.approvedBy == request.auth.uid
                      && request.resource.data.approvedAt == request.time
                    )
                    ||
                    // (d) APPROVED -> POSTED. THE FINANCIAL COMMIT POINT — the
                    //     moment this document starts counting toward Invoiced,
                    //     Actual, Committed maturation and Remaining Payable.
                    //     Reachable ONLY from `approved`, so posting can never
                    //     skip the approval step, and it may touch nothing but
                    //     its own stamps.
                    (
                      resource.data.status == 'approved'
                      && request.resource.data.status == 'posted'
                      && changedKeys().hasOnly(['status', 'postedAt', 'postedBy', 'updatedAt', 'updatedBy'])
                      && request.resource.data.postedBy == request.auth.uid
                      && request.resource.data.postedAt == request.time
                    )
                    ||
                    // (e) DRAFT|APPROVED -> CANCELLED (terminal). Cancellation is
                    //     the only exit before posting, and it may touch nothing
                    //     but the cancel stamps — so cancelling can never smuggle
                    //     in a content edit.
                    //
                    //     ⚠️ There is deliberately NO cancel REASON here, unlike
                    //     every other terminal transition in this file. The field
                    //     does not exist on this collection and adding it needs a
                    //     UI change; permitting an unvalidated key in the allow-
                    //     list instead would be a free-text hole. See ADR-40.
                    //
                    //     ⚠️ POSTED IS NOT CANCELLABLE. A posted invoice matches
                    //     no branch at all — corrections are Supplier Credit
                    //     Notes (ADR-31). This closes the documented ADR-24
                    //     consequence in which a direct SDK call could cancel a
                    //     posted invoice a Supplier Payment had already settled.
                    (
                      (resource.data.status == 'draft' || resource.data.status == 'approved')
                      && request.resource.data.status == 'cancelled'
                      && changedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy', 'updatedAt', 'updatedBy'])
                      && request.resource.data.cancelledBy == request.auth.uid
                      && request.resource.data.cancelledAt == request.time
                    )
                  );

      allow delete: if false;
    }

    // Variations — type-discriminated client (CV) / supplier (SV) change control
    // (ADR-18). Financial roles only. Lifecycle RULES-ENFORCED (ADR-59, M2-B3):
    // born draft, a get()-verified PO for PO-linked supplier variations, draft-only
    // edits, stamps-only transitions, SIGNED whole-cent headers never clamped,
    // revision +1, the ADR-34 RFI link draft-only; delete blocked. What rules
    // cannot verify is docs/SECURITY.md → Deferred Control 37.
    match /companies/{companyId}/projects/{projectId}/variations/{variationId} {
      function variationMember() {
        return request.auth != null
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['company_admin', 'project_manager', 'qs'];
      }
      // A whole-cent double (lib/purchaseOrders.js → roundMoney output): within
      // a thousandth of a cent of an integer number of cents. Signed.
      function wholeCents(v) {
        return v is number && math.abs(v * 100 - math.round(v * 100)) < 0.001;
      }
      // Header identity on either side: subtotal + gst == total in cents. The
      // GST itself cannot be pinned — it is Σ per-line gstForLine(amount,
      // taxCode) over lines of mixed tax codes and signs (DC37).
      function moneyValid(a, g, t) {
        return wholeCents(a) && wholeCents(g) && wholeCents(t)
            && cents(a) + cents(g) == cents(t);
      }
      function isDate(v) {
        return v is string && (v == '' || v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
      }
      function text(v, n) {
        return v is string && v.size() <= n;
      }
      function idOrNull(v) {
        return v == null || (v is string && v.size() > 0);
      }
      // M3-B1 (ADR-62): the commitment-application pair. Absent on every
      // document until an approve of a PO-linked supplier variation whose PO is
      // sent/closed (branch c) or the one-time legacy Apply (branch f) writes
      // it — actor == caller, time == server, PO re-read through poPath().
      function appliedAbsent(d) {
        return !d.keys().hasAny(['commitmentAppliedAt', 'commitmentAppliedBy']);
      }
      function appliedStamped(d) {
        return d.commitmentAppliedBy == request.auth.uid
            && d.commitmentAppliedAt == request.time;
      }
      // M3-B2 (ADR-63): the second, independent pair — the new-scope commitment.
      // Written with the applied pair on a PO-linked approve (branch c) or by
      // the one-time legacy Commit (branch f); never on a client / manual-mode
      // variation, never at create.
      function scopeAbsent(d) {
        return !d.keys().hasAny(['scopeCommittedAt', 'scopeCommittedBy']);
      }
      function scopeStamped(d) {
        return d.scopeCommittedBy == request.auth.uid
            && d.scopeCommittedAt == request.time;
      }
      // One get(): a missing PO makes `.data` error, which denies.
      function poCommitted() {
        return get(poPath(companyId, projectId)).data.status in ['sent', 'closed'];
      }
      // (f) APPLY / COMMIT NEW SCOPE (M3-B1 ADR-62 · M3-B2 ADR-63) — the
      // ONE-TIME legacy write of the stamp pair(s) an APPROVED, PO-linked
      // supplier variation lacks: the missing pair(s) + revision + audit stamps
      // and nothing else, while the PO is sent/closed. EACH written pair's
      // stored value must be null/absent, so a repeat is refused by rules and a
      // present pair is never rewritten; approved money, lines and the PO link
      // stay frozen (outside the list). `changedKeys()` is bound ONCE — every
      // diff spends from the 1000-expression ceiling.
      function legacyCommitValid() {
        let ck = changedKeys();
        let d = request.resource.data;
        let p = resource.data;
        return ck.hasOnly(['commitmentAppliedAt', 'commitmentAppliedBy', 'scopeCommittedAt', 'scopeCommittedBy', 'revision', 'updatedAt', 'updatedBy'])
            && ck.hasAny(['commitmentAppliedAt', 'scopeCommittedAt'])
            && (!ck.hasAny(['commitmentAppliedAt', 'commitmentAppliedBy'])
                || (p.get('commitmentAppliedAt', null) == null && p.get('commitmentAppliedBy', null) == null && appliedStamped(d)))
            && (!ck.hasAny(['scopeCommittedAt', 'scopeCommittedBy'])
                || (p.get('scopeCommittedAt', null) == null && p.get('scopeCommittedBy', null) == null && scopeStamped(d)));
      }
      // The RFI this candidate cites, in THIS company and THIS project (ADR-34).
      function originRfiDoc(d) {
        return get(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/rfis/$(d.originRfiId)).data;
      }
      function originUnlinked(d) {
        return d.get('originRfiId', null) == null
            && d.get('originRfiNumber', null) == null
            && d.get('originRfiTitle', null) == null;
      }
      function originLinked(d) {
        return d.get('originRfiId', null) is string
            && d.originRfiId.size() > 0
            && d.get('originRfiNumber', null) is string
            && d.get('originRfiTitle', null) is string
            && exists(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/rfis/$(d.originRfiId))
            && originRfiDoc(d).status in ['open', 'answered', 'closed']
            && originRfiDoc(d).rfiNumber == d.originRfiNumber
            && originRfiDoc(d).title == d.originRfiTitle;
      }
      function originRfiValid(d) {
        return originUnlinked(d) || originLinked(d);
      }
      // Value comparison, absent treated as null — legacy documents never
      // register as a change, and an unchanged link is never re-validated.
      function originChanged() {
        return request.resource.data.get('originRfiId', null)     != resource.data.get('originRfiId', null)
            || request.resource.data.get('originRfiNumber', null) != resource.data.get('originRfiNumber', null)
            || request.resource.data.get('originRfiTitle', null)  != resource.data.get('originRfiTitle', null);
      }
      // Exact key set of a document the app creates (hooks/useVariations.jsx).
      function exactKeys() {
        return request.resource.data.keys().hasOnly(['variationNumber', 'variationType', 'status', 'title', 'description', 'reason', 'clientId', 'clientName', 'clientRef', 'supplierId', 'supplierName', 'supplierRef', 'poId', 'poNumber', 'originRfiId', 'originRfiNumber', 'originRfiTitle', 'lineItems', 'submittedSubtotal', 'submittedGst', 'submittedTotal', 'approvedSubtotal', 'approvedGst', 'approvedTotal', 'forecastAmount', 'identifiedDate', 'submittedDate', 'responseDueDate', 'approvedDate', 'effectiveDate', 'currency', 'revision', 'notes', 'assessmentNotes', 'submittedAt', 'submittedBy', 'approvedAt', 'approvedBy', 'rejectedAt', 'rejectedBy', 'withdrawnAt', 'withdrawnBy', 'attachments', 'externalRefs', 'supersededByVariationId', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'commitmentAppliedAt', 'commitmentAppliedBy', 'scopeCommittedAt', 'scopeCommittedBy'])
            && request.resource.data.keys().hasAll(['variationNumber', 'variationType', 'status', 'title', 'description', 'reason', 'clientId', 'clientName', 'clientRef', 'supplierId', 'supplierName', 'supplierRef', 'poId', 'poNumber', 'originRfiId', 'originRfiNumber', 'originRfiTitle', 'lineItems', 'submittedSubtotal', 'submittedGst', 'submittedTotal', 'approvedSubtotal', 'approvedGst', 'approvedTotal', 'forecastAmount', 'identifiedDate', 'submittedDate', 'responseDueDate', 'approvedDate', 'effectiveDate', 'currency', 'revision', 'notes', 'assessmentNotes', 'submittedAt', 'submittedBy', 'approvedAt', 'approvedBy', 'rejectedAt', 'rejectedBy', 'withdrawnAt', 'withdrawnBy', 'attachments', 'externalRefs', 'supersededByVariationId', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy']);
      }
      // Tier-2 source validation — CREATE ONLY, supplier variations that name a
      // PO. The PO must exist in THIS project and be sent or closed
      // (lib/variations.js → VARIATION_PO_STATUSES), and the variation's
      // poNumber and supplier snapshot must be the PO's. Never re-checked: a
      // variation survives its PO's later cancellation (the PO cancel guard is
      // the client's, DC35).
      // The PO is bound ONCE (`let po`): the variations create evaluation
      // reached the engine's 1000-expression ceiling in the emulator once the
      // ADR-63 keys were added. A missing PO makes `.data` error, which denies
      // exactly as `exists()` did.
      function sourcePoValid() {
        let d = request.resource.data;
        let po = get(poPath(companyId, projectId)).data;
        return po.status in ['sent', 'closed']
            && po.poNumber == d.poNumber
            && po.supplierName == d.supplierName
            && po.get('supplierId', null) == d.supplierId;
      }
      // Identity written once: type-discriminated number and counterparty, the
      // other type's block all null, reserved fields at their reserved values.
      function identityShapeValid() {
        let d = request.resource.data;
        return d.variationType in ['client', 'supplier']
            && d.variationNumber is string
            && d.variationNumber.matches(d.variationType == 'client' ? '^CV-[0-9]{4,}$' : '^SV-[0-9]{4,}$')
            && d.currency is string
            && d.currency.matches('^[A-Z]{3}$')
            && d.revision == 1
            && d.externalRefs is map
            && d.attachments is list
            && d.attachments.size() == 0
            && d.supersededByVariationId == null
            && d.forecastAmount == null
            && (d.variationType == 'client'
                 ? (idOrNull(d.clientId) && text(d.clientName, 200)
                    && d.supplierId == null && d.supplierName == null && d.poId == null && d.poNumber == null)
                 : (idOrNull(d.supplierId) && text(d.supplierName, 200)
                    && d.clientId == null && d.clientName == null
                    && (d.poId == null ? d.poNumber == null : (d.poId is string && d.poId.size() > 0 && sourcePoValid()))));
      }
      // The external reference belongs to the document's own type; the other
      // type's is null (create and draft edit).
      function refsValid() {
        let d = request.resource.data;
        return d.variationType == 'client'
             ? (text(d.clientRef, 200) && d.supplierRef == null)
             : (text(d.supplierRef, 200) && d.clientRef == null);
      }
      // Authored content. Bounds stop unbounded strings, not business cases;
      // the line COUNT is the honest ceiling on `lineItems` (no iteration).
      function contentShapeValid() {
        let d = request.resource.data;
        return d.title is string
            && d.title.size() > 0
            && d.title.size() <= 500
            && text(d.description, 5000)
            && d.reason in ['', 'design_change', 'site_condition', 'client_instruction', 'error_omission', 'other']
            && isDate(d.identifiedDate)
            && isDate(d.submittedDate)
            && isDate(d.responseDueDate)
            && isDate(d.effectiveDate)
            && text(d.notes, 5000)
            && d.lineItems is list
            && d.lineItems.size() >= 1
            && d.lineItems.size() <= 200;
      }
      // Born draft, stamped by its creator, every lifecycle stamp, approved
      // value and assessment field empty.
      function createValid() {
        let d = request.resource.data;
        return d.status == 'draft'
            && d.createdBy == request.auth.uid
            && d.createdAt == request.time
            && d.submittedAt == null && d.submittedBy == null
            && d.approvedAt == null && d.approvedBy == null
            && d.rejectedAt == null && d.rejectedBy == null
            && d.withdrawnAt == null && d.withdrawnBy == null
            && d.approvedSubtotal == null && d.approvedGst == null && d.approvedTotal == null
            && d.approvedDate == ''
            && d.assessmentNotes == ''
            && appliedAbsent(d)
            && scopeAbsent(d);
      }

      allow read: if variationMember();

      allow create: if variationMember()
                  && exactKeys()
                  && createValid()
                  && updateStamped()
                  && identityShapeValid()
                  && refsValid()
                  && contentShapeValid()
                  && moneyValid(request.resource.data.submittedSubtotal, request.resource.data.submittedGst, request.resource.data.submittedTotal)
                  && exists(projectPath(companyId, projectId))
                  && request.resource.data.currency == resolvedCurrency(companyId, projectId)
                  && originRfiValid(request.resource.data);

      // `resource != null` first — a denied create is also measured against
      // this rule. Every branch's hasOnly on changedKeys() is what freezes the
      // identity, the counterparty, the PO link, the reserved fields and every
      // stamp or figure a branch does not own — a key outside the list cannot
      // be added, removed or changed.
      allow update: if resource != null
                  && variationMember() && updateStamped() && revisionIncremented() && (
                    // (a) DRAFT EDIT — the authored content, the re-derived
                    //     submitted header and the originating-RFI link (which
                    //     must validate when it changes — ADR-34).
                    (
                      resource.data.status == 'draft'
                      && changedKeys().hasOnly(['title', 'description', 'reason', 'clientRef', 'supplierRef', 'identifiedDate', 'responseDueDate', 'effectiveDate', 'lineItems', 'submittedSubtotal', 'submittedGst', 'submittedTotal', 'notes', 'originRfiId', 'originRfiNumber', 'originRfiTitle', 'revision', 'updatedAt', 'updatedBy'])
                      && contentShapeValid()
                      && refsValid()
                      && moneyValid(request.resource.data.submittedSubtotal, request.resource.data.submittedGst, request.resource.data.submittedTotal)
                      && (!originChanged() || originRfiValid(request.resource.data))
                    )
                    ||
                    // (b) SUBMIT — THE SUBMITTED-MONEY FREEZE POINT. Stamps
                    //     and the submitted date only; the stored lines are
                    //     what gets frozen.
                    (
                      resource.data.status == 'draft'
                      && request.resource.data.status == 'submitted'
                      && resource.data.lineItems is list
                      && resource.data.lineItems.size() >= 1
                      && changedKeys().hasOnly(['status', 'submittedDate', 'submittedAt', 'submittedBy', 'revision', 'updatedAt', 'updatedBy'])
                      && isDate(request.resource.data.submittedDate)
                      && request.resource.data.submittedBy == request.auth.uid
                      && request.resource.data.submittedAt == request.time
                    )
                    ||
                    // (c) APPROVE — THE CERTIFICATION POINT (the only state
                    //     that counts financially). Writes the certified lines
                    //     (contents unverifiable — the count is pinned), the
                    //     SIGNED approved header, the notes, the approved and
                    //     effective dates and its own stamps. Approved amounts
                    //     are unbounded against submitted by product decision.
                    //     M3-B1 (ADR-62): a PO-linked SUPPLIER variation is
                    //     approved AND applied in ONE write — its PO must exist
                    //     in THIS project and be sent/closed (get()), and the
                    //     commitment stamps must be present (actor == caller,
                    //     time == server). A missing / cancelled / draft PO
                    //     REFUSES the approval (withdraw or reject instead).
                    //     Manual-mode and client variations (poId null) never
                    //     carry the pair. M3-B2 (ADR-63): the same write also
                    //     carries the new-scope pair (`scopeCommitted*`),
                    //     REQUIRED by this FINAL file. The STAGE-1 transitional
                    //     ruleset (scripts/build-transitional-rules.mjs)
                    //     differs from this FINAL file only in the marked lines.
                    (
                      resource.data.status in ['submitted', 'under_review']
                      && request.resource.data.status == 'approved'
                      && changedKeys().hasOnly(['status', 'lineItems', 'approvedSubtotal', 'approvedGst', 'approvedTotal', 'assessmentNotes', 'approvedDate', 'effectiveDate', 'approvedAt', 'approvedBy', 'revision', 'updatedAt', 'updatedBy', 'commitmentAppliedAt', 'commitmentAppliedBy', 'scopeCommittedAt', 'scopeCommittedBy'])
                      && request.resource.data.approvedBy == request.auth.uid
                      && request.resource.data.approvedAt == request.time
                      && request.resource.data.lineItems is list
                      && request.resource.data.lineItems.size() == resource.data.lineItems.size()
                      && text(request.resource.data.assessmentNotes, 5000)
                      && isDate(request.resource.data.approvedDate)
                      && request.resource.data.approvedDate != ''
                      && isDate(request.resource.data.effectiveDate)
                      && moneyValid(request.resource.data.approvedSubtotal, request.resource.data.approvedGst, request.resource.data.approvedTotal)
                      && (resource.data.poId == null
                          ? (appliedAbsent(request.resource.data) && scopeAbsent(request.resource.data))
                          : (resource.data.variationType == 'supplier'
                              && poCommitted()
                              && appliedStamped(request.resource.data) && scopeStamped(request.resource.data))) // ADR-63 FINAL: BOTH pairs are REQUIRED on a PO-linked approve
                    )
                    ||
                    // (d) REJECT (terminal) — stamps plus the optional notes.
                    (
                      resource.data.status in ['submitted', 'under_review']
                      && request.resource.data.status == 'rejected'
                      && changedKeys().hasOnly(['status', 'rejectedAt', 'rejectedBy', 'assessmentNotes', 'revision', 'updatedAt', 'updatedBy'])
                      && request.resource.data.rejectedBy == request.auth.uid
                      && request.resource.data.rejectedAt == request.time
                      && text(request.resource.data.assessmentNotes, 5000)
                    )
                    ||
                    // (e) WITHDRAW (terminal) — stamps only.
                    (
                      resource.data.status in ['draft', 'submitted', 'under_review']
                      && request.resource.data.status == 'withdrawn'
                      && changedKeys().hasOnly(['status', 'withdrawnAt', 'withdrawnBy', 'revision', 'updatedAt', 'updatedBy'])
                      && request.resource.data.withdrawnBy == request.auth.uid
                      && request.resource.data.withdrawnAt == request.time
                    )
                    ||
                    // (f) APPLY / COMMIT NEW SCOPE — see legacyCommitValid() above.
                    (
                      resource.data.status == 'approved'
                      && request.resource.data.status == 'approved'
                      && resource.data.variationType == 'supplier'
                      && resource.data.poId is string
                      && legacyCommitValid()
                      && poCommitted()
                    )
                  );

      allow delete: if false;
    }

    // Forecast Lines — one input document per cost code (uncommittedCostToComplete,
    // notes, stamps); every forecast figure is derived at read time. Financial
    // roles only (commercially sensitive); idempotent upsert; delete blocked.
    match /companies/{companyId}/projects/{projectId}/forecastLines/{costCodeId} {
      allow read, create, update: if request.auth != null
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['company_admin', 'project_manager', 'qs'];
      allow delete: if false;
    }

    // Project Commercial Baseline — the Margin foundation inputs in ONE document
    // with the deterministic id `baseline` (no other commercial/* id has a rule).
    // Financial roles only — tighter than the member-readable project document,
    // which is why it is not stored there. Delete blocked. Non-negative amounts
    // and Original-Approved-Budget immutability stay client-only (TODO).
    match /companies/{companyId}/projects/{projectId}/commercial/baseline {
      allow read, create, update: if request.auth != null
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['company_admin', 'project_manager', 'qs'];
      allow delete: if false;
    }

    // Client Invoices — accounts-receivable invoices to the head-contract client;
    // CI-#### from the company counters block below.
    match /companies/{companyId}/projects/{projectId}/clientInvoices/{invoiceId} {
      function corePreserved() {
        return request.resource.data.invoiceNumber == resource.data.invoiceNumber
            && request.resource.data.currency      == resource.data.currency
            && request.resource.data.createdAt     == resource.data.createdAt
            && request.resource.data.createdBy     == resource.data.createdBy
            && request.resource.data.docType       == resource.data.docType
            && request.resource.data.revision      == resource.data.revision;
      }

      allow read: if financialMember(companyId);

      allow create: if financialMember(companyId)
                  && request.resource.data.status == 'draft'
                  && request.resource.data.docType == 'invoice'
                  && request.resource.data.invoiceNumber is string
                  && request.resource.data.currency is string
                  && request.resource.data.currency.matches('^[A-Z]{3}$')
                  && request.resource.data.revision is number
                  && request.resource.data.createdBy == request.auth.uid
                  && request.resource.data.createdAt == request.time
                  && updateStamped()
                  // Lifecycle stamps cannot be forged at creation.
                  && request.resource.data.issuedAt == null
                  && request.resource.data.issuedBy == null
                  && request.resource.data.voidedAt == null
                  && request.resource.data.voidedBy == null;

      allow update: if financialMember(companyId) && corePreserved() && updateStamped() && (
                    // (a) DRAFT EDIT — content is freely editable while draft,
                    //     but the status may not move and no lifecycle stamp
                    //     may be forged.
                    (
                      resource.data.status == 'draft'
                      && request.resource.data.status == 'draft'
                      && request.resource.data.issuedAt == resource.data.issuedAt
                      && request.resource.data.issuedBy == resource.data.issuedBy
                      && request.resource.data.voidedAt == resource.data.voidedAt
                      && request.resource.data.voidedBy == resource.data.voidedBy
                    )
                    ||
                    // (b) DRAFT -> ISSUED. A separate operation carrying no
                    //     content change whatsoever.
                    (
                      resource.data.status == 'draft'
                      && request.resource.data.status == 'issued'
                      && changedKeys().hasOnly(['status', 'issuedAt', 'issuedBy', 'updatedAt', 'updatedBy'])
                      && request.resource.data.issuedBy == request.auth.uid
                      && request.resource.data.issuedAt == request.time
                    )
                    ||
                    // (c) DRAFT|ISSUED -> VOID (terminal). This branch is what
                    //     makes an ISSUED invoice immutable: voiding is the only
                    //     permitted update, and it may touch nothing else.
                    (
                      (resource.data.status == 'draft' || resource.data.status == 'issued')
                      && request.resource.data.status == 'void'
                      && changedKeys().hasOnly(['status', 'voidedAt', 'voidedBy', 'voidReason', 'updatedAt', 'updatedBy'])
                      && request.resource.data.voidedBy == request.auth.uid
                      && request.resource.data.voidedAt == request.time
                      && request.resource.data.voidReason is string
                      && request.resource.data.voidReason.trim().size() > 0
                    )
                  );

      allow delete: if false;
    }

    // Client Receipts — cash actually received from a client, with EMBEDDED
    // allocations against issued Client Invoices; CR-#### from the company counters.
    match /companies/{companyId}/projects/{projectId}/clientReceipts/{receiptId} {
      function corePreserved() {
        return request.resource.data.receiptNumber == resource.data.receiptNumber
            && request.resource.data.currency      == resource.data.currency
            && request.resource.data.createdAt     == resource.data.createdAt
            && request.resource.data.createdBy     == resource.data.createdBy
            && request.resource.data.docType       == resource.data.docType
            && request.resource.data.revision      == resource.data.revision;
      }
      // Shape required of every stored state (create and draft edit alike).
      function shapeValid() {
        return request.resource.data.docType == 'receipt'
            && request.resource.data.receiptNumber is string
            && request.resource.data.revision is number
            // A receipt without a client is not a record — clientId/clientName
            // are REQUIRED non-empty strings, never null.
            && request.resource.data.clientId is string
            && request.resource.data.clientId.size() > 0
            && request.resource.data.clientName is string
            && request.resource.data.clientName.size() > 0
            && request.resource.data.currency is string
            && request.resource.data.currency.matches('^[A-Z]{3}$')
            && request.resource.data.receiptDate is string
            && request.resource.data.receiptDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.paymentMethod is string
            && request.resource.data.paymentMethod.size() > 0
            && request.resource.data.paymentMethod.size() <= 40
            && request.resource.data.allocations is list
            && request.resource.data.allocations.size() <= 100
            && amountInvariant();
      }

      allow read: if financialMember(companyId);

      allow create: if financialMember(companyId)
                  && shapeValid()
                  && request.resource.data.status == 'draft'
                  && request.resource.data.createdBy == request.auth.uid
                  && request.resource.data.createdAt == request.time
                  && updateStamped()
                  // Lifecycle stamps cannot be forged at creation.
                  && request.resource.data.postedAt == null
                  && request.resource.data.postedBy == null
                  && request.resource.data.voidedAt == null
                  && request.resource.data.voidedBy == null;

      allow update: if financialMember(companyId) && corePreserved() && updateStamped() && (
                    // (a) DRAFT EDIT — content (amount, date, method,
                    //     references, allocations) is freely editable while
                    //     draft, but the status may not move and no lifecycle
                    //     stamp may be forged.
                    (
                      resource.data.status == 'draft'
                      && request.resource.data.status == 'draft'
                      && shapeValid()
                      && request.resource.data.postedAt == resource.data.postedAt
                      && request.resource.data.postedBy == resource.data.postedBy
                      && request.resource.data.voidedAt == resource.data.voidedAt
                      && request.resource.data.voidedBy == resource.data.voidedBy
                    )
                    ||
                    // (b) DRAFT -> POSTED. A separate operation carrying no
                    //     content change whatsoever — the amount, date, and
                    //     allocations that were reviewed are the ones committed.
                    (
                      resource.data.status == 'draft'
                      && request.resource.data.status == 'posted'
                      && changedKeys().hasOnly(['status', 'postedAt', 'postedBy', 'updatedAt', 'updatedBy'])
                      && request.resource.data.postedBy == request.auth.uid
                      && request.resource.data.postedAt == request.time
                    )
                    ||
                    // (c) DRAFT|POSTED -> VOID (terminal). This branch is what
                    //     makes a POSTED receipt immutable: voiding is the only
                    //     permitted update, and it may touch nothing else.
                    //     Voiding needs no reversal document — every balance is
                    //     derived at read time, so it restores immediately.
                    (
                      (resource.data.status == 'draft' || resource.data.status == 'posted')
                      && request.resource.data.status == 'void'
                      && changedKeys().hasOnly(['status', 'voidedAt', 'voidedBy', 'voidReason', 'updatedAt', 'updatedBy'])
                      && request.resource.data.voidedBy == request.auth.uid
                      && request.resource.data.voidedAt == request.time
                      && request.resource.data.voidReason is string
                      && request.resource.data.voidReason.trim().size() > 0
                    )
                  );

      allow delete: if false;
    }

    // Supplier Payments — cash actually paid to a supplier, with EMBEDDED
    // allocations against POSTED Supplier Invoices; SP-#### from the company counters.
    match /companies/{companyId}/projects/{projectId}/supplierPayments/{paymentId} {
      function corePreserved() {
        return request.resource.data.paymentNumber == resource.data.paymentNumber
            && request.resource.data.currency      == resource.data.currency
            && request.resource.data.createdAt     == resource.data.createdAt
            && request.resource.data.createdBy     == resource.data.createdBy
            && request.resource.data.docType       == resource.data.docType
            && request.resource.data.revision      == resource.data.revision;
      }
      // Shape required of every stored state (create and draft edit alike).
      function shapeValid() {
        return request.resource.data.docType == 'payment'
            && request.resource.data.paymentNumber is string
            && request.resource.data.revision is number
            // A payment made to nobody is not a record — supplierId/supplierName
            // are REQUIRED non-empty strings, never null. (Supplier INVOICES may
            // legitimately carry supplierId: null from before the Contacts
            // module; a NEW payment never may.)
            && request.resource.data.supplierId is string
            && request.resource.data.supplierId.size() > 0
            && request.resource.data.supplierName is string
            && request.resource.data.supplierName.size() > 0
            && request.resource.data.currency is string
            && request.resource.data.currency.matches('^[A-Z]{3}$')
            && request.resource.data.paymentDate is string
            && request.resource.data.paymentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.paymentMethod is string
            && request.resource.data.paymentMethod.size() > 0
            && request.resource.data.paymentMethod.size() <= 40
            && request.resource.data.allocations is list
            && request.resource.data.allocations.size() <= 100
            && amountInvariant();
      }

      allow read: if financialMember(companyId);

      allow create: if financialMember(companyId)
                  && shapeValid()
                  && request.resource.data.status == 'draft'
                  && request.resource.data.createdBy == request.auth.uid
                  && request.resource.data.createdAt == request.time
                  && updateStamped()
                  // Lifecycle stamps cannot be forged at creation.
                  && request.resource.data.postedAt == null
                  && request.resource.data.postedBy == null
                  && request.resource.data.voidedAt == null
                  && request.resource.data.voidedBy == null;

      allow update: if financialMember(companyId) && corePreserved() && updateStamped() && (
                    // (a) DRAFT EDIT — content (supplier, amount, date, method,
                    //     references, allocations) is freely editable while
                    //     draft, but the status may not move and no lifecycle
                    //     stamp may be forged.
                    (
                      resource.data.status == 'draft'
                      && request.resource.data.status == 'draft'
                      && shapeValid()
                      && request.resource.data.postedAt == resource.data.postedAt
                      && request.resource.data.postedBy == resource.data.postedBy
                      && request.resource.data.voidedAt == resource.data.voidedAt
                      && request.resource.data.voidedBy == resource.data.voidedBy
                    )
                    ||
                    // (b) DRAFT -> POSTED. A separate operation carrying no
                    //     content change whatsoever — the amount, date, and
                    //     allocations that were reviewed are the ones committed.
                    (
                      resource.data.status == 'draft'
                      && request.resource.data.status == 'posted'
                      && changedKeys().hasOnly(['status', 'postedAt', 'postedBy', 'updatedAt', 'updatedBy'])
                      && request.resource.data.postedBy == request.auth.uid
                      && request.resource.data.postedAt == request.time
                    )
                    ||
                    // (c) DRAFT|POSTED -> VOID (terminal). This branch is what
                    //     makes a POSTED payment immutable: voiding is the only
                    //     permitted update, and it may touch nothing else.
                    //     Voiding needs no reversal, refund, or bank-reversal
                    //     document — every balance is derived at read time, so
                    //     it restores immediately.
                    (
                      (resource.data.status == 'draft' || resource.data.status == 'posted')
                      && request.resource.data.status == 'void'
                      && changedKeys().hasOnly(['status', 'voidedAt', 'voidedBy', 'voidReason', 'updatedAt', 'updatedBy'])
                      && request.resource.data.voidedBy == request.auth.uid
                      && request.resource.data.voidedAt == request.time
                      && request.resource.data.voidReason is string
                      && request.resource.data.voidReason.trim().size() > 0
                    )
                  );

      allow delete: if false;
    }

    // Supplier Credit Notes — reductions against exactly one POSTED Supplier
    // Invoice; SCN-#### from the company counters.
    match /companies/{companyId}/projects/{projectId}/supplierCreditNotes/{creditNoteId} {
      // The document identity that no update of any kind may rewrite. Wider
      // than the cash collections: the TARGET REFERENCE and its supplier
      // snapshots are frozen from creation, so the get()-validated link can
      // never be silently repointed at a different invoice or supplier.
      function corePreserved() {
        return request.resource.data.creditNumber          == resource.data.creditNumber
            && request.resource.data.currency              == resource.data.currency
            && request.resource.data.createdAt             == resource.data.createdAt
            && request.resource.data.createdBy             == resource.data.createdBy
            && request.resource.data.docType               == resource.data.docType
            && request.resource.data.revision              == resource.data.revision
            && request.resource.data.supplierInvoiceId     == resource.data.supplierInvoiceId
            && request.resource.data.invoiceNumber         == resource.data.invoiceNumber
            && request.resource.data.supplierInvoiceNumber == resource.data.supplierInvoiceNumber
            && request.resource.data.supplierId            == resource.data.supplierId
            && request.resource.data.supplierName          == resource.data.supplierName;
      }
      // The header arithmetic guarantee rules CAN give: the stored totals must
      // agree with each other (the lines themselves are unverifiable).
      function headerInvariant() {
        return request.resource.data.subtotal is number
            && request.resource.data.subtotal > 0
            && request.resource.data.gstTotal is number
            && request.resource.data.gstTotal >= 0
            && request.resource.data.grossTotal is number
            && request.resource.data.grossTotal > 0
            && cents(request.resource.data.subtotal + request.resource.data.gstTotal)
               == cents(request.resource.data.grossTotal);
      }
      // The target supplier invoice this credit note reduces. Repeated access
      // to the same document within one evaluation is a single billed read.
      function targetInvoice() {
        return get(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/supplierInvoices/$(request.resource.data.supplierInvoiceId)).data;
      }
      // The single-document target checks (see the block comment above).
      function targetValid() {
        return exists(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/supplierInvoices/$(request.resource.data.supplierInvoiceId))
            && targetInvoice().status == 'posted'
            && targetInvoice().supplierId == request.resource.data.supplierId
            && targetInvoice().currency == request.resource.data.currency
            && targetInvoice().retentionTotal is number
            && cents(targetInvoice().retentionTotal) == 0
            && targetInvoice().payableTotal is number
            && cents(request.resource.data.grossTotal) <= cents(targetInvoice().payableTotal);
      }
      // Shape required of every stored state (create and draft edit alike).
      function shapeValid() {
        return request.resource.data.docType == 'credit_note'
            && request.resource.data.creditNumber is string
            && request.resource.data.revision is number
            && request.resource.data.supplierInvoiceId is string
            && request.resource.data.supplierInvoiceId.size() > 0
            && request.resource.data.invoiceNumber is string
            && request.resource.data.supplierInvoiceNumber is string
            // supplierId is frozen FROM THE TARGET INVOICE, which may
            // legitimately carry null from before the Contacts module — so
            // null is allowed here (unlike supplierPayments), but the get()
            // equality in targetValid() still holds: null must match null.
            && (request.resource.data.supplierId == null
                || (request.resource.data.supplierId is string
                    && request.resource.data.supplierId.size() > 0))
            && request.resource.data.supplierName is string
            && request.resource.data.supplierName.size() > 0
            && request.resource.data.supplierCreditReference is string
            && request.resource.data.creditDate is string
            && request.resource.data.creditDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            // A credit without a stated cause is an audit hole — the reason is
            // authored content, required NON-WHITESPACE at every stored state.
            && request.resource.data.reason is string
            && request.resource.data.reason.trim().size() > 0
            && request.resource.data.notes is string
            && request.resource.data.currency is string
            && request.resource.data.currency.matches('^[A-Z]{3}$')
            && request.resource.data.lineItems is list
            && request.resource.data.lineItems.size() >= 1
            && request.resource.data.lineItems.size() <= 100
            && headerInvariant();
      }

      allow read: if financialMember(companyId);

      allow create: if financialMember(companyId)
                  && shapeValid()
                  && targetValid()
                  && request.resource.data.status == 'draft'
                  && request.resource.data.createdBy == request.auth.uid
                  && request.resource.data.createdAt == request.time
                  && updateStamped()
                  // Lifecycle stamps cannot be forged at creation.
                  && request.resource.data.postedAt == null
                  && request.resource.data.postedBy == null
                  && request.resource.data.voidedAt == null
                  && request.resource.data.voidedBy == null;

      allow update: if financialMember(companyId) && corePreserved() && updateStamped() && (
                    // (a) DRAFT EDIT — content (date, reason, reference, lines,
                    //     totals, notes) is freely editable while draft, but
                    //     the frozen target must still validate (the amounts
                    //     changed, so the payable cap is re-checked), the
                    //     status may not move, and no lifecycle stamp may be
                    //     forged.
                    (
                      resource.data.status == 'draft'
                      && request.resource.data.status == 'draft'
                      && shapeValid()
                      && targetValid()
                      && request.resource.data.postedAt == resource.data.postedAt
                      && request.resource.data.postedBy == resource.data.postedBy
                      && request.resource.data.voidedAt == resource.data.voidedAt
                      && request.resource.data.voidedBy == resource.data.voidedBy
                    )
                    ||
                    // (b) DRAFT -> POSTED. A separate operation carrying no
                    //     content change whatsoever — the target and totals
                    //     that were validated are the ones committed.
                    //
                    //     ⚠️ THE TARGET IS RE-VALIDATED HERE. Posting is the
                    //     FINANCIAL COMMIT POINT: it is the moment this document
                    //     starts reducing Invoiced, Actual and the invoice's
                    //     remaining payable. Validating the target only at
                    //     create/draft-edit would leave a window in which the
                    //     target is cancelled, has retention added, or has its
                    //     payableTotal reduced by a direct SDK call (supplier-
                    //     invoice lifecycle is still client-enforced — Deferred
                    //     Controls 1 and 2) and the stale draft then posts into
                    //     financial activity unchecked. Costs one extra document
                    //     read per post.
                    (
                      resource.data.status == 'draft'
                      && request.resource.data.status == 'posted'
                      && changedKeys().hasOnly(['status', 'postedAt', 'postedBy', 'updatedAt', 'updatedBy'])
                      && request.resource.data.postedBy == request.auth.uid
                      && request.resource.data.postedAt == request.time
                      && targetValid()
                    )
                    ||
                    // (c) DRAFT|POSTED -> VOID (terminal). This branch is what
                    //     makes a POSTED credit note immutable: voiding is the
                    //     only permitted update, and it may touch nothing else.
                    //     Voiding needs no reversal document — every net figure
                    //     is derived at read time, so it restores immediately.
                    (
                      (resource.data.status == 'draft' || resource.data.status == 'posted')
                      && request.resource.data.status == 'void'
                      && changedKeys().hasOnly(['status', 'voidedAt', 'voidedBy', 'voidReason', 'updatedAt', 'updatedBy'])
                      && request.resource.data.voidedBy == request.auth.uid
                      && request.resource.data.voidedAt == request.time
                      && request.resource.data.voidReason is string
                      && request.resource.data.voidReason.trim().size() > 0
                    )
                  );

      allow delete: if false;
    }

    // Cash Flow timing lines — authored monthly GROSS cash forecasts (planning
    // records: no counter, no posting); they never reference another financial
    // document — the cost-side link is the cost-code spine.
    match /companies/{companyId}/projects/{projectId}/cashFlowLines/{lineId} {
      function corePreserved() {
        return request.resource.data.currency  == resource.data.currency
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.basis     == resource.data.basis
            && request.resource.data.revision  == resource.data.revision;
      }
      // Shape required of every stored ACTIVE state (create and edit alike).
      function shapeValid() {
        return request.resource.data.basis == 'gross'
            && request.resource.data.revision == 1
            && request.resource.data.monthKey is string
            && request.resource.data.monthKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
            && request.resource.data.direction in ['in', 'out']
            // Positive gross cash only — a reduction is a line in the opposite
            // direction, never a negative amount.
            && request.resource.data.amount is number
            && request.resource.data.amount > 0
            // Ex-GST source coverage: null (manual lines) or a non-negative
            // number. Which types require which is client-enforced.
            && (request.resource.data.sourceAmountExGst == null
                || (request.resource.data.sourceAmountExGst is number
                    && request.resource.data.sourceAmountExGst >= 0))
            && request.resource.data.sourceType is string
            && request.resource.data.sourceType.size() > 0
            && request.resource.data.sourceType.size() <= 40
            && request.resource.data.sourceRef is string
            && request.resource.data.counterpartyName is string
            // Cost-code spine: both null/'' together, or both real together.
            && ((request.resource.data.costCodeId == null
                 && request.resource.data.costCodeName == '')
                || (request.resource.data.costCodeId is string
                    && request.resource.data.costCodeId.size() > 0
                    && request.resource.data.costCodeName is string
                    && request.resource.data.costCodeName.size() > 0))
            && request.resource.data.description is string
            && request.resource.data.description.trim().size() > 0
            && request.resource.data.notes is string
            && request.resource.data.currency is string
            && request.resource.data.currency.matches('^[A-Z]{3}$');
      }

      allow read: if financialMember(companyId);

      allow create: if financialMember(companyId)
                  && shapeValid()
                  && request.resource.data.status == 'active'
                  && request.resource.data.createdBy == request.auth.uid
                  && request.resource.data.createdAt == request.time
                  && updateStamped()
                  // Void stamps cannot be forged at creation.
                  && request.resource.data.voidedAt == null
                  && request.resource.data.voidedBy == null;

      allow update: if financialMember(companyId) && corePreserved() && updateStamped() && (
                    // (a) ACTIVE EDIT — content (month, direction, source,
                    //     amounts, cost code, description) is freely editable
                    //     while active, but the status may not move and no
                    //     void stamp may be forged.
                    (
                      resource.data.status == 'active'
                      && request.resource.data.status == 'active'
                      && shapeValid()
                      && request.resource.data.voidedAt == resource.data.voidedAt
                      && request.resource.data.voidedBy == resource.data.voidedBy
                    )
                    ||
                    // (b) ACTIVE -> VOID (terminal). Voiding is the only exit:
                    //     it may touch nothing but the void audit fields, so a
                    //     voided line is immutable retained history.
                    (
                      resource.data.status == 'active'
                      && request.resource.data.status == 'void'
                      && changedKeys().hasOnly(['status', 'voidedAt', 'voidedBy', 'voidReason', 'updatedAt', 'updatedBy'])
                      && request.resource.data.voidedBy == request.auth.uid
                      && request.resource.data.voidedAt == request.time
                      && request.resource.data.voidReason is string
                      && request.resource.data.voidReason.trim().size() > 0
                    )
                  );

      allow delete: if false;
    }

    // Tender Packages — a named scope of cost codes put to market, TP-#### from
    // the company counters. No amounts and no currency — the money is on the bids.
    match /companies/{companyId}/projects/{projectId}/tenderPackages/{packageId} {
      function corePreserved() {
        return request.resource.data.tenderNumber == resource.data.tenderNumber
            && request.resource.data.createdAt    == resource.data.createdAt
            && request.resource.data.createdBy    == resource.data.createdBy
            && request.resource.data.revision     == resource.data.revision;
      }
      // '' (no closing date) or a YYYY-MM-DD shape. That the date is future,
      // past, or sane is NOT checked — it is informational only.
      function closingDateValid() {
        return request.resource.data.closingDate == ''
            || (request.resource.data.closingDate is string
                && request.resource.data.closingDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
      }
      // Shape required of every stored draft state (create and draft edit).
      function shapeValid() {
        return request.resource.data.tenderNumber is string
            && request.resource.data.tenderNumber.size() > 0
            && request.resource.data.revision == 1
            && request.resource.data.name is string
            && request.resource.data.name.trim().size() > 0
            && request.resource.data.description is string
            && request.resource.data.scope is string
            && request.resource.data.notes is string
            // ≥1 cost code — the cost-code spine; element shape is client-only.
            && request.resource.data.costCodes is list
            && request.resource.data.costCodes.size() >= 1
            && request.resource.data.costCodes.size() <= 100
            && closingDateValid();
      }
      // The awarded bid this award update points at.
      function awardedBid() {
        return get(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/tenderBids/$(request.resource.data.awardedBidId)).data;
      }
      // M3-A (ADR-61): the one CURRENT purchase order raised from this award.
      // Absent or null on every package until a PO is raised.
      function raisedPoPath(id) {
        return /databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/purchaseOrders/$(id);
      }
      function backlinkPreserved() {
        let d = request.resource.data;
        let p = resource.data;
        return d.get('raisedPoId', null) == p.get('raisedPoId', null)
            && d.get('raisedPoNumber', null) == p.get('raisedPoNumber', null)
            && d.get('raisedPoAt', null) == p.get('raisedPoAt', null)
            && d.get('raisedPoBy', null) == p.get('raisedPoBy', null);
      }
      // The PO this raise links, as it stands AFTER the commit (getAfter —
      // it is created in the same transaction, so get() cannot see it): a
      // draft CREATED IN THIS COMMIT (createdAt == request.time), numbered as
      // recorded, citing THIS package and the awarded bid.
      function raisedPoValid() {
        let d = request.resource.data;
        let po = getAfter(raisedPoPath(d.raisedPoId)).data;
        return d.raisedPoId is string
            && d.raisedPoId.size() > 0
            && d.raisedPoNumber is string
            && d.raisedPoNumber.size() > 0
            && d.raisedPoBy == request.auth.uid
            && d.raisedPoAt == request.time
            && po.status == 'draft'
            && po.createdAt == request.time
            && po.poNumber == d.raisedPoNumber
            && po.sourceTenderPackageId == packageId
            && po.sourceTenderBidId == resource.data.awardedBidId;
      }

      allow read: if financialMember(companyId);

      allow create: if financialMember(companyId)
                  && shapeValid()
                  && request.resource.data.status == 'draft'
                  && request.resource.data.createdBy == request.auth.uid
                  && request.resource.data.createdAt == request.time
                  && updateStamped()
                  // Lifecycle stamps and award/cancel fields cannot be forged
                  // at creation.
                  && request.resource.data.issuedAt == null
                  && request.resource.data.issuedBy == null
                  && request.resource.data.awardedAt == null
                  && request.resource.data.awardedBy == null
                  && request.resource.data.cancelledAt == null
                  && request.resource.data.cancelledBy == null
                  && request.resource.data.awardedBidId == null
                  && request.resource.data.awardedBidderName == null
                  && request.resource.data.awardNotes == ''
                  && request.resource.data.cancelReason == ''
                  // No PO link can be forged at creation (keys absent or null).
                  && request.resource.data.get('raisedPoId', null) == null
                  && request.resource.data.get('raisedPoNumber', null) == null
                  && request.resource.data.get('raisedPoAt', null) == null
                  && request.resource.data.get('raisedPoBy', null) == null;

      allow update: if financialMember(companyId) && corePreserved() && updateStamped() && (
                    // (a) DRAFT EDIT — commercial content (name, description,
                    //     scope, costCodes, closingDate, notes) is freely
                    //     editable while draft, but the status may not move and
                    //     no stamp or award/cancel field may be forged.
                    (
                      resource.data.status == 'draft'
                      && request.resource.data.status == 'draft'
                      && shapeValid()
                      && request.resource.data.issuedAt == resource.data.issuedAt
                      && request.resource.data.issuedBy == resource.data.issuedBy
                      && request.resource.data.awardedAt == resource.data.awardedAt
                      && request.resource.data.awardedBy == resource.data.awardedBy
                      && request.resource.data.cancelledAt == resource.data.cancelledAt
                      && request.resource.data.cancelledBy == resource.data.cancelledBy
                      && request.resource.data.awardedBidId == resource.data.awardedBidId
                      && request.resource.data.awardedBidderName == resource.data.awardedBidderName
                      && request.resource.data.awardNotes == resource.data.awardNotes
                      && request.resource.data.cancelReason == resource.data.cancelReason
                      && backlinkPreserved()
                    )
                    ||
                    // (b) DRAFT -> ISSUED. A separate stamp-only operation
                    //     carrying no content change whatsoever — the scope that
                    //     was reviewed is the scope that goes to market, and it
                    //     freezes here.
                    (
                      resource.data.status == 'draft'
                      && request.resource.data.status == 'issued'
                      && changedKeys().hasOnly(['status', 'issuedAt', 'issuedBy', 'updatedAt', 'updatedBy'])
                      && request.resource.data.issuedBy == request.auth.uid
                      && request.resource.data.issuedAt == request.time
                    )
                    ||
                    // (c) ISSUED EDIT — the closingDate/notes carve-out ONLY.
                    //     Commercial scope (name, description, scope, costCodes)
                    //     stays frozen; extending an informational closing date
                    //     must not force cancel-and-recreate.
                    (
                      resource.data.status == 'issued'
                      && request.resource.data.status == 'issued'
                      && changedKeys().hasOnly(['closingDate', 'notes', 'updatedAt', 'updatedBy'])
                      && closingDateValid()
                      && request.resource.data.notes is string
                    )
                    ||
                    // (d) ISSUED -> AWARDED (terminal). The decision record:
                    //     which received bid on THIS package won. The bid get()
                    //     is what stops awarding a nonexistent bid, another
                    //     package's bid, a void bid, or a forged bidder-name
                    //     snapshot; requiring the CURRENT status to be 'issued'
                    //     is what stops a second award.
                    (
                      resource.data.status == 'issued'
                      && request.resource.data.status == 'awarded'
                      && changedKeys().hasOnly(['status', 'awardedBidId', 'awardedBidderName', 'awardNotes', 'awardedAt', 'awardedBy', 'updatedAt', 'updatedBy'])
                      && request.resource.data.awardedBy == request.auth.uid
                      && request.resource.data.awardedAt == request.time
                      && request.resource.data.awardNotes is string
                      && request.resource.data.awardedBidId is string
                      && request.resource.data.awardedBidId.size() > 0
                      && awardedBid().tenderPackageId == packageId
                      && awardedBid().status == 'received'
                      && request.resource.data.awardedBidderName == awardedBid().bidderName
                    )
                    ||
                    // (e) DRAFT|ISSUED -> CANCELLED (terminal). Touches only the
                    //     cancel audit fields, with a real reason.
                    (
                      (resource.data.status == 'draft' || resource.data.status == 'issued')
                      && request.resource.data.status == 'cancelled'
                      && changedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy', 'cancelReason', 'updatedAt', 'updatedBy'])
                      && request.resource.data.cancelledBy == request.auth.uid
                      && request.resource.data.cancelledAt == request.time
                      && request.resource.data.cancelReason is string
                      && request.resource.data.cancelReason.trim().size() > 0
                    )
                    ||
                    // (f) RAISE PO (M3-A, ADR-61) — an AWARDED package records
                    //     the ONE draft PO raised from it, once. Only in the
                    //     transaction that creates that PO (getAfter).
                    (
                      resource.data.status == 'awarded'
                      && request.resource.data.status == 'awarded'
                      && changedKeys().hasOnly(['raisedPoId', 'raisedPoNumber', 'raisedPoAt', 'raisedPoBy', 'updatedAt', 'updatedBy'])
                      && resource.data.get('raisedPoId', null) == null
                      && raisedPoValid()
                    )
                    ||
                    // (g) RE-RAISE — only once the previously linked PO is
                    //     CANCELLED (get(), already committed), and never to
                    //     the same PO. The cancelled PO keeps its source keys.
                    (
                      resource.data.status == 'awarded'
                      && request.resource.data.status == 'awarded'
                      && changedKeys().hasOnly(['raisedPoId', 'raisedPoNumber', 'raisedPoAt', 'raisedPoBy', 'updatedAt', 'updatedBy'])
                      && resource.data.get('raisedPoId', null) is string
                      && request.resource.data.raisedPoId != resource.data.raisedPoId
                      && get(raisedPoPath(resource.data.raisedPoId)).data.status == 'cancelled'
                      && raisedPoValid()
                    )
                  );

      allow delete: if false;
    }

    // Tender Bids — manual transcriptions of bids against an ISSUED package,
    // priced per cost code ex-GST. Random ids, no counter; project-level with a
    // tenderPackageId reference so rules verify containment via get().
    match /companies/{companyId}/projects/{projectId}/tenderBids/{bidId} {
      // The document identity that no update of any kind may rewrite: package
      // linkage, both frozen snapshots, bidder identity, currency, creation.
      function corePreserved() {
        return request.resource.data.tenderPackageId == resource.data.tenderPackageId
            && request.resource.data.tenderNumber    == resource.data.tenderNumber
            && request.resource.data.bidderContactId == resource.data.bidderContactId
            && request.resource.data.bidderName      == resource.data.bidderName
            && request.resource.data.currency        == resource.data.currency
            && request.resource.data.createdAt       == resource.data.createdAt
            && request.resource.data.createdBy       == resource.data.createdBy
            && request.resource.data.revision        == resource.data.revision;
      }
      // The parent package, from the SAME project path as this bid — so a bid
      // can never graft onto another project's (or company's) package.
      function parentPackage(pkgId) {
        return get(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/tenderPackages/$(pkgId)).data;
      }
      // The bidder contact named on a create.
      function bidderContact() {
        return get(/databases/$(database)/documents/companies/$(companyId)/contacts/$(request.resource.data.bidderContactId)).data;
      }
      // Shape required of every stored received state (create and edit alike).
      function shapeValid() {
        return request.resource.data.tenderPackageId is string
            && request.resource.data.tenderPackageId.size() > 0
            && request.resource.data.tenderNumber is string
            && request.resource.data.tenderNumber.size() > 0
            && request.resource.data.bidderContactId is string
            && request.resource.data.bidderContactId.size() > 0
            && request.resource.data.bidderName is string
            && request.resource.data.bidderName.size() > 0
            && request.resource.data.bidDate is string
            && request.resource.data.bidDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.bidderRef is string
            && request.resource.data.exclusions is string
            && request.resource.data.notes is string
            // ≥1 priced line; element shape is client-only (see block note).
            && request.resource.data.lineItems is list
            && request.resource.data.lineItems.size() >= 1
            && request.resource.data.lineItems.size() <= 100
            && request.resource.data.currency is string
            && request.resource.data.currency.matches('^[A-Z]{3}$')
            && request.resource.data.revision == 1;
      }

      allow read: if financialMember(companyId);

      allow create: if financialMember(companyId)
                  && shapeValid()
                  && request.resource.data.status == 'received'
                  && request.resource.data.createdBy == request.auth.uid
                  && request.resource.data.createdAt == request.time
                  && updateStamped()
                  // Void stamps cannot be forged at creation.
                  && request.resource.data.voidedAt == null
                  && request.resource.data.voidedBy == null
                  && request.resource.data.voidReason == ''
                  // Parent package must exist IN THIS PROJECT and be issued —
                  // no bids on draft, awarded, or cancelled packages.
                  && parentPackage(request.resource.data.tenderPackageId).status == 'issued'
                  // The tenderNumber snapshot cannot be forged.
                  && request.resource.data.tenderNumber == parentPackage(request.resource.data.tenderPackageId).tenderNumber
                  // The bidder must be a real supplier/subcontractor contact in
                  // this company, and the name snapshot must match it.
                  && bidderContact().contactTypes.hasAny(['supplier', 'subcontractor'])
                  && request.resource.data.bidderName == bidderContact().displayName;

      allow update: if financialMember(companyId) && corePreserved() && updateStamped() && (
                    // (a) RECEIVED EDIT — transcription corrections (bidDate,
                    //     bidderRef, lineItems, exclusions, notes) while the
                    //     parent package is STILL ISSUED. The status may not
                    //     move and no void stamp may be forged. Once the
                    //     package is awarded or cancelled this branch (and the
                    //     void branch) stop matching — bids freeze.
                    (
                      resource.data.status == 'received'
                      && request.resource.data.status == 'received'
                      && shapeValid()
                      && request.resource.data.voidedAt == resource.data.voidedAt
                      && request.resource.data.voidedBy == resource.data.voidedBy
                      && request.resource.data.voidReason == resource.data.voidReason
                      && parentPackage(resource.data.tenderPackageId).status == 'issued'
                    )
                    ||
                    // (b) RECEIVED -> VOID (terminal), only while the parent
                    //     package is still issued. Touches only the void audit
                    //     fields, with a real reason.
                    (
                      resource.data.status == 'received'
                      && request.resource.data.status == 'void'
                      && changedKeys().hasOnly(['status', 'voidedAt', 'voidedBy', 'voidReason', 'updatedAt', 'updatedBy'])
                      && request.resource.data.voidedBy == request.auth.uid
                      && request.resource.data.voidedAt == request.time
                      && request.resource.data.voidReason is string
                      && request.resource.data.voidReason.trim().size() > 0
                      && parentPackage(resource.data.tenderPackageId).status == 'issued'
                    )
                  );

      allow delete: if false;
    }

    // Project Timeline activities — the project programme (ADR-29).
    match /companies/{companyId}/projects/{projectId}/activities/{activityId} {
      // Read audience — includes qs.
      function programmeReader() {
        return sameCompany(companyId) && memberRole() in ['company_admin', 'project_manager', 'qs'];
      }
      // Write audience — deliberately EXCLUDES qs.
      function programmeWriter() {
        return sameCompany(companyId) && memberRole() in ['company_admin', 'project_manager'];
      }
      function corePreserved() {
        return request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.revision  == resource.data.revision;
      }
      // EXACT shape — hasOnly + hasAll together mean no field may be added,
      // renamed, or omitted. Pre-seeding an arbitrary privilege-bearing field
      // is the lesson of ADR-27.
      function exactKeys() {
        return request.resource.data.keys().hasOnly([
                 'name', 'description', 'isMilestone', 'status',
                 'plannedStart', 'plannedFinish', 'actualStart', 'actualFinish',
                 'percentComplete', 'responsibleContactId', 'responsibleName',
                 'costCodeId', 'costCodeName', 'sortOrder', 'notes',
                 'cancelReason', 'cancelledAt', 'cancelledBy',
                 'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
               ])
            && request.resource.data.keys().hasAll([
                 'name', 'description', 'isMilestone', 'status',
                 'plannedStart', 'plannedFinish', 'actualStart', 'actualFinish',
                 'percentComplete', 'responsibleContactId', 'responsibleName',
                 'costCodeId', 'costCodeName', 'sortOrder', 'notes',
                 'cancelReason', 'cancelledAt', 'cancelledBy',
                 'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
               ]);
      }
      // Shape required of every stored NON-CANCELLED state (create and edit).
      function shapeValid() {
        return exactKeys()
            && request.resource.data.revision == 1
            && request.resource.data.name is string
            && request.resource.data.name.trim().size() > 0
            && request.resource.data.name.size() <= 120
            && request.resource.data.description is string
            && request.resource.data.description.size() <= 500
            && request.resource.data.notes is string
            && request.resource.data.notes.size() <= 500
            && request.resource.data.isMilestone is bool
            // Closed status set; `cancelled` is reachable only via the branch
            // below, so it is excluded from every ordinary write.
            && request.resource.data.status in ['not_started', 'in_progress', 'on_hold', 'completed']
            // Programme dates are DATE-ONLY strings. The finish is INCLUSIVE,
            // and string comparison is exact for zero-padded ISO.
            && isIsoDate(request.resource.data.plannedStart)
            && isIsoDate(request.resource.data.plannedFinish)
            && request.resource.data.plannedFinish >= request.resource.data.plannedStart
            // A milestone is a point in time, not a one-day activity.
            && (!request.resource.data.isMilestone
                || request.resource.data.plannedFinish == request.resource.data.plannedStart)
            && (request.resource.data.actualStart == null
                || isIsoDate(request.resource.data.actualStart))
            && (request.resource.data.actualFinish == null
                || isIsoDate(request.resource.data.actualFinish))
            && (request.resource.data.actualStart == null
                || request.resource.data.actualFinish == null
                || request.resource.data.actualFinish >= request.resource.data.actualStart)
            // Manually authored progress — bounded whole percent.
            && request.resource.data.percentComplete is int
            && request.resource.data.percentComplete >= 0
            && request.resource.data.percentComplete <= 100
            && (!request.resource.data.isMilestone
                || request.resource.data.percentComplete == 0
                || request.resource.data.percentComplete == 100)
            // Status invariants — status, progress and actual dates may not
            // contradict each other.
            && (request.resource.data.status != 'not_started'
                || (request.resource.data.percentComplete == 0
                    && request.resource.data.actualStart == null
                    && request.resource.data.actualFinish == null))
            && (request.resource.data.status != 'in_progress'
                || request.resource.data.actualStart != null)
            && (request.resource.data.status != 'completed'
                || (request.resource.data.percentComplete == 100
                    && request.resource.data.actualFinish != null))
            // Responsible party: a Contacts link with a FROZEN name snapshot —
            // both null/'' together, or both real together. Never a user
            // account: users/{uid} is client-read-only (ADR-27), so no client
            // can resolve another user.
            && ((request.resource.data.responsibleContactId == null
                 && request.resource.data.responsibleName == '')
                || (request.resource.data.responsibleContactId is string
                    && request.resource.data.responsibleContactId.size() > 0
                    && request.resource.data.responsibleName is string
                    && request.resource.data.responsibleName.trim().size() > 0
                    && request.resource.data.responsibleName.size() <= 120))
            // Cost-code spine: the same both-or-neither idiom.
            && ((request.resource.data.costCodeId == null
                 && request.resource.data.costCodeName == '')
                || (request.resource.data.costCodeId is string
                    && request.resource.data.costCodeId.size() > 0
                    && request.resource.data.costCodeName is string
                    && request.resource.data.costCodeName.trim().size() > 0
                    && request.resource.data.costCodeName.size() <= 120))
            && request.resource.data.sortOrder is number;
      }

      allow read: if programmeReader();

      allow create: if programmeWriter()
                  && shapeValid()
                  && request.resource.data.createdBy == request.auth.uid
                  && request.resource.data.createdAt == request.time
                  && updateStamped()
                  // Cancellation cannot be forged at creation.
                  && request.resource.data.cancelReason == ''
                  && request.resource.data.cancelledAt == null
                  && request.resource.data.cancelledBy == null;

      allow update: if programmeWriter() && corePreserved() && updateStamped() && (
                    // (a) ORDINARY EDIT — content and status are freely
                    //     editable, INCLUDING BACKWARDS, while the activity is
                    //     not cancelled. No cancellation stamp may be forged.
                    (
                      resource.data.status != 'cancelled'
                      && shapeValid()
                      && request.resource.data.cancelReason == resource.data.cancelReason
                      && request.resource.data.cancelledAt == resource.data.cancelledAt
                      && request.resource.data.cancelledBy == resource.data.cancelledBy
                    )
                    ||
                    // (b) CANCELLATION (terminal). The only exit, and it may
                    //     touch nothing but the cancellation audit fields — so
                    //     a cancelled activity is immutable retained history
                    //     and cancelling can never smuggle in a content edit.
                    (
                      resource.data.status != 'cancelled'
                      && request.resource.data.status == 'cancelled'
                      && changedKeys().hasOnly(['status', 'cancelReason', 'cancelledAt', 'cancelledBy', 'updatedAt', 'updatedBy'])
                      && request.resource.data.cancelledBy == request.auth.uid
                      && request.resource.data.cancelledAt == request.time
                      && request.resource.data.cancelReason is string
                      && request.resource.data.cancelReason.trim().size() > 0
                      && request.resource.data.cancelReason.size() <= 500
                    )
                  );

      allow delete: if false;
    }

    // Retention Releases — authorisations making retention ALREADY WITHHELD on a
    // posted Supplier Invoice payable; RR-#### from the company counters.
    match /companies/{companyId}/projects/{projectId}/retentionReleases/{releaseId} {
      // The document identity that no update of any kind may rewrite. The TARGET
      // INVOICE is part of that identity: re-pointing a release at a different
      // invoice would move money between suppliers without any audit trail.
      function corePreserved() {
        return request.resource.data.releaseNumber     == resource.data.releaseNumber
            && request.resource.data.currency          == resource.data.currency
            && request.resource.data.createdAt         == resource.data.createdAt
            && request.resource.data.createdBy         == resource.data.createdBy
            && request.resource.data.docType           == resource.data.docType
            && request.resource.data.revision          == resource.data.revision
            && request.resource.data.supplierInvoiceId == resource.data.supplierInvoiceId;
      }
      function targetInvoice() {
        return get(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/supplierInvoices/$(request.resource.data.supplierInvoiceId));
      }
      // The target must exist, be POSTED (the financial commit point — retention
      // on a draft/approved/cancelled invoice is not real), and hold enough
      // retention for this document's cumulative claim.
      function targetValid() {
        return request.resource.data.supplierInvoiceId is string
            && request.resource.data.supplierInvoiceId.size() > 0
            && exists(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/supplierInvoices/$(request.resource.data.supplierInvoiceId))
            && targetInvoice().data.status == 'posted'
            && targetInvoice().data.retention is number
            && cents(request.resource.data.previouslyReleasedAmount) + cents(request.resource.data.amount)
               <= cents(targetInvoice().data.retention);
      }
      // The arithmetic guarantee rules CAN give per document: the GST is pinned
      // to the cumulative rounding delta, so `gstAmount` cannot be arbitrary
      // merely because releaseTotal happens to add up.
      function moneyValid() {
        return request.resource.data.amount is number
            && request.resource.data.amount > 0
            && request.resource.data.previouslyReleasedAmount is number
            && request.resource.data.previouslyReleasedAmount >= 0
            && request.resource.data.gstAmount is number
            && request.resource.data.gstAmount >= 0
            && request.resource.data.releaseTotal is number
            && request.resource.data.releaseTotal > 0
            && cents(request.resource.data.gstAmount)
               == gstCents(cents(request.resource.data.previouslyReleasedAmount) + cents(request.resource.data.amount))
                  - gstCents(cents(request.resource.data.previouslyReleasedAmount))
            && cents(request.resource.data.releaseTotal)
               == cents(request.resource.data.amount) + cents(request.resource.data.gstAmount);
      }
      // Shape required of every stored DRAFT state (create and draft edit alike).
      function shapeValid() {
        return request.resource.data.docType == 'retention_release'
            && request.resource.data.releaseNumber is string
            && request.resource.data.revision is number
            && request.resource.data.invoiceNumber is string
            && request.resource.data.supplierInvoiceNumber is string
            // Supplier INVOICES may legitimately carry supplierId: null from
            // before the Contacts module and are never backfilled (ADR-15), so a
            // release inheriting that snapshot may too. The NAME is required.
            && (request.resource.data.supplierId == null
                || (request.resource.data.supplierId is string
                    && request.resource.data.supplierId.size() > 0))
            && request.resource.data.supplierName is string
            && request.resource.data.supplierName.size() > 0
            && request.resource.data.currency is string
            && request.resource.data.currency.matches('^[A-Z]{3}$')
            // The date the release was AGREED — not a defects-liability date, a
            // contractual entitlement date, or a payment due date (ADR-30).
            && request.resource.data.releaseDate is string
            && request.resource.data.releaseDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.reason is string
            && request.resource.data.reason.trim().size() > 0
            && request.resource.data.notes is string
            && moneyValid();
      }

      allow read: if financialMember(companyId);

      allow create: if financialMember(companyId)
                  && shapeValid()
                  && targetValid()
                  && request.resource.data.status == 'draft'
                  && request.resource.data.createdBy == request.auth.uid
                  && request.resource.data.createdAt == request.time
                  && updateStamped()
                  // Lifecycle stamps cannot be forged at creation.
                  && request.resource.data.postedAt == null
                  && request.resource.data.postedBy == null
                  && request.resource.data.voidedAt == null
                  && request.resource.data.voidedBy == null;

      allow update: if financialMember(companyId) && corePreserved() && updateStamped() && (
                    // (a) DRAFT EDIT — the money, date, reason and notes are
                    //     freely editable while draft (re-saving is also how a
                    //     stale cumulative snapshot is refreshed), but the
                    //     status may not move and no lifecycle stamp may be
                    //     forged.
                    (
                      resource.data.status == 'draft'
                      && request.resource.data.status == 'draft'
                      && shapeValid()
                      && targetValid()
                      && request.resource.data.postedAt == resource.data.postedAt
                      && request.resource.data.postedBy == resource.data.postedBy
                      && request.resource.data.voidedAt == resource.data.voidedAt
                      && request.resource.data.voidedBy == resource.data.voidedBy
                    )
                    ||
                    // (b) DRAFT -> POSTED. A separate operation carrying no
                    //     content change whatsoever — the amount and GST that
                    //     were reviewed are the ones committed. The target is
                    //     re-verified because posting is the point at which the
                    //     money becomes payable.
                    (
                      resource.data.status == 'draft'
                      && request.resource.data.status == 'posted'
                      && changedKeys().hasOnly(['status', 'postedAt', 'postedBy', 'updatedAt', 'updatedBy'])
                      && targetValid()
                      && request.resource.data.postedBy == request.auth.uid
                      && request.resource.data.postedAt == request.time
                    )
                    ||
                    // (c) DRAFT|POSTED -> VOID (terminal). This branch is what
                    //     makes a POSTED release immutable: voiding is the only
                    //     permitted update, and it may touch nothing else.
                    //     Voiding needs no reversal document — the released
                    //     amount is derived, so every payable balance restores
                    //     at the next render.
                    //
                    //     ⚠️ targetValid() is deliberately NOT required here. A
                    //     release whose invoice was later cancelled is exactly
                    //     the one that most needs withdrawing, and rules must
                    //     never trap it in the posted state.
                    (
                      (resource.data.status == 'draft' || resource.data.status == 'posted')
                      && request.resource.data.status == 'void'
                      && changedKeys().hasOnly(['status', 'voidedAt', 'voidedBy', 'voidReason', 'updatedAt', 'updatedBy'])
                      && request.resource.data.voidedBy == request.auth.uid
                      && request.resource.data.voidedAt == request.time
                      && request.resource.data.voidReason is string
                      && request.resource.data.voidReason.trim().size() > 0
                    )
                  );

      allow delete: if false;
    }

    // ── Drawings — a MASTER is the stable identity of a sheet; its `revisions`
    // subcollection holds the immutable issues; the master points at the current one.
    match /companies/{companyId}/projects/{projectId}/drawings/{drawingId} {
      function drawingWriter() {
        return sameCompany(companyId)
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['company_admin', 'project_manager'];
      }
      function masterCorePreserved() {
        return request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.revisionSchemaVersion == resource.data.revisionSchemaVersion;
      }
      // Authored identity, validated identically at create and at edit.
      function identityShape() {
        return request.resource.data.drawingNumber is string
            && request.resource.data.drawingNumber.trim().size() > 0
            && request.resource.data.drawingNumber.size() <= 60
            && request.resource.data.title is string
            && request.resource.data.title.trim().size() > 0
            && request.resource.data.title.size() <= 200
            && request.resource.data.discipline in ['architectural', 'structural', 'civil', 'mechanical', 'electrical', 'hydraulic', 'landscape', 'other']
            && request.resource.data.description is string
            && request.resource.data.description.size() <= 2000;
      }

      allow read: if sameCompany(companyId);

      allow create: if drawingWriter()
                  && identityShape()
                  && request.resource.data.status == 'active'
                  // Born empty — the first revision is promoted afterwards.
                  && request.resource.data.currentRevisionId == null
                  && request.resource.data.currentRevisionCode == ''
                  && request.resource.data.currentRevisionIssuedDate == null
                  && request.resource.data.revisionCount == 0
                  && request.resource.data.revisionSchemaVersion == 1
                  && request.resource.data.withdrawnAt == null
                  && request.resource.data.withdrawnBy == null
                  && request.resource.data.withdrawReason == ''
                  && request.resource.data.createdBy == request.auth.uid
                  && request.resource.data.createdAt == request.time
                  && updateStamped();

      allow update: if drawingWriter() && masterCorePreserved() && updateStamped() && (
                    // (a) IDENTITY EDIT — number/title/discipline/description.
                    //     The pointer, the count, and the status stay put.
                    (
                      resource.data.status == 'active'
                      && changedKeys().hasOnly(['drawingNumber', 'title', 'discipline', 'description', 'updatedAt', 'updatedBy'])
                      && identityShape()
                    )
                    ||
                    // (b) PROMOTION — a newly issued revision becomes current.
                    //     revisionCount moves by EXACTLY +1, which is what makes
                    //     revisionSequence dense and monotonic.
                    (
                      resource.data.status == 'active'
                      && changedKeys().hasOnly(['currentRevisionId', 'currentRevisionCode', 'currentRevisionIssuedDate', 'revisionCount', 'updatedAt', 'updatedBy'])
                      && request.resource.data.revisionCount == resource.data.revisionCount + 1
                      && request.resource.data.currentRevisionId is string
                      && request.resource.data.currentRevisionId.size() > 0
                      && request.resource.data.currentRevisionCode is string
                      && request.resource.data.currentRevisionCode.size() > 0
                      && request.resource.data.currentRevisionIssuedDate is string
                      && request.resource.data.currentRevisionIssuedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    )
                    ||
                    // (c) REINSTATEMENT — the current revision is being
                    //     withdrawn and the user EXPLICITLY nominated an earlier
                    //     one. The pointer must actually move, and the count
                    //     must not: reinstating is not issuing.
                    //
                    //     There must ALREADY be a current revision. Without this
                    //     an empty master could have its pointer set with no
                    //     matching count increment, which would break the
                    //     "revisionCount is the sequence high-water mark"
                    //     invariant that revisionSequence is derived from.
                    (
                      resource.data.status == 'active'
                      && resource.data.currentRevisionId != null
                      && changedKeys().hasOnly(['currentRevisionId', 'currentRevisionCode', 'currentRevisionIssuedDate', 'updatedAt', 'updatedBy'])
                      && request.resource.data.currentRevisionId is string
                      && request.resource.data.currentRevisionId.size() > 0
                      && request.resource.data.currentRevisionId != resource.data.currentRevisionId
                      && request.resource.data.currentRevisionCode is string
                      && request.resource.data.currentRevisionCode.size() > 0
                      && request.resource.data.currentRevisionIssuedDate is string
                      && request.resource.data.currentRevisionIssuedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    )
                    ||
                    // (d) WITHDRAWAL (terminal) — the master is recalled and
                    //     left with NO current revision. Used both when the
                    //     current revision is withdrawn with no replacement and
                    //     when an empty master is retired.
                    (
                      resource.data.status == 'active'
                      && request.resource.data.status == 'withdrawn'
                      && changedKeys().hasOnly(['status', 'currentRevisionId', 'currentRevisionCode', 'currentRevisionIssuedDate', 'withdrawnAt', 'withdrawnBy', 'withdrawReason', 'updatedAt', 'updatedBy'])
                      && request.resource.data.currentRevisionId == null
                      && request.resource.data.currentRevisionCode == ''
                      && request.resource.data.currentRevisionIssuedDate == null
                      && request.resource.data.withdrawnBy == request.auth.uid
                      && request.resource.data.withdrawnAt == request.time
                      && request.resource.data.withdrawReason is string
                      && request.resource.data.withdrawReason.trim().size() > 0
                    )
                  );

      allow delete: if false;

      // ── Drawing revisions (immutable issues) ───────────────────────────────
      //
      // The helper functions above are in scope here: rules functions declared
      // in an outer match are visible to nested matches.
      match /revisions/{revisionId} {
        // The one storage path this revision is allowed to claim. Built from
        // the path segments, so it cannot name another tenant, another project,
        // another drawing, or a filename the caller chose.
        function expectedStoragePath() {
          return 'companies/' + companyId
               + '/projects/' + projectId
               + '/drawings/' + drawingId
               + '/' + revisionId
               + '/original.' + request.resource.data.fileExt;
        }
        // Content type and stored extension must agree — the extension is what
        // the Storage object is named, so a disagreement means the object name
        // lies about its own bytes.
        function fileShape() {
          return request.resource.data.fileName is string
              && request.resource.data.fileName.size() > 0
              && request.resource.data.fileName.size() <= 255
              && request.resource.data.fileSize is int
              && request.resource.data.fileSize > 0
              && request.resource.data.fileSize <= 52428800
              && (
                   (request.resource.data.contentType == 'application/pdf' && request.resource.data.fileExt == 'pdf')
                || (request.resource.data.contentType == 'image/png'       && request.resource.data.fileExt == 'png')
                || (request.resource.data.contentType == 'image/jpeg'      && request.resource.data.fileExt == 'jpg')
                 )
              && request.resource.data.storagePath == expectedStoragePath();
        }

        allow read: if sameCompany(companyId);

        // Every revision is born CURRENT — it is created by the promotion
        // transaction, which supersedes the previous current in the same commit.
        allow create: if drawingWriter()
                    && request.resource.data.revisionCode is string
                    && request.resource.data.revisionCode.trim().size() > 0
                    && request.resource.data.revisionCode.size() <= 12
                    && request.resource.data.revisionSequence is int
                    && request.resource.data.revisionSequence > 0
                    && request.resource.data.revisionDate is string
                    && request.resource.data.revisionDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.status == 'current'
                    && request.resource.data.notes is string
                    && request.resource.data.notes.size() <= 2000
                    && fileShape()
                    // Reserved for a future takeoff module — never authored here.
                    && request.resource.data.pageCount == null
                    && request.resource.data.sheetSize == ''
                    // No lifecycle stamp can be forged at creation.
                    && request.resource.data.supersededAt == null
                    && request.resource.data.supersededBy == null
                    && request.resource.data.supersededByRevisionId == null
                    && request.resource.data.withdrawnAt == null
                    && request.resource.data.withdrawnBy == null
                    && request.resource.data.withdrawReason == ''
                    && request.resource.data.revision == 1
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && updateStamped();

        // Each branch is `hasOnly`-restricted to its own stamps, which is what
        // makes the file identity and the authored identity IMMUTABLE.
        allow update: if drawingWriter() && updateStamped() && (
                      // (a) CURRENT -> SUPERSEDED, when a newer revision is issued.
                      (
                        resource.data.status == 'current'
                        && request.resource.data.status == 'superseded'
                        && changedKeys().hasOnly(['status', 'supersededAt', 'supersededBy', 'supersededByRevisionId', 'updatedAt', 'updatedBy'])
                        && request.resource.data.supersededBy == request.auth.uid
                        && request.resource.data.supersededAt == request.time
                        && request.resource.data.supersededByRevisionId is string
                        && request.resource.data.supersededByRevisionId.size() > 0
                        && request.resource.data.supersededByRevisionId != revisionId
                      )
                      ||
                      // (b) SUPERSEDED -> CURRENT, the explicit reinstatement
                      //     half of withdrawing a current revision. The
                      //     supersession stamps are cleared, never rewritten to
                      //     a different revision.
                      (
                        resource.data.status == 'superseded'
                        && request.resource.data.status == 'current'
                        && changedKeys().hasOnly(['status', 'supersededAt', 'supersededBy', 'supersededByRevisionId', 'updatedAt', 'updatedBy'])
                        && request.resource.data.supersededAt == null
                        && request.resource.data.supersededBy == null
                        && request.resource.data.supersededByRevisionId == null
                      )
                      ||
                      // (c) -> WITHDRAWN (terminal), from current or superseded,
                      //     with a NON-WHITESPACE reason.
                      (
                        resource.data.status in ['current', 'superseded']
                        && request.resource.data.status == 'withdrawn'
                        && changedKeys().hasOnly(['status', 'withdrawnAt', 'withdrawnBy', 'withdrawReason', 'updatedAt', 'updatedBy'])
                        && request.resource.data.withdrawnBy == request.auth.uid
                        && request.resource.data.withdrawnAt == request.time
                        && request.resource.data.withdrawReason is string
                        && request.resource.data.withdrawReason.trim().size() > 0
                      )
                    );

        allow delete: if false;
      }
    }

    // ── General Project Documents — the flat non-drawing register; a replacement
    // is a NEW record and the old one is superseded with a forward link.
    match /companies/{companyId}/projects/{projectId}/documents/{documentId} {
      // Roles that may write documents AND read `internal` ones. The two sets
      // coincide by definition: "internal" means visible to the people who
      // administer the register.
      function internalMember() {
        return sameCompany(companyId)
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['company_admin', 'project_manager', 'qs'];
      }
      function docCorePreserved() {
        return request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.revision  == resource.data.revision;
      }
      function metadataShape() {
        return request.resource.data.name is string
            && request.resource.data.name.trim().size() > 0
            && request.resource.data.name.size() <= 200
            && request.resource.data.category in ['specification', 'contract', 'subcontract', 'report', 'certificate', 'safety', 'schedule', 'manual', 'correspondence', 'other']
            && request.resource.data.visibility in ['project', 'internal']
            && request.resource.data.versionLabel is string
            && request.resource.data.versionLabel.size() <= 40
            && (request.resource.data.documentDate == null
                || (request.resource.data.documentDate is string
                    && request.resource.data.documentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
            && request.resource.data.notes is string
            && request.resource.data.notes.size() <= 2000;
      }
      function expectedStoragePath() {
        return 'companies/' + companyId
             + '/projects/' + projectId
             + '/documents/' + documentId
             + '/original.' + request.resource.data.fileExt;
      }
      function fileShape() {
        return request.resource.data.fileName is string
            && request.resource.data.fileName.size() > 0
            && request.resource.data.fileName.size() <= 255
            && request.resource.data.fileSize is int
            && request.resource.data.fileSize > 0
            && request.resource.data.fileSize <= 26214400
            && (
                 (request.resource.data.contentType == 'application/pdf' && request.resource.data.fileExt == 'pdf')
              || (request.resource.data.contentType == 'image/png'       && request.resource.data.fileExt == 'png')
              || (request.resource.data.contentType == 'image/jpeg'      && request.resource.data.fileExt == 'jpg')
               )
            && request.resource.data.storagePath == expectedStoragePath();
      }

      allow read: if internalMember()
                  || (sameCompany(companyId) && resource.data.visibility == 'project');

      allow create: if internalMember()
                  && metadataShape()
                  && fileShape()
                  && request.resource.data.status == 'active'
                  && request.resource.data.supersededByDocumentId == null
                  && request.resource.data.withdrawnAt == null
                  && request.resource.data.withdrawnBy == null
                  && request.resource.data.withdrawReason == ''
                  && request.resource.data.revision == 1
                  && request.resource.data.createdBy == request.auth.uid
                  && request.resource.data.createdAt == request.time
                  && updateStamped();

      allow update: if internalMember() && docCorePreserved() && updateStamped() && (
                    // (a) METADATA EDIT — the file is never re-pointed.
                    (
                      resource.data.status == 'active'
                      && changedKeys().hasOnly(['name', 'category', 'visibility', 'versionLabel', 'documentDate', 'notes', 'updatedAt', 'updatedBy'])
                      && metadataShape()
                    )
                    ||
                    // (b) ACTIVE -> SUPERSEDED, linking forward to the record
                    //     that replaces it. Both files are preserved.
                    (
                      resource.data.status == 'active'
                      && request.resource.data.status == 'superseded'
                      && changedKeys().hasOnly(['status', 'supersededByDocumentId', 'updatedAt', 'updatedBy'])
                      && request.resource.data.supersededByDocumentId is string
                      && request.resource.data.supersededByDocumentId.size() > 0
                      && request.resource.data.supersededByDocumentId != documentId
                    )
                    ||
                    // (c) -> WITHDRAWN (terminal), with a NON-WHITESPACE reason.
                    (
                      resource.data.status in ['active', 'superseded']
                      && request.resource.data.status == 'withdrawn'
                      && changedKeys().hasOnly(['status', 'withdrawnAt', 'withdrawnBy', 'withdrawReason', 'updatedAt', 'updatedBy'])
                      && request.resource.data.withdrawnBy == request.auth.uid
                      && request.resource.data.withdrawnAt == request.time
                      && request.resource.data.withdrawReason is string
                      && request.resource.data.withdrawReason.trim().size() > 0
                    )
                  );

      allow delete: if false;
    }

    // RFIs — Requests for Information (ADR-33): who asked what, of whom, against
    // which drawing revision or document, when due, and the answer.
    match /companies/{companyId}/projects/{projectId}/rfis/{rfiId} {
      // One audience for reads and writes.
      function rfiMember() {
        return sameCompany(companyId) && memberRole() in ['company_admin', 'project_manager', 'qs'];
      }
      function corePreserved() {
        return request.resource.data.rfiNumber == resource.data.rfiNumber
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.revision  == resource.data.revision;
      }
      // ⚠️ EXPRESSION BUDGET. Firestore evaluates at most 1000 expressions per
      // request, and this block validates ~34 fields plus two existence
      // lookups. Every shape helper therefore takes the candidate map `d`
      // ONCE as an argument instead of re-resolving `request.resource.data`
      // per field, and the exact-key check is `hasAll` + `size()` rather than
      // a second full list. Do not "tidy" these back into the longer form.
      //
      // EXACT shape — hasAll + size together mean no field may be added,
      // renamed, or omitted (the ADR-27 lesson).
      function exactKeys(d) {
        return d.keys().hasAll([
                 'rfiNumber', 'status',
                 'title', 'question', 'raisedDate', 'raisedByName',
                 'referenceType', 'referenceDrawingId', 'referenceRevisionId', 'referenceDocumentId',
                 'referenceLabel', 'referenceRevisionCode',
                 'costCodeId', 'costCodeName',
                 'assignedToContactId', 'assignedToName', 'dueDate',
                 'raisedAt', 'raisedBy',
                 'answer', 'answerDate', 'answeredAt', 'answeredBy',
                 'closeOutNote', 'closedAt', 'closedBy',
                 'cancelReason', 'cancelledAt', 'cancelledBy',
                 'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
               ])
            && d.size() == 34;
      }
      function nonBlank(v, max) {
        return v is string && v.trim().size() > 0 && v.size() <= max;
      }
      // The reference — shape AND existence.
      function referenceValid(d) {
        return (
                 d.referenceType == 'none'
                 && d.referenceDrawingId == null
                 && d.referenceRevisionId == null
                 && d.referenceDocumentId == null
                 && d.referenceLabel == ''
                 && d.referenceRevisionCode == ''
               )
            || (
                 d.referenceType == 'drawing'
                 && d.referenceDrawingId is string
                 && d.referenceDrawingId.size() > 0
                 && d.referenceRevisionId is string
                 && d.referenceRevisionId.size() > 0
                 && d.referenceDocumentId == null
                 && nonBlank(d.referenceLabel, 200)
                 && nonBlank(d.referenceRevisionCode, 40)
                 && exists(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/drawings/$(d.referenceDrawingId))
                 && exists(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/drawings/$(d.referenceDrawingId)/revisions/$(d.referenceRevisionId))
               )
            || (
                 d.referenceType == 'document'
                 && d.referenceDocumentId is string
                 && d.referenceDocumentId.size() > 0
                 && d.referenceDrawingId == null
                 && d.referenceRevisionId == null
                 && nonBlank(d.referenceLabel, 200)
                 && d.referenceRevisionCode == ''
                 && exists(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/documents/$(d.referenceDocumentId))
               );
      }
      // The question block — validated at create and at draft edit.
      function questionShape(d) {
        return nonBlank(d.title, 200)
            && nonBlank(d.question, 5000)
            && isIsoDate(d.raisedDate)
            && nonBlank(d.raisedByName, 120)
            && referenceValid(d)
            // Cost-code spine: both-or-neither.
            && ((d.costCodeId == null && d.costCodeName == '')
                || (d.costCodeId is string && d.costCodeId.size() > 0
                    && nonBlank(d.costCodeName, 120)));
      }
      // The management block — assignee (a CONTACT, never a user — ADR-27)
      // with a frozen name snapshot, both-or-neither; optional due date not
      // before the raised date.
      function managementShape(d) {
        return ((d.assignedToContactId == null && d.assignedToName == '')
                || (d.assignedToContactId is string && d.assignedToContactId.size() > 0
                    && nonBlank(d.assignedToName, 120)))
            && (d.dueDate == null
                || (isIsoDate(d.dueDate) && d.dueDate >= d.raisedDate));
      }
      // Every lifecycle stamp empty — required at create. Preserved through
      // the draft phase by the draft-edit allow-list, which cannot touch them.
      function noLifecycleStamps(d) {
        return d.raisedAt == null && d.raisedBy == null
            && d.answer == '' && d.answerDate == null
            && d.answeredAt == null && d.answeredBy == null
            && d.closeOutNote == '' && d.closedAt == null && d.closedBy == null
            && d.cancelReason == '' && d.cancelledAt == null && d.cancelledBy == null;
      }
      // Raise gate — AND the standing invariant of every OPEN RFI: a real
      // assignee and a real due date. Checked at raise and re-checked on
      // every open management edit, so they can be changed but never cleared.
      function raiseReady(d) {
        return d.assignedToContactId is string
            && d.assignedToContactId.size() > 0
            && nonBlank(d.assignedToName, 120)
            && isIsoDate(d.dueDate);
      }

      allow read: if rfiMember();

      allow create: if rfiMember()
                  && exactKeys(request.resource.data)
                  && request.resource.data.revision == 1
                  && request.resource.data.status == 'draft'
                  && request.resource.data.rfiNumber is string
                  && request.resource.data.rfiNumber.matches('^RFI-[0-9]{4,}$')
                  && questionShape(request.resource.data)
                  && managementShape(request.resource.data)
                  && noLifecycleStamps(request.resource.data)
                  && request.resource.data.createdBy == request.auth.uid
                  && request.resource.data.createdAt == request.time
                  && updateStamped();

      allow update: if rfiMember() && corePreserved() && updateStamped() && (
                    // (a) DRAFT EDIT — the question block, the reference, the
                    //     cost code, the assignee and the due date are all
                    //     editable. The hasOnly allow-list is what keeps the
                    //     status, the number and every lifecycle stamp fixed
                    //     (they were validated null/empty at create), so no
                    //     stamp can be forged and no key can be added.
                    (
                      resource.data.status == 'draft'
                      && changedKeys().hasOnly([
                           'title', 'question', 'raisedDate', 'raisedByName',
                           'referenceType', 'referenceDrawingId', 'referenceRevisionId', 'referenceDocumentId',
                           'referenceLabel', 'referenceRevisionCode',
                           'costCodeId', 'costCodeName',
                           'assignedToContactId', 'assignedToName', 'dueDate',
                           'updatedAt', 'updatedBy'
                         ])
                      && questionShape(request.resource.data)
                      && managementShape(request.resource.data)
                    )
                    ||
                    // (b) RAISE — draft → open. Needs an assignee and a due
                    //     date ALREADY on the stored draft. Touches only the
                    //     status and the raise stamps, so the question block
                    //     freezes by construction.
                    (
                      resource.data.status == 'draft'
                      && request.resource.data.status == 'open'
                      && changedKeys().hasOnly(['status', 'raisedAt', 'raisedBy', 'updatedAt', 'updatedBy'])
                      && raiseReady(request.resource.data)
                      && request.resource.data.raisedBy == request.auth.uid
                      && request.resource.data.raisedAt == request.time
                    )
                    ||
                    // (c) OPEN MANAGEMENT EDIT — assignee and due date ONLY.
                    //     Everything else is frozen by the hasOnly. Reassign
                    //     and re-date are allowed; CLEARING either is not —
                    //     raiseReady() keeps the open-state invariant.
                    (
                      resource.data.status == 'open'
                      && changedKeys().hasOnly(['assignedToContactId', 'assignedToName', 'dueDate', 'updatedAt', 'updatedBy'])
                      && managementShape(request.resource.data)
                      && raiseReady(request.resource.data)
                    )
                    ||
                    // (d) ANSWER — open → answered. Non-whitespace answer,
                    //     authored answerDate >= raisedDate, stamps only.
                    (
                      resource.data.status == 'open'
                      && request.resource.data.status == 'answered'
                      && changedKeys().hasOnly(['status', 'answer', 'answerDate', 'answeredAt', 'answeredBy', 'updatedAt', 'updatedBy'])
                      && nonBlank(request.resource.data.answer, 5000)
                      && isIsoDate(request.resource.data.answerDate)
                      && request.resource.data.answerDate >= resource.data.raisedDate
                      && request.resource.data.answeredBy == request.auth.uid
                      && request.resource.data.answeredAt == request.time
                    )
                    ||
                    // (e) CLOSE — answered → closed (terminal). Optional
                    //     close-out note; stamps only.
                    (
                      resource.data.status == 'answered'
                      && request.resource.data.status == 'closed'
                      && changedKeys().hasOnly(['status', 'closeOutNote', 'closedAt', 'closedBy', 'updatedAt', 'updatedBy'])
                      && request.resource.data.closeOutNote is string
                      && request.resource.data.closeOutNote.size() <= 1000
                      && request.resource.data.closedBy == request.auth.uid
                      && request.resource.data.closedAt == request.time
                    )
                    ||
                    // (f) CANCEL — draft/open → cancelled (terminal). NOT from
                    //     answered. Non-whitespace reason; stamps only.
                    (
                      resource.data.status in ['draft', 'open']
                      && request.resource.data.status == 'cancelled'
                      && changedKeys().hasOnly(['status', 'cancelReason', 'cancelledAt', 'cancelledBy', 'updatedAt', 'updatedBy'])
                      && nonBlank(request.resource.data.cancelReason, 500)
                      && request.resource.data.cancelledBy == request.auth.uid
                      && request.resource.data.cancelledAt == request.time
                    )
                  );

      allow delete: if false;
    }

    // PULSE™ acknowledgements — ONE management record per indicator (ADR-49), keyed
    // by the indicator id: a note, a REQUIRED review-by date and the evidence keys.
    match /companies/{companyId}/projects/{projectId}/pulseAcknowledgements/{indicatorId} {
      // Read audience — the PULSE tab's roles, includes qs.
      function pulseReader() {
        return sameCompany(companyId) && memberRole() in ['company_admin', 'project_manager', 'qs'];
      }
      // Write audience — deliberately EXCLUDES qs.
      function pulseWriter() {
        return sameCompany(companyId) && memberRole() in ['company_admin', 'project_manager'];
      }
      function corePreserved() {
        return request.resource.data.indicatorId == resource.data.indicatorId
            && request.resource.data.createdAt   == resource.data.createdAt
            && request.resource.data.createdBy   == resource.data.createdBy;
      }
      // Every update carries exactly the next revision.
      function nextRevision() {
        return request.resource.data.revision is int
            && request.resource.data.revision == resource.data.revision + 1;
      }
      // EXACT shape — hasOnly + hasAll together mean no field may be added,
      // renamed, or omitted (the ADR-27 lesson).
      function exactKeys() {
        return request.resource.data.keys().hasOnly([
                 'indicatorId', 'status', 'evidenceKeys', 'note', 'reviewBy',
                 'acknowledgedAt', 'acknowledgedBy', 'withdrawnAt', 'withdrawnBy',
                 'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
               ])
            && request.resource.data.keys().hasAll([
                 'indicatorId', 'status', 'evidenceKeys', 'note', 'reviewBy',
                 'acknowledgedAt', 'acknowledgedBy', 'withdrawnAt', 'withdrawnBy',
                 'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
               ]);
      }
      // The six PULSE 1A indicator ids (lib/pulse.js → INDICATOR) — the
      // document id AND the stored field, which must agree.
      function indicatorValid() {
        return indicatorId in [
                 'forecastOverBudget', 'forecastIncomplete', 'negativeGrossProfit',
                 'overdueActivities', 'pastDueSupplierInvoices', 'pendingVariationExposure'
               ]
            && request.resource.data.indicatorId == indicatorId;
      }
      // The content of an ACTIVE acknowledgement — required at create and at
      // every re-acknowledgement. Element types and truthfulness of
      // evidenceKeys are NOT checkable here.
      function activeShape() {
        return exactKeys()
            && indicatorValid()
            && request.resource.data.status == 'active'
            && request.resource.data.evidenceKeys is list
            && request.resource.data.evidenceKeys.size() <= 200
            && request.resource.data.note is string
            && request.resource.data.note.trim().size() > 0
            && request.resource.data.note.size() <= 500
            && isIsoDate(request.resource.data.reviewBy)
            && request.resource.data.acknowledgedBy == request.auth.uid
            && request.resource.data.acknowledgedAt == request.time
            && request.resource.data.withdrawnAt == null
            && request.resource.data.withdrawnBy == null;
      }

      allow read: if pulseReader();

      allow create: if pulseWriter()
                  && activeShape()
                  && request.resource.data.revision == 1
                  && request.resource.data.createdBy == request.auth.uid
                  && request.resource.data.createdAt == request.time
                  && updateStamped();

      allow update: if pulseWriter() && corePreserved() && updateStamped() && nextRevision() && (
                    // (a) RE-ACKNOWLEDGE — from active OR withdrawn. A fresh
                    //     statement with fresh stamps; the previous one is
                    //     replaced (no history is kept — ADR-49).
                    (
                      activeShape()
                    )
                    ||
                    // (b) WITHDRAW — active → withdrawn. Stamps and status
                    //     only, so the acknowledged content stays as the
                    //     record of what was acknowledged and no edit can ride
                    //     along. withdrawn → withdrawn is excluded.
                    (
                      resource.data.status == 'active'
                      && request.resource.data.status == 'withdrawn'
                      && changedKeys().hasOnly(['status', 'withdrawnAt', 'withdrawnBy', 'revision', 'updatedAt', 'updatedBy'])
                      && request.resource.data.withdrawnBy == request.auth.uid
                      && request.resource.data.withdrawnAt == request.time
                    )
                  );

      allow delete: if false;
    }

    // ── Quant™ takeoff pages (ADR-51) — one document per (drawing, revision, page),
    // id `{drawingId}_{revisionId}_{page}` RECOMPUTED from the stored fields; holds
    // the canonical geometry and CURRENT calibration. NON-FINANCIAL.
    match /companies/{companyId}/projects/{projectId}/takeoffPages/{takeoffPageId} {
      function quantMember() {
        return sameCompany(companyId) && memberRole() in ['company_admin', 'project_manager', 'qs'];
      }
      // Every update carries exactly the next revision.
      function nextRevision() {
        return request.resource.data.revision is int
            && request.resource.data.revision == resource.data.revision + 1;
      }
      // EXACT shape — hasOnly + hasAll (the ADR-27 lesson).
      function exactKeys(d) {
        return d.keys().hasOnly([
                 'drawingId', 'revisionId', 'page', 'source', 'pageWidth', 'pageHeight', 'pageRotation',
                 'calibration', 'calibrationRevision', 'calibratedAt', 'calibratedBy',
                 'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
               ])
            && d.keys().hasAll([
                 'drawingId', 'revisionId', 'page', 'source', 'pageWidth', 'pageHeight', 'pageRotation',
                 'calibration', 'calibrationRevision', 'calibratedAt', 'calibratedBy',
                 'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
               ]);
      }
      // The document id IS the sheet identity.
      function identityValid(d) {
        return d.drawingId is string && d.drawingId.size() > 0
            && d.revisionId is string && d.revisionId.size() > 0
            && d.page is int && d.page >= 1
            && takeoffPageId == d.drawingId + '_' + d.revisionId + '_' + string(d.page);
      }
      // The referenced drawing and revision must exist and NEITHER may be
      // withdrawn — nothing is ever measured, or re-calibrated, on a recalled
      // sheet. Evaluated on the INCOMING document at create and on the STORED
      // identity at update (identity is immutable, so they are the same sheet).
      // Reads are deliberately NOT gated on this: a withdrawn sheet's takeoff
      // stays inspectable as history.
      function sourceLive(d) {
        return exists(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/drawings/$(d.drawingId))
            && get(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/drawings/$(d.drawingId)).data.status != 'withdrawn'
            && exists(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/drawings/$(d.drawingId)/revisions/$(d.revisionId))
            && get(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/drawings/$(d.drawingId)/revisions/$(d.revisionId)).data.status != 'withdrawn';
      }
      function geometryValid(d) {
        return d.source in ['pdf', 'image']
            && d.pageWidth is number && d.pageWidth > 0
            && d.pageHeight is number && d.pageHeight > 0
            && d.pageRotation in [0, 90, 180, 270];
      }
      function pointValid(p) {
        return p is map && p.keys().hasOnly(['x', 'y']) && p.x is number && p.y is number;
      }
      function calibrationValid(c) {
        return c is map
            && c.keys().hasOnly(['pointA', 'pointB', 'pageDistance', 'realDistance', 'unit'])
            && c.keys().hasAll(['pointA', 'pointB', 'pageDistance', 'realDistance', 'unit'])
            && pointValid(c.pointA) && pointValid(c.pointB)
            && c.pageDistance is number && c.pageDistance > 0
            && c.realDistance is number && c.realDistance > 0
            && c.unit in ['mm', 'm'];
      }
      // Identity, geometry and creation stamps never move.
      function corePreserved() {
        return request.resource.data.drawingId    == resource.data.drawingId
            && request.resource.data.revisionId   == resource.data.revisionId
            && request.resource.data.page         == resource.data.page
            && request.resource.data.source       == resource.data.source
            && request.resource.data.pageWidth    == resource.data.pageWidth
            && request.resource.data.pageHeight   == resource.data.pageHeight
            && request.resource.data.pageRotation == resource.data.pageRotation
            && request.resource.data.createdAt    == resource.data.createdAt
            && request.resource.data.createdBy    == resource.data.createdBy;
      }

      allow read: if quantMember();

      allow create: if quantMember()
                  && exactKeys(request.resource.data)
                  && identityValid(request.resource.data)
                  && sourceLive(request.resource.data)
                  && geometryValid(request.resource.data)
                  && request.resource.data.revision == 1
                  && request.resource.data.createdBy == request.auth.uid
                  && request.resource.data.createdAt == request.time
                  && updateStamped()
                  && (
                       // (a) UNCALIBRATED BIRTH — made before the first count
                       //     on a page nobody has calibrated.
                       (
                         request.resource.data.calibration == null
                         && request.resource.data.calibrationRevision == 0
                         && request.resource.data.calibratedAt == null
                         && request.resource.data.calibratedBy == null
                       )
                       ||
                       // (b) FIRST CALIBRATION.
                       (
                         calibrationValid(request.resource.data.calibration)
                         && request.resource.data.calibrationRevision == 1
                         && request.resource.data.calibratedBy == request.auth.uid
                         && request.resource.data.calibratedAt == request.time
                       )
                     );

      // The ONLY update is a (re-)calibration: the calibration moves, its
      // revision moves by exactly +1, and nothing else may ride along. A sheet
      // whose revision or drawing has since been withdrawn can no longer be
      // re-calibrated — its measurements are history, not a live takeoff.
      allow update: if quantMember()
                  && exactKeys(request.resource.data)
                  && corePreserved()
                  && sourceLive(resource.data)
                  && updateStamped()
                  && nextRevision()
                  && changedKeys().hasOnly(['calibration', 'calibrationRevision', 'calibratedAt', 'calibratedBy', 'revision', 'updatedAt', 'updatedBy'])
                  && calibrationValid(request.resource.data.calibration)
                  && request.resource.data.calibrationRevision == resource.data.calibrationRevision + 1
                  && request.resource.data.calibratedBy == request.auth.uid
                  && request.resource.data.calibratedAt == request.time;

      allow delete: if false;
    }

    // ── Quant™ takeoff measurements (ADR-51) — a length, area or count in the
    // canonical coordinates of one page; the quantity is NEVER stored (derived
    // from `points` and the calibration SNAPSHOT). NON-FINANCIAL; BOQ link ADR-52.
    match /companies/{companyId}/projects/{projectId}/takeoffMeasurements/{measurementId} {
      function quantMember() {
        return sameCompany(companyId) && memberRole() in ['company_admin', 'project_manager', 'qs'];
      }
      // Every update carries exactly the next revision.
      function nextRevision() {
        return request.resource.data.revision is int
            && request.resource.data.revision == resource.data.revision + 1;
      }
      // `boqItemId` (ADR-52) is OPTIONAL: present on every Quant 1B write
      // (null or an id), absent on Quant 1A documents, which stay valid.
      // `deductions` (ADR-54) is OPTIONAL: an AREA's holes, written only once
      // the first deduction exists; absent on every earlier document.
      function exactKeys(d) {
        return d.keys().hasOnly([
                 'takeoffPageId', 'drawingId', 'revisionId', 'page', 'kind', 'points', 'label',
                 'costCodeId', 'costCodeName', 'calibration', 'boqItemId', 'deductions',
                 'status', 'voidReason', 'voidedAt', 'voidedBy',
                 'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
               ])
            && d.keys().hasAll([
                 'takeoffPageId', 'drawingId', 'revisionId', 'page', 'kind', 'points', 'label',
                 'costCodeId', 'costCodeName', 'calibration',
                 'status', 'voidReason', 'voidedAt', 'voidedBy',
                 'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
               ]);
      }
      // The BOQ link (ADR-52): absent or null, or an id naming an item IN THIS
      // PROJECT that exists, is active and shares the measurement's cost code.
      // Unit compatibility and the aggregate are client-only (DC33).
      function linkValid(d) {
        return !('boqItemId' in d)
            || d.boqItemId == null
            || (
                 d.boqItemId is string && d.boqItemId.size() > 0 && d.boqItemId.size() <= 128
                 && exists(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/boqItems/$(d.boqItemId))
                 && get(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/boqItems/$(d.boqItemId)).data.status == 'active'
                 && get(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/boqItems/$(d.boqItemId)).data.costCodeId == d.costCodeId
               );
      }
      // The drawing and revision exist and NEITHER is withdrawn. Checked on the
      // incoming document at create and on the STORED identity for an active
      // edit; never for a read or a void.
      function sourceLive(d) {
        return exists(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/drawings/$(d.drawingId))
            && get(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/drawings/$(d.drawingId)).data.status != 'withdrawn'
            && exists(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/drawings/$(d.drawingId)/revisions/$(d.revisionId))
            && get(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/drawings/$(d.drawingId)/revisions/$(d.revisionId)).data.status != 'withdrawn';
      }
      // The sheet identity: consistent with the page id, every referenced
      // document real and the sheet live. The page must ALREADY exist (exists()
      // sees committed state), which is why the app creates a page in its own
      // commit first.
      function sourceValid(d) {
        return d.drawingId is string && d.drawingId.size() > 0
            && d.revisionId is string && d.revisionId.size() > 0
            && d.page is int && d.page >= 1
            && d.takeoffPageId == d.drawingId + '_' + d.revisionId + '_' + string(d.page)
            && exists(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/takeoffPages/$(d.takeoffPageId))
            && sourceLive(d);
      }
      function snapshotValid(c) {
        return c is map
            && c.keys().hasOnly(['revision', 'pageDistance', 'realDistance', 'unit'])
            && c.keys().hasAll(['revision', 'pageDistance', 'realDistance', 'unit'])
            && c.revision is int && c.revision >= 1
            && c.pageDistance is number && c.pageDistance > 0
            && c.realDistance is number && c.realDistance > 0
            && c.unit in ['mm', 'm'];
      }
      // Deductions (ADR-54): absent, or a bounded LIST on an AREA. Element
      // content (shape, simplicity, containment, overlap, net > 0) is
      // client-only — rules cannot iterate a list (DC32).
      function deductionsValid(d) {
        return !('deductions' in d)
            || (d.kind == 'area' && d.deductions is list && d.deductions.size() <= 50);
      }
      // The editable content, validated identically at create and at edit.
      function contentValid(d) {
        return d.kind in ['length', 'area', 'count']
            && deductionsValid(d)
            && d.points is list
            && d.points.size() <= 500
            && (
                 (d.kind == 'length' && d.points.size() >= 2)
              || (d.kind == 'area'   && d.points.size() >= 3)
              || (d.kind == 'count'  && d.points.size() >= 1)
               )
            && d.label is string && d.label.trim().size() > 0 && d.label.size() <= 120
            && d.costCodeId is string && d.costCodeId.size() > 0
            && exists(/databases/$(database)/documents/companies/$(companyId)/costCodes/$(d.costCodeId))
            && d.costCodeName is string && d.costCodeName.trim().size() > 0 && d.costCodeName.size() <= 200
            && (
                 (d.kind == 'count' && d.calibration == null)
              || (d.kind != 'count' && snapshotValid(d.calibration))
               );
      }
      function corePreserved() {
        return request.resource.data.takeoffPageId == resource.data.takeoffPageId
            && request.resource.data.drawingId     == resource.data.drawingId
            && request.resource.data.revisionId    == resource.data.revisionId
            && request.resource.data.page          == resource.data.page
            && request.resource.data.kind          == resource.data.kind
            && request.resource.data.createdAt     == resource.data.createdAt
            && request.resource.data.createdBy     == resource.data.createdBy;
      }

      allow read: if quantMember();

      allow create: if quantMember()
                  && exactKeys(request.resource.data)
                  && sourceValid(request.resource.data)
                  && contentValid(request.resource.data)
                  && linkValid(request.resource.data)
                  && request.resource.data.status == 'active'
                  && request.resource.data.voidReason == ''
                  && request.resource.data.voidedAt == null
                  && request.resource.data.voidedBy == null
                  && request.resource.data.revision == 1
                  && request.resource.data.createdBy == request.auth.uid
                  && request.resource.data.createdAt == request.time
                  && updateStamped();

      allow update: if quantMember()
                  && exactKeys(request.resource.data)
                  && corePreserved()
                  && updateStamped()
                  && nextRevision()
                  && (
                    // (a) ACTIVE EDIT — geometry, label, cost code, the
                    //     calibration snapshot and the BOQ link may change; the
                    //     status may not, no void stamp may be forged, and the
                    //     sheet must still be LIVE (revision and drawing not
                    //     withdrawn). The link target is re-verified whenever
                    //     the link OR the cost code moves — a label edit on a
                    //     measurement whose item was voided later still passes.
                    (
                      resource.data.status == 'active'
                      && request.resource.data.status == 'active'
                      && changedKeys().hasOnly(['points', 'label', 'costCodeId', 'costCodeName', 'calibration', 'boqItemId', 'deductions', 'revision', 'updatedAt', 'updatedBy'])
                      && sourceLive(resource.data)
                      && contentValid(request.resource.data)
                      && (!changedKeys().hasAny(['boqItemId', 'costCodeId']) || linkValid(request.resource.data))
                    )
                    ||
                    // (b) ACTIVE → VOID (terminal, reasoned). Stamps and status
                    //     only, so a voided measurement is immutable history.
                    //     Permitted whatever the revision's status: voiding a
                    //     measurement on a withdrawn sheet is housekeeping.
                    (
                      resource.data.status == 'active'
                      && request.resource.data.status == 'void'
                      && changedKeys().hasOnly(['status', 'voidReason', 'voidedAt', 'voidedBy', 'revision', 'updatedAt', 'updatedBy'])
                      && request.resource.data.voidedBy == request.auth.uid
                      && request.resource.data.voidedAt == request.time
                      && request.resource.data.voidReason is string
                      && request.resource.data.voidReason.trim().size() > 0
                    )
                  );

      allow delete: if false;
    }

    // Project counters — PER-PROJECT sequential numbering (today only `rfis`);
    // financial counters stay company-wide. Same audience and tenant gate as the
    // company counters; +1-only integrity is NOT enforced (DC6 / DC27). Delete blocked.
    match /companies/{companyId}/projects/{projectId}/counters/{counterId} {
      allow read, create, update: if request.auth != null
                  && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['company_admin', 'project_manager', 'qs'];
      allow delete: if false;
    }

    // Contacts — the company directory (third-party PII). Financial roles read and
    // write; delete blocked (archive via isActive: false).
    match /companies/{companyId}/contacts/{contactId} {
      allow read, create, update: if request.auth != null
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['company_admin', 'project_manager', 'qs'];
      allow delete: if false;
    }

    // Counters — COMPANY-WIDE sequential document numbering for every financial
    // collection (RFIs use the per-project block above). Read / write restricted
    // to the roles that create numbered documents; +1-only integrity is NOT
    // enforced (DC6).
    match /companies/{companyId}/counters/{counterId} {
      allow read, create, update: if request.auth != null
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['company_admin', 'project_manager', 'qs'];
      allow delete: if false;
    }
  }
}
