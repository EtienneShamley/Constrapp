# Production project (constrapp-69b5d). NON-SECRET deployment parameters.
# Fill BOTH before the first Functions deploy (docs/DEPLOYMENT.md → L1):
#   APP_BASE_URL — the public origin invitation links point at
#   EMAIL_FROM   — a sender on a domain verified in Resend
# Left EMPTY on purpose: an unconfigured deployment refuses to send invitations
# rather than sending a broken link from a placeholder sender.
#
# Planned Constrap values — set them ONLY once BOTH preconditions hold
# (docs/DEPLOYMENT.md → Custom domain — app.constrap.com):
#   1. app.constrap.com is connected to Firebase Hosting and serves the app;
#   2. constrap.com is a verified sending domain in Resend.
#     APP_BASE_URL=https://app.constrap.com
#     EMAIL_FROM=Constrap <invites@constrap.com>
APP_BASE_URL=https://app.constrap.com
EMAIL_FROM="Constrap <invites@constrap.com>"
TEAM_MANAGEMENT_ENABLED=true
# ADR-74 (DC46-B) — legacy download-token revocation worker.
#   FILE_LINK_REVOCATION_ENABLED=false pauses the WORKER only; membership
#   changes still queue their requests (docs/DEPLOYMENT.md → DC46-B).
#   STORAGE_BUCKET is EMPTY on purpose: the worker uses the project's default
#   bucket. It must still be PRESENT — a non-interactive deploy refuses any
#   parameter without a dotenv value, defaults included (found in Stage 0).
FILE_LINK_REVOCATION_ENABLED=true
STORAGE_BUCKET=
# ADR-75 (DC46-C) — periodic reconciliation. 0 = OFF. Do NOT raise it in
# production without explicit authorisation (docs/DEPLOYMENT.md → DC46-C).
FILE_LINK_RECONCILE_INTERVAL_HOURS=0
#   The worker runs as its OWN account, which must exist before the deploy
#   (docs/DEPLOYMENT.md → DC46-B → dedicated worker account).
FILE_LINK_WORKER_SERVICE_ACCOUNT=file-link-worker@constrapp-69b5d.iam.gserviceaccount.com
