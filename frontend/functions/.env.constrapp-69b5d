# Production project (constrapp-69b5d). NON-SECRET deployment parameters.
# Fill BOTH before the first Functions deploy (docs/DEPLOYMENT.md → L1):
#   APP_BASE_URL — the public origin invitation links point at
#   EMAIL_FROM   — a sender on a domain verified in Resend
# Left EMPTY on purpose: an unconfigured deployment refuses to send invitations
# rather than sending a broken link from a placeholder sender.
#
# Planned Constrap values — set them ONLY once BOTH preconditions hold
# (docs/DEPLOYMENT.md → Custom domain — app.constrap.com):
#   1. app.constrap.com is connected to Firebase Hosting and serves the app;
#   2. constrap.com is a verified sending domain in Resend.
#     APP_BASE_URL=https://app.constrap.com
#     EMAIL_FROM=Constrap <invites@constrap.com>
APP_BASE_URL=https://app.constrap.com
EMAIL_FROM="Constrap <invites@constrap.com>"
TEAM_MANAGEMENT_ENABLED=true
# ADR-74 (DC46-B) — legacy download-token revocation worker.
#   FILE_LINK_REVOCATION_ENABLED=false pauses the WORKER only; membership
#   changes still queue their requests (docs/DEPLOYMENT.md → DC46-B).
#   STORAGE_BUCKET is EMPTY on purpose: the worker uses the project's default
#   bucket. It must still be PRESENT — a non-interactive deploy refuses any
#   parameter without a dotenv value, defaults included (found in Stage 0).
FILE_LINK_REVOCATION_ENABLED=true
STORAGE_BUCKET=
# ADR-75 (DC46-C) — periodic reconciliation. 0 = OFF. Do NOT raise it in
# production without explicit authorisation (docs/DEPLOYMENT.md → DC46-C).
FILE_LINK_RECONCILE_INTERVAL_HOURS=2
#   The worker runs as its OWN account, which must exist before the deploy
#   (docs/DEPLOYMENT.md → DC46-B → dedicated worker account).
FILE_LINK_WORKER_SERVICE_ACCOUNT=file-link-worker@constrapp-69b5d.iam.gserviceaccount.com
# ADR-77 (L2-B) — the approveFinalAccount callable. `true` = approvals allowed.
#   `false` + a redeploy of THAT function only
#   (--only functions:team:approveFinalAccount) makes it answer
#   final-account-disabled before any read. Must be PRESENT (see STORAGE_BUCKET).
FINAL_ACCOUNT_APPROVAL_ENABLED=true
# ADR-81 (L4) — the transferBoqToBudget callable. `true` = transfers allowed.
#   `false` + a redeploy of THAT function only
#   (--only functions:team:transferBoqToBudget) makes it answer
#   boq-transfer-disabled before any read. Must be PRESENT (see STORAGE_BUCKET).
BOQ_BUDGET_TRANSFER_ENABLED=true
# ADR-89 — the four client-finance callables (postClientCreditNote,
#   voidClientCreditNote, postClientRetentionRelease,
#   voidClientRetentionRelease). `true` = posting and voiding allowed.
#   CUTOVER STARTS WITH BOTH SWITCHES OFF (functions/src/lib/params.js →
#   CUTOVER ORDER): each of these answers client-finance-disabled before any
#   read or write. Turning them on is `true` + a redeploy of THOSE four
#   functions — and each company must then be activated separately
#   (scripts/set-client-finance.mjs). Must be PRESENT (see STORAGE_BUCKET).
CLIENT_FINANCE_POSTING_ENABLED=false
# ADR-89 — the two client-receipt callables (postClientReceipt,
#   voidClientReceipt). Receipts are a LIVE workflow and, once the new Rules
#   are published, can be posted only through these. OFF at the start of the
#   cutover: each answers client-receipt-disabled before any read or write.
#   Turned on (`true` + a redeploy of THOSE two functions) only after the
#   restrictive Rules and Hosting are live and verified. Must be PRESENT.
CLIENT_RECEIPT_POSTING_ENABLED=false
# ADR-89 (S6) — the SCOPE of the receipt switch. `false` = the two receipt
#   callables act only for a company the operator activated
#   (scripts/set-client-finance.mjs --receipts) — the TEST company during the
#   cutover. `true` + a redeploy of THOSE two functions = every company; set
#   only after architect acceptance of the baseline. Must be PRESENT.
CLIENT_RECEIPT_ALL_COMPANIES=false
