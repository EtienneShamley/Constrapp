rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Comments are deliberately brief: Firestore refuses a ruleset over 256 KB of
    // source (ADR-51, ADR-60, ADR-69). Rationale, enforced controls and client-only
    // gaps for every collection live in docs/SECURITY.md and docs/PROJECT_DECISIONS.md.
    // ── Shared helpers (ADR-60) — declared once, in scope in every nested match. Path
    // wildcards are not in scope here, so tenant helpers take companyId / projectId.

    // The caller's role, from their membership document.
    function memberRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    // Any provisioned member of THIS company, regardless of role.
    function sameCompany(companyId) {
      return request.auth != null
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
    }
    // The internal financial roles (ADR-56) of THIS company.
    function financialMember(companyId) {
      return request.auth != null
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['company_admin', 'project_manager', 'qs'];
    }
    // M2-A2: who may read ONE project's shared records (directory entry, drawings,
    // project documents). Internal roles: every project of their company. client /
    // subcontractor: ONLY a project listed in their server-managed users/{uid}
    // .projectIds. Every other role, and a missing / non-list assignment, is denied.
    function projectReader(companyId, projectId) {
      return sameCompany(companyId)
          && (memberRole() in ['company_admin', 'project_manager', 'qs']
              || (memberRole() in ['client', 'subcontractor']
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('projectIds', null) is list
                  && projectId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.projectIds));
    }
    // M2-A2: the external-safe directory entry of a project.
    function directoryPath(companyId, projectId) {
      return /databases/$(database)/documents/companies/$(companyId)/projectDirectory/$(projectId);
    }
    // Keys this update changes.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // Every write path stamps the caller and the server time.
    function updateStamped() {
      return request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
    }
    // MONEY IS DECIMAL; IEEE-754 IS NOT: an exact `a + b == c` on doubles rejects
    // legitimate cent values, so both sides compare as WHOLE CENTS via math.round() —
    // a representation fix (half-cent tolerance), never a weakened invariant.
    // Mirrors roundMoney() / toCents() so a client-valid write is never rejected.
    function cents(v) {
      return math.round(v * 100);
    }
    // GST (flat 10%) on a non-negative whole-cent amount, round-half-up; mirrors
    // roundMoney(x * GST_RATE) / lib/retention.js → cumulativeRetentionGst.
    // ⚠️ DO NOT "SIMPLIFY" TO math.round(c / 10): Rules integer `/` TRUNCATES
    // (10005/10 → 1000) where JS Math.round(1000.5) → 1001 — proven in the emulator.
    // floor((c + 5) / 10) is half-up under either semantics. Callers validate
    // operands >= 0 first (tests/rules/retentionReleases.rules.test.js).
    function gstCents(c) {
      return math.floor((c + 5) / 10);
    }
    // THE ONE GST PIN for a client-rounded 10% figure (ADR-57 / ADR-58; shared by
    // progressClaims, the supplierInvoices retentionGst pin and the retentionReleases
    // delta — GST boundary hotfix): roundMoney(x × 0.1) can land ONE cent below
    // half-up on a half-cent boundary (40.15 → 4.01), never above, never off a
    // boundary (swept exhaustively). `-5` covers a legacy negative net at approval.
    function gstPinned(netC, gstC) {
      return gstC == gstCents(netC)
          || ((netC % 10 == 5 || netC % 10 == -5) && gstC == gstCents(netC) - 1);
    }
    // `revision` EXACTLY +1 on every update, a missing key reading as 0 (ADR-58 /
    // ADR-59): rules-ASSISTED concurrency, not rules-proven — DC36 / DC37.
    function revisionIncremented() {
      return request.resource.data.revision is number
          && request.resource.data.revision == resource.data.get('revision', 0) + 1;
    }
    // A DATE-ONLY string, YYYY-MM-DD (string comparison is exact for zero-padded ISO).
    function isIsoDate(v) {
      return v is string
          && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }
    // Cash records (clientReceipts / supplierPayments): the one arithmetic
    // guarantee rules CAN give — a record may never claim to have allocated more
    // money than it received or paid.
    function amountInvariant() {
      return request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.allocatedTotal is number
          && request.resource.data.allocatedTotal >= 0
          && request.resource.data.unallocatedAmount is number
          && request.resource.data.unallocatedAmount >= 0
          && cents(request.resource.data.allocatedTotal + request.resource.data.unallocatedAmount)
             == cents(request.resource.data.amount);
    }
    // The calling match's project, and the PO the incoming document names.
    function projectPath(companyId, projectId) {
      return /databases/$(database)/documents/companies/$(companyId)/projects/$(projectId);
    }
    function poPath(companyId, projectId) {
      return /databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/purchaseOrders/$(request.resource.data.poId);
    }
    // lib/currency.js → resolveProjectCurrency, mirrored: project `currency`, else
    // company `baseCurrency`, else AUD. Checked at CREATE only (frozen afterwards).
    function resolvedCurrency(companyId, projectId) {
      let pc = get(projectPath(companyId, projectId)).data.get('currency', '');
      let cc = get(/databases/$(database)/documents/companies/$(companyId)).data.get('baseCurrency', '');
      return (pc is string && pc.matches('^[A-Z]{3}$')) ? pc
           : ((cc is string && cc.matches('^[A-Z]{3}$')) ? cc : 'AUD');
    }
    // SHIELD 2B1 (ADR-70): the approved-budget POINTER and a budget approval HEADER.
    function approvedBudgetPath(companyId, projectId) {
      return /databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/approvedBudget/current;
    }
    function budgetApprovalPath(companyId, projectId, id) {
      return /databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/budgetApprovals/$(id);
    }
    function budgetAdjustmentPath(companyId, projectId, id) {
      return /databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/budgetAdjustments/$(id);
    }
    // The approve audience of a budget version: company_admin / project_manager (qs prepares only).
    function budgetApprover(companyId) {
      return sameCompany(companyId) && memberRole() in ['company_admin', 'project_manager'];
    }
    // ── Approval segregation (ADR-96, Phase 2 step 6) ─────────────────────────
    // The company policy document is written only by the operator tool and the
    // trusted backend (no client write). Absent, or segregationEnabled != true,
    // means DISABLED and these helpers admit every approval as before. Enabled,
    // the approver may not be one of the document's preparers. Used by the
    // approvals that remain client writes; the trusted callables apply the same
    // policy themselves (functions/src/lib/approvalPolicy.js).
    function approvalPolicyPath(companyId) {
      return /databases/$(database)/documents/companies/$(companyId)/approvalPolicy/current;
    }
    function independentApprover(companyId, preparers) {
      return !(exists(approvalPolicyPath(companyId))
               && get(approvalPolicyPath(companyId)).data.get('segregationEnabled', false) == true)
          || !(request.auth.uid in preparers);
    }
    // D4 for client-written drafts that CAN be edited (purchase orders, tender
    // packages — D3 #46): the Rules keep `lastMaterialEditBy` / `lastMaterialEditAt`.
    // A write changing any of `material` must stamp the caller at server time; any
    // other write must leave both exactly as they were (a cosmetic edit can never
    // move them, and a missing stamp can only be established by a material edit).
    function materialStamped(material) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(material)
          ? (request.resource.data.get('lastMaterialEditBy', null) == request.auth.uid
             && request.resource.data.get('lastMaterialEditAt', null) == request.time)
          : (request.resource.data.get('lastMaterialEditBy', null) == resource.data.get('lastMaterialEditBy', null)
             && request.resource.data.get('lastMaterialEditAt', null) == resource.data.get('lastMaterialEditAt', null));
    }
    // Strict mode on such a draft: the approver is neither its creator nor its
    // last material editor; a draft whose provenance was never recorded (written
    // before the stamp existed) fails CLOSED — no historical actor is invented —
    // until a material save records its preparer.
    function independentOfStampedPreparers(companyId) {
      return !(exists(approvalPolicyPath(companyId))
               && get(approvalPolicyPath(companyId)).data.get('segregationEnabled', false) == true)
          || (resource.data.get('lastMaterialEditBy', null) is string
              && !(request.auth.uid in [resource.data.get('createdBy', null), resource.data.get('lastMaterialEditBy', null)]));
    }
    // Phase 2 company activation (ADR-98, final integration correction): the
    // client lifecycle writes that remain on Phase 2 registers (claim submit;
    // variation submit / reject / withdraw) act only for an activated company.
    // Operator-written; no client writes the marker.
    function commercialActive(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data.get('commercialCompletionEnabled', false) == true;
    }
    function stampedAtCreate() {
      return request.resource.data.get('lastMaterialEditBy', null) == request.auth.uid
          && request.resource.data.get('lastMaterialEditAt', null) == request.time;
    }
    // ── Lifecycle helpers (ADR-85) — byte-identical conjunct runs hoisted from the
    // financial blocks; `node scripts/verify-rules-helper-hoist.mjs` expands them back.
    function createStamped() {
      return request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
    }
    function currencyShaped() {
      return request.resource.data.currency is string
          && request.resource.data.currency.matches('^[A-Z]{3}$');
    }
    function docCoreFrozen() {
      return request.resource.data.currency == resource.data.currency
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.docType == resource.data.docType
          && request.resource.data.revision == resource.data.revision;
    }
    function lifecycleUnstamped() {
      return request.resource.data.postedAt == null
          && request.resource.data.postedBy == null
          && request.resource.data.voidedAt == null
          && request.resource.data.voidedBy == null;
    }
    function lifecycleStampsFrozen() {
      return request.resource.data.postedAt == resource.data.postedAt
          && request.resource.data.postedBy == resource.data.postedBy
          && request.resource.data.voidedAt == resource.data.voidedAt
          && request.resource.data.voidedBy == resource.data.voidedBy;
    }
    function postedHere() {
      return request.resource.data.status == 'posted'
          && changedKeys().hasOnly(['status', 'postedAt', 'postedBy', 'updatedAt', 'updatedBy'])
          && request.resource.data.postedBy == request.auth.uid
          && request.resource.data.postedAt == request.time;
    }
    function voidedWithReason() {
      return request.resource.data.status == 'void'
          && changedKeys().hasOnly(['status', 'voidedAt', 'voidedBy', 'voidReason', 'updatedAt', 'updatedBy'])
          && request.resource.data.voidedBy == request.auth.uid
          && request.resource.data.voidedAt == request.time
          && request.resource.data.voidReason is string
          && request.resource.data.voidReason.trim().size() > 0;
    }
    // ── Receivable helpers (ADR-86 / ADR-87 / ADR-88 / ADR-89).
    function ciPath(companyId, projectId, id) {
      return /databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/clientInvoices/$(id);
    }
    // Company-scoped activation of client credit notes and client retention: a
    // boolean only the trusted backend writes (a client's company update is held
    // to four other keys). Absent means not activated.
    function ciActive(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data.get('clientFinanceEnabled', false) == true;
    }
    function ciLedgerPath(companyId, projectId, id) {
      return /databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/clientInvoiceLedgers/$(id);
    }
    // A number carrying no fraction of a cent.
    function centExact(v) {
      return v is number && cents(v) / 100.0 == v;
    }
    // A DRAFT entry against a client invoice (credit note / retention release), as a
    // client may store it: the target is an ISSUED invoice of the same client and
    // currency. Its FIGURES are not validated here — a draft has no financial
    // effect, and the trusted backend re-derives every figure when it posts (ADR-89).
    function ciDraft(companyId, projectId, docType, numberKey) {
      let d = request.resource.data;
      let inv = get(ciPath(companyId, projectId, d.clientInvoiceId)).data;
      return d.status == 'draft'
          && ciActive(companyId)
          && d.docType == docType
          && d[numberKey] is string
          && d.revision is number
          && d.clientInvoiceId is string && d.clientInvoiceId.size() > 0
          && inv.status == 'issued'
          && inv.currency == d.currency
          && inv.get('clientId', null) == d.clientId
          && d.invoiceNumber is string
          && d.clientName is string
          && d.reason is string && d.reason.trim().size() > 0 && d.reason.size() <= 1000
          && d.notes is string
          && d.get('lineItems', []) is list && d.get('lineItems', []).size() <= 100
          && currencyShaped()
          && updateStamped();
    }
    // What a client may do to an entry: edit it while DRAFT (target and number
    // frozen) or void a DRAFT. POSTED and VOID entries admit NO client write —
    // posting, and voiding a posted entry, are trusted-backend operations.
    function ciDraftUpdate(companyId, projectId, docType, numberKey) {
      return resource.data.status == 'draft'
          && request.resource.data[numberKey] == resource.data[numberKey]
          && request.resource.data.clientInvoiceId == resource.data.clientInvoiceId
          && request.resource.data.invoiceNumber == resource.data.invoiceNumber
          && request.resource.data.clientId == resource.data.clientId
          && request.resource.data.clientName == resource.data.clientName
          && docCoreFrozen()
          && updateStamped()
          && ((ciDraft(companyId, projectId, docType, numberKey)
                && lifecycleStampsFrozen()
              ) || (
                request.resource.data.status == 'void'
                && voidedWithReason()
              ));
    }


    // Membership documents — a user may READ THEIR OWN PROFILE AND NOTHING ELSE.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // Companies — readable by members; create / delete blocked (provisioned by admin
    // tooling); company_admin may update the FOUR currency fields only, codes
    // shape-tested, not enumerated (an enum here would drift from lib/currency.js).
    match /companies/{companyId} {
      allow read: if request.auth != null
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
      allow create, delete: if false;
      allow update: if request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'company_admin'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['countryCode', 'baseCurrency', 'currencyUpdatedAt', 'currencyUpdatedBy'])
          && request.resource.data.countryCode is string
          && request.resource.data.countryCode.matches('^[A-Z]{2}$')
          && request.resource.data.baseCurrency is string
          && request.resource.data.baseCurrency.matches('^[A-Z]{3}$');
    }

    // Projects — INTERNAL roles only since M2-A2 (the document carries the headline
    // budget and currency; external roles read projectDirectory instead); create /
    // update company_admin and project_manager (plus the QS currency-lock ratchet);
    // delete blocked.
    match /companies/{companyId}/projects/{projectId} {
      // Status vocabulary mirrors lib/projects.js → PROJECT_STATUSES (short and
      // product-owned, so enumerated — unlike the shape-tested currency codes).
      function validProjectStatus(s) {
        return s in ['Planning', 'In Progress', 'Backlogged', 'On Hold', 'Completed'];
      }
      // Field is untouched by this write, or the incoming value is well-formed.
      function statusOk() {
        return request.resource.data.get('status', '') == resource.data.get('status', '')
            || validProjectStatus(request.resource.data.get('status', ''));
      }
      function nameOk() {
        return request.resource.data.get('name', '') == resource.data.get('name', '')
            || (request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() > 0
        && request.resource.data.get('name', '').size() <= 200);
      }
      function progressOk() {
        return request.resource.data.get('progress', 0) == resource.data.get('progress', 0)
            || (request.resource.data.get('progress', 0) is number
        && request.resource.data.get('progress', 0) >= 0
        && request.resource.data.get('progress', 0) <= 100);
      }
      function locationOk() {
        return request.resource.data.get('location', '') == resource.data.get('location', '')
            || (request.resource.data.get('location', '') is string
        && request.resource.data.get('location', '').size() <= 200);
      }
      function startDateOk() {
        return request.resource.data.get('startDate', null) == resource.data.get('startDate', null)
            || request.resource.data.get('startDate', null) == null
            || request.resource.data.get('startDate', null) is timestamp;
      }
      // The headline budget and the provenance stamps that NO update may move.
      function projectCorePreserved() {
        return request.resource.data.get('budget', 0) == resource.data.get('budget', 0)
            && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
            && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null);
      }
      // M2-A2: the directory entry mirrors the five display fields AFTER this commit.
      function directoryPaired() {
        return existsAfter(directoryPath(companyId, projectId))
            && getAfter(directoryPath(companyId, projectId)).data.name == request.resource.data.get('name', '')
            && getAfter(directoryPath(companyId, projectId)).data.status == request.resource.data.get('status', '')
            && getAfter(directoryPath(companyId, projectId)).data.location == request.resource.data.get('location', '')
            && getAfter(directoryPath(companyId, projectId)).data.startDate == request.resource.data.get('startDate', null)
            && getAfter(directoryPath(companyId, projectId)).data.progress == request.resource.data.get('progress', 0);
      }
      allow read: if financialMember(companyId);

      allow create: if request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['company_admin', 'project_manager']
          && (!('currency' in request.resource.data)
              || (request.resource.data.currency is string
                  && request.resource.data.currency.matches('^[A-Z]{3}$')))
          && (!('currencyLocked' in request.resource.data)
              || request.resource.data.currencyLocked is bool)
          && directoryPaired(); // M2-A2 FINAL: a project is CREATED with its directory entry

      allow update: if request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
          && (
               // (a) Normal project write — company_admin / project_manager,
               //     subject to the currency ratchet.
               (
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['company_admin', 'project_manager']
                 && (!('currency' in request.resource.data)
                     || (request.resource.data.currency is string
                         && request.resource.data.currency.matches('^[A-Z]{3}$')))
                 && (!('currencyLocked' in request.resource.data)
                     || request.resource.data.currencyLocked is bool)
                 // Never unlock.
                 && (resource.data.get('currencyLocked', false) == false
                     || request.resource.data.get('currencyLocked', false) == true)
                 // Currency frozen while locked, with ONE carve-out: a locked project storing
                 // NO well-formed currency may receive its FIRST explicit code (see LEGACY
                 // INITIALISATION above). The same '^[A-Z]{3}$' test partitions every stored
                 // value between the carve-out and the freeze with no gap.
                 && (resource.data.get('currencyLocked', false) == false
                     || !(resource.data.get('currency', '') is string
                          && resource.data.get('currency', '').matches('^[A-Z]{3}$'))
                     || request.resource.data.get('currency', '') == resource.data.get('currency', ''))
                 // ADR-39 metadata correction: headline budget and provenance frozen,
                 // editable fields shape-validated on change (METADATA CORRECTION above).
                 && projectCorePreserved()
                 && statusOk()
                 && nameOk()
                 && progressOk()
                 && locationOk()
                 && startDateOk()
                 && (!changedKeys().hasAny(['name', 'status', 'location', 'startDate', 'progress']) || directoryPaired()) // M2-A2 FINAL: a display-field change carries its directory entry
               )
               ||
               // (b) QS currency-lock ratchet ONLY: false/absent -> true,
               //     affecting that single key and nothing else.
               (
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'qs'
                 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currencyLocked'])
                 && request.resource.data.currencyLocked == true
                 && resource.data.get('currencyLocked', false) == false
               )
             );

      allow delete: if false;
    }

    // Project Directory (M2-A2) — the EXTERNAL-SAFE entry of a project: exactly five
    // display fields, each equal to the project document AFTER the commit. No
    // budget, currency or access data can be stored here. get: internal roles and an
    // ASSIGNED client / subcontractor; list: internal roles only; delete blocked.
    match /companies/{companyId}/projectDirectory/{projectId} {
      function source() {
        return getAfter(projectPath(companyId, projectId)).data;
      }
      function mirrorsProject() {
        return existsAfter(projectPath(companyId, projectId))
            && request.resource.data.keys().hasOnly(['name', 'status', 'location', 'startDate', 'progress'])
            && request.resource.data.keys().hasAll(['name', 'status', 'location', 'startDate', 'progress'])
            && request.resource.data.name is string
            && request.resource.data.status is string
            && request.resource.data.location is string
            && (request.resource.data.startDate == null || request.resource.data.startDate is timestamp)
            && request.resource.data.progress is number
            && request.resource.data.name == source().get('name', '')
            && request.resource.data.status == source().get('status', '')
            && request.resource.data.location == source().get('location', '')
            && request.resource.data.startDate == source().get('startDate', null)
            && request.resource.data.progress == source().get('progress', 0);
      }
      allow get: if projectReader(companyId, projectId);
      allow list: if financialMember(companyId);
      allow create, update: if sameCompany(companyId)
          && memberRole() in ['company_admin', 'project_manager']
          && mirrorsProject();
      allow delete: if false;
    }

    // Company Cost Codes — the company-wide taxonomy. Financial roles read and
    // write (ADR-56); delete blocked (isActive: false instead).
    match /companies/{companyId}/costCodes/{costCodeId} {
      // Same three roles write; kept as a named alias for the update rule below.
      function costCodeWriter() {
        return financialMember(companyId);
      }
      allow read: if financialMember(companyId);

      allow create: if costCodeWriter();

      allow update: if costCodeWriter()
          // Provenance is immutable.
          && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
          && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
          // Only the content fields and the audit stamps may move.
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['code', 'name', 'category', 'unit', 'isActive', 'updatedAt', 'updatedBy'])
          && request.resource.data.code is string
          && request.resource.data.code.size() > 0
          && request.resource.data.code.size() <= 40
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.get('category', '') is string
          && request.resource.data.get('category', '').size() <= 80
          && request.resource.data.get('unit', '') is string
          && request.resource.data.get('unit', '').size() <= 24
          // Absent means ACTIVE (legacy documents predate the flag), so
          // presence is not required — but a stored value must be bool.
          && request.resource.data.get('isActive', true) is bool;

      allow delete: if false;
    }

    // Budget Lines — project-scoped allocations against a company cost code.
    // Reads: internal financial roles only (ADR-56). Same role set writes; delete blocked.
    match /companies/{companyId}/projects/{projectId}/budgetLines/{lineId} {
      function budgetLineWriter() {
        return financialMember(companyId);
      }
      allow read: if financialMember(companyId);

      // L4 (ADR-81): `boq-…` ids and `boqSource` are written ONLY by the
      // trusted transferBoqToBudget callable — no client create may use them
      // (the update allow-list below already freezes `boqSource`).
      allow create: if budgetLineWriter()
          && request.resource.data.costCodeId is string
          && request.resource.data.costCodeId.size() > 0
          && request.resource.data.budgeted is number
          && request.resource.data.budgeted >= 0
          && !lineId.matches('boq-.*')
          && !('boqSource' in request.resource.data);

      allow update: if budgetLineWriter()
          // The cost-code spine and the provenance no update may move.
          && request.resource.data.costCodeId   == resource.data.costCodeId
          && request.resource.data.get('costCodeName', '') == resource.data.get('costCodeName', '')
          && request.resource.data.get('createdAt', null)  == resource.data.get('createdAt', null)
          && request.resource.data.get('createdBy', null)  == resource.data.get('createdBy', null)
          // Only the two authored values and the stamps may move — this
          // is also what freezes the vestigial committed/actual/invoiced.
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['budgeted', 'notes', 'updatedAt', 'updatedBy'])
          && request.resource.data.budgeted is number
          && request.resource.data.budgeted >= 0
          && request.resource.data.get('notes', '') is string
          && request.resource.data.get('notes', '').size() <= 2000
          // Stamps verified against the caller and the server clock.
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // Approved-budget POINTER — SHIELD 2B1 (ADR-70). ONE document per project
    // (`current`) naming the ACTIVE approved budget version and the ORIGINAL;
    // created by the FIRST approval and advanced ONLY by an approval, paired
    // with the header through getAfter() in both directions. `versionCount`
    // is EXACTLY +1 per approval — the common concurrency boundary. Reads:
    // financial roles. Delete blocked. What rules cannot prove is DC44.
    // 2B2 (ADR-71): OPTIONAL adjustment ledger of the ACTIVE version
    // (absent reads 0) — +1 per paired adjustment approval, reset to 0 by
    // every version approval. DC45.
    match /companies/{companyId}/projects/{projectId}/approvedBudget/current {
      function pointerKeys() {
        return request.resource.data.keys().hasOnly(['activeApprovalId', 'originalApprovalId', 'versionCount', 'approvedAt', 'approvedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'adjustmentCount', 'adjustmentNet', 'lastAdjustmentId'])
            && request.resource.data.keys().hasAll(['activeApprovalId', 'originalApprovalId', 'versionCount', 'approvedAt', 'approvedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy']);
      }
      // The header this write names must be APPROVED in this same commit, by
      // this caller, at this server time, as THIS version.
      function pairedWithApproval() {
        let h = getAfter(budgetApprovalPath(companyId, projectId, request.resource.data.activeApprovalId)).data;
        return request.resource.data.activeApprovalId is string
            && request.resource.data.activeApprovalId.size() > 0
            && request.resource.data.versionCount is int
            && request.resource.data.approvedBy == request.auth.uid
            && request.resource.data.approvedAt == request.time
            && updateStamped()
            && h.status == 'approved'
            && h.version == request.resource.data.versionCount
            && h.approvedBy == request.auth.uid
            && h.approvedAt == request.time
            && request.resource.data.get('adjustmentCount', 0) == 0
            && request.resource.data.get('adjustmentNet', 0) == 0
            && request.resource.data.get('lastAdjustmentId', null) == null;
      }
      // ONE adjustment approved in this commit, against THIS active version,
      // as the NEXT sequence; the net moves by exactly its signed amount.
      function pairedWithAdjustment() {
        let d = request.resource.data;
        let a = getAfter(budgetAdjustmentPath(companyId, projectId, d.lastAdjustmentId)).data;
        return updateStamped()
            && d.adjustmentCount == resource.data.get('adjustmentCount', 0) + 1
            && d.adjustmentNet is number
            && cents(d.adjustmentNet) == cents(resource.data.get('adjustmentNet', 0))
               + (a.type == 'increase' ? cents(a.amount) : (a.type == 'decrease' ? 0 - cents(a.amount) : 0))
            && a.status == 'approved'
            && a.sequence == d.adjustmentCount
            && a.baseApprovalId == resource.data.activeApprovalId
            && a.approvedBy == request.auth.uid
            && a.approvedAt == request.time;
      }

      allow read: if financialMember(companyId);

      // The FIRST approval: version 1, the original IS the active version.
      allow create: if budgetApprover(companyId)
          && pointerKeys()
          && pairedWithApproval()
          && request.resource.data.versionCount == 1
          && request.resource.data.originalApprovalId == request.resource.data.activeApprovalId
          && createStamped();

      // (a) A later approval: the count moves by EXACTLY one, the active id
      // changes, the ledger resets, the original and provenance never move.
      // (b) An ADJUSTMENT approval: only the ledger and stamps move.
      allow update: if budgetApprover(companyId)
          && pointerKeys()
          && (
            (pairedWithApproval()
              && changedKeys().hasOnly(['activeApprovalId', 'versionCount', 'approvedAt', 'approvedBy', 'updatedAt', 'updatedBy', 'adjustmentCount', 'adjustmentNet', 'lastAdjustmentId'])
              && request.resource.data.versionCount == resource.data.versionCount + 1
              && request.resource.data.activeApprovalId != resource.data.activeApprovalId)
            ||
            (pairedWithAdjustment()
              && changedKeys().hasOnly(['adjustmentCount', 'adjustmentNet', 'lastAdjustmentId', 'updatedAt', 'updatedBy']))
          );

      allow delete: if false;
    }

    // Budget approval HEADERS — SHIELD 2B1 (ADR-70). The lifecycle record of
    // one approved budget version: draft → approved | withdrawn, both
    // TERMINAL (an approved version is never edited, withdrawn or deleted).
    // Captured by any financial role WITH its snapshot in the same commit;
    // APPROVED by company_admin / project_manager only, in the same commit
    // as the pointer; a draft is withdrawn by an approver or its creator.
    // `total` is a cross-check (rules cannot sum the entries); the app derives
    // the approved figure from the snapshot. DC44 lists the client-only gaps.
    match /companies/{companyId}/projects/{projectId}/budgetApprovals/{approvalId} {
      function snapshotPath() {
        return /databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/budgetApprovalSnapshots/$(approvalId);
      }
      function exactKeys() {
        return request.resource.data.keys().hasOnly(['reason', 'status', 'currency', 'entryCount', 'total', 'version', 'approvedAt', 'approvedBy', 'withdrawnAt', 'withdrawnBy', 'withdrawReason', 'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
            && request.resource.data.keys().hasAll(['reason', 'status', 'currency', 'entryCount', 'total', 'version', 'approvedAt', 'approvedBy', 'withdrawnAt', 'withdrawnBy', 'withdrawReason', 'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy']);
      }
      // The captured identity no update of any kind may rewrite.
      function corePreserved() {
        return request.resource.data.reason == resource.data.reason
            && request.resource.data.currency == resource.data.currency
            && request.resource.data.entryCount == resource.data.entryCount
            && request.resource.data.total == resource.data.total
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.createdBy == resource.data.createdBy;
      }

      allow read: if financialMember(companyId);

      // CAPTURE — born draft, revision 1, caller + server stamps, the currency
      // pinned to the project's, with the snapshot written in the same commit
      // by the same caller at the same server time and agreeing on count,
      // total and currency (getAfter).
      allow create: if financialMember(companyId)
          && exactKeys()
          && request.resource.data.reason is string
          && request.resource.data.reason.trim().size() > 0
          && request.resource.data.reason.size() <= 500
          && request.resource.data.status == 'draft'
          && request.resource.data.currency == resolvedCurrency(companyId, projectId)
          && request.resource.data.entryCount is int
          && request.resource.data.entryCount >= 1
          && request.resource.data.entryCount <= 2000
          && request.resource.data.total is number
          && request.resource.data.total >= 0
          && request.resource.data.version == null
          && request.resource.data.approvedAt == null
          && request.resource.data.approvedBy == null
          && request.resource.data.withdrawnAt == null
          && request.resource.data.withdrawnBy == null
          && request.resource.data.withdrawReason == ''
          && request.resource.data.revision == 1
          && createStamped()
          && updateStamped()
          && getAfter(snapshotPath()).data.entryCount == request.resource.data.entryCount
          && getAfter(snapshotPath()).data.total == request.resource.data.total
          && getAfter(snapshotPath()).data.currency == request.resource.data.currency
          && getAfter(snapshotPath()).data.capturedBy == request.auth.uid
          && getAfter(snapshotPath()).data.capturedAt == request.time;

      // The ONLY updates, each from DRAFT, stamps-only, revision + 1:
      //   (a) APPROVE — an approver flips the draft to approved with its
      //       version, paired with the pointer written in this commit (it
      //       names THIS header, at THIS version, at this server time).
      //   (b) WITHDRAW — an approver or the capturer, with a reason.
      allow update: if sameCompany(companyId) && corePreserved() && updateStamped() && revisionIncremented()
          && resource.data.status == 'draft'
          && (
            (
              budgetApprover(companyId)
              && request.resource.data.status == 'approved'
              && changedKeys().hasOnly(['status', 'version', 'approvedAt', 'approvedBy', 'revision', 'updatedAt', 'updatedBy'])
              && independentApprover(companyId, [resource.data.get('createdBy', null), resource.data.get('updatedBy', null)])
              && request.resource.data.approvedBy == request.auth.uid
              && request.resource.data.approvedAt == request.time
              && request.resource.data.version is int
              && request.resource.data.version >= 1
              && getAfter(approvedBudgetPath(companyId, projectId)).data.activeApprovalId == approvalId
              && getAfter(approvedBudgetPath(companyId, projectId)).data.versionCount == request.resource.data.version
              && getAfter(approvedBudgetPath(companyId, projectId)).data.approvedAt == request.time
            )
            ||
            (
              (budgetApprover(companyId) || (financialMember(companyId) && resource.data.createdBy == request.auth.uid))
              && request.resource.data.status == 'withdrawn'
              && changedKeys().hasOnly(['status', 'withdrawnAt', 'withdrawnBy', 'withdrawReason', 'revision', 'updatedAt', 'updatedBy'])
              && request.resource.data.withdrawnBy == request.auth.uid
              && request.resource.data.withdrawnAt == request.time
              && request.resource.data.withdrawReason is string
              && request.resource.data.withdrawReason.trim().size() > 0
              && request.resource.data.withdrawReason.size() <= 500
            )
          );

      allow delete: if false;
    }

    // Budget approval SNAPSHOTS — SHIELD 2B1 (ADR-70). ONE immutable document
    // per approval: every working budget LINE as captured (lineId,
    // costCodeId, costCodeName, budgeted). Create-only, paired with its
    // draft header; never updated, never deleted. Rules pin the list size,
    // the count, and the FIRST and LAST entries — shape, a real budget line
    // of THIS project with the SAME cost code and amount (get), and a real
    // company cost code (exists). Middle entries are client-validated (DC44).
    match /companies/{companyId}/projects/{projectId}/budgetApprovalSnapshots/{approvalId} {
      function headerPath() {
        return /databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/budgetApprovals/$(approvalId);
      }
      function entryValid(e) {
        let line = get(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/budgetLines/$(e.lineId)).data;
        return e is map
            && e.keys().hasOnly(['lineId', 'costCodeId', 'costCodeName', 'budgeted'])
            && e.keys().hasAll(['lineId', 'costCodeId', 'costCodeName', 'budgeted'])
            && e.lineId is string
            && e.lineId.size() > 0
            && e.costCodeId is string
            && e.costCodeId.size() > 0
            && e.costCodeName is string
            && e.costCodeName.size() <= 170
            && e.budgeted is number
            && e.budgeted >= 0
            && line.costCodeId == e.costCodeId
            && cents(line.budgeted) == cents(e.budgeted)
            && exists(/databases/$(database)/documents/companies/$(companyId)/costCodes/$(e.costCodeId));
      }
      function entriesValid() {
        let a = request.resource.data.entries;
        return a is list
            && a.size() >= 1
            && a.size() <= 2000
            && a.size() == request.resource.data.entryCount
            && entryValid(a[0])
            && entryValid(a[a.size() - 1]);
      }

      allow read: if financialMember(companyId);

      // Created ONLY together with its draft header: same caller, same
      // server time, same count / total / currency (getAfter).
      allow create: if financialMember(companyId)
          && request.resource.data.keys().hasOnly(['entryCount', 'total', 'currency', 'capturedAt', 'capturedBy', 'entries'])
          && request.resource.data.keys().hasAll(['entryCount', 'total', 'currency', 'capturedAt', 'capturedBy', 'entries'])
          && request.resource.data.entryCount is int
          && request.resource.data.total is number
          && request.resource.data.total >= 0
          && request.resource.data.currency is string
          && request.resource.data.capturedBy == request.auth.uid
          && request.resource.data.capturedAt == request.time
          && entriesValid()
          && getAfter(headerPath()).data.status == 'draft'
          && getAfter(headerPath()).data.entryCount == request.resource.data.entryCount
          && getAfter(headerPath()).data.total == request.resource.data.total
          && getAfter(headerPath()).data.currency == request.resource.data.currency
          && getAfter(headerPath()).data.createdBy == request.auth.uid
          && getAfter(headerPath()).data.createdAt == request.time;

      // IMMUTABLE. No update of any kind, no delete.
      allow update: if false;
      allow delete: if false;
    }

    // Budget ADJUSTMENTS — SHIELD 2B2 (ADR-71). ONE movement against the ACTIVE
    // approved version: increase | decrease (costCodeId) or transfer
    // (fromCostCodeId → costCodeId), amount > 0, whole cents, net derived.
    // draft → approved | withdrawn, both TERMINAL; never deleted. Bound at
    // create to the pointer's active version (no pointer: denied); approved
    // only with the pointer ledger (getAfter, both ways). DC45.
    match /companies/{companyId}/projects/{projectId}/budgetAdjustments/{adjId} {
      function adjKeys() {
        let k = ['type', 'costCodeId', 'costCodeName', 'fromCostCodeId', 'fromCostCodeName', 'amount', 'currency', 'reason', 'reference', 'baseApprovalId', 'baseVersion', 'sequence', 'status', 'approvedAt', 'approvedBy', 'withdrawnAt', 'withdrawnBy', 'withdrawReason', 'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'];
        return request.resource.data.keys().hasOnly(k) && request.resource.data.keys().hasAll(k);
      }
      function codeOk(id) {
        return id is string && id.size() > 0
            && exists(/databases/$(database)/documents/companies/$(companyId)/costCodes/$(id));
      }
      function movementOk(d) {
        return d.type in ['increase', 'decrease', 'transfer']
            && codeOk(d.costCodeId)
            && d.costCodeName is string && d.costCodeName.size() <= 170
            && d.fromCostCodeName is string && d.fromCostCodeName.size() <= 170
            && (d.type == 'transfer'
          ? (codeOk(d.fromCostCodeId) && d.fromCostCodeId != d.costCodeId)
          : (d.fromCostCodeId == null && d.fromCostCodeName == ''))
            && d.amount is number && d.amount > 0 && d.amount < 1000000000000
            && cents(d.amount) / 100.0 == d.amount;
      }

      allow read: if financialMember(companyId);

      allow create: if financialMember(companyId)
          && adjKeys()
          && movementOk(request.resource.data)
          && request.resource.data.reason is string
          && request.resource.data.reason.trim().size() > 0
          && request.resource.data.reason.size() <= 500
          && request.resource.data.reference is string
          && request.resource.data.reference.size() <= 200
          && request.resource.data.currency == resolvedCurrency(companyId, projectId)
          && request.resource.data.baseApprovalId == get(approvedBudgetPath(companyId, projectId)).data.activeApprovalId
          && request.resource.data.baseVersion == get(approvedBudgetPath(companyId, projectId)).data.versionCount
          && request.resource.data.status == 'draft'
          && request.resource.data.sequence == null
          && request.resource.data.approvedAt == null
          && request.resource.data.approvedBy == null
          && request.resource.data.withdrawnAt == null
          && request.resource.data.withdrawnBy == null
          && request.resource.data.withdrawReason == ''
          && request.resource.data.revision == 1
          && createStamped()
          && updateStamped();

      // From DRAFT only; nothing captured moves (changedKeys):
      //   (a) APPROVE — paired with the pointer naming THIS record as the
      //       next sequence of the SAME active version.
      //   (b) WITHDRAW — an approver or the preparer, with a reason.
      allow update: if sameCompany(companyId) && updateStamped() && revisionIncremented()
          && resource.data.status == 'draft'
          && (
            (
              budgetApprover(companyId)
              && request.resource.data.status == 'approved'
              && changedKeys().hasOnly(['status', 'sequence', 'approvedAt', 'approvedBy', 'revision', 'updatedAt', 'updatedBy'])
              && independentApprover(companyId, [resource.data.get('createdBy', null), resource.data.get('updatedBy', null)])
              && request.resource.data.approvedBy == request.auth.uid
              && request.resource.data.approvedAt == request.time
              && request.resource.data.sequence is int
              && getAfter(approvedBudgetPath(companyId, projectId)).data.lastAdjustmentId == adjId
              && getAfter(approvedBudgetPath(companyId, projectId)).data.adjustmentCount == request.resource.data.sequence
              && getAfter(approvedBudgetPath(companyId, projectId)).data.activeApprovalId == resource.data.baseApprovalId
            )
            ||
            (
              (budgetApprover(companyId) || (financialMember(companyId) && resource.data.createdBy == request.auth.uid))
              && request.resource.data.status == 'withdrawn'
              && changedKeys().hasOnly(['status', 'withdrawnAt', 'withdrawnBy', 'withdrawReason', 'revision', 'updatedAt', 'updatedBy'])
              && request.resource.data.withdrawnBy == request.auth.uid
              && request.resource.data.withdrawnAt == request.time
              && request.resource.data.withdrawReason is string
              && request.resource.data.withdrawReason.trim().size() > 0
              && request.resource.data.withdrawReason.size() <= 500
            )
          );

      allow delete: if false;
    }

    // Final Accounts — L2-B (ADR-77). ONE document per revision; the id IS the
    // revision number, so numbering is gapless and a revision opens only once
    // its predecessor is terminal (one open draft). draft → withdrawn here;
    // draft → APPROVED is written ONLY by the approveFinalAccount callable
    // (Admin SDK), which recomputes every figure — NO client can approve, and a
    // draft's figures are untrusted until it does. Never deleted. DC47.
    match /companies/{companyId}/projects/{projectId}/finalAccounts/{faId} {
      function draftValid(d) {
        let k = ['number', 'status', 'revision', 'reason', 'reference', 'currency', 'figures', 'rows', 'rowCount', 'sources', 'openItemsAcknowledged', 'preparedByName', 'approvedAt', 'approvedBy', 'approvedByName', 'approvedByRole', 'selfApproved', 'sourcesReadAt', 'withdrawnAt', 'withdrawnBy', 'withdrawReason', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'];
        return d.keys().hasOnly(k) && d.keys().hasAll(k)
            && d.number is int && d.number >= 1 && d.number <= 9999 && faId == string(d.number)
            && (d.number == 1 || get(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/finalAccounts/$(string(d.number - 1))).data.status in ['approved', 'withdrawn'])
            && d.status == 'draft' && d.revision == 1
            && d.reason is string && d.reason.trim().size() > 0 && d.reason.size() <= 500
            && d.reference is string && d.reference.size() <= 200
            && d.currency == resolvedCurrency(companyId, projectId)
            && d.figures is map && d.figures.size() <= 40
            && d.rows is list && d.rows.size() <= 1000 && d.rowCount == d.rows.size()
            && d.sources is map && d.sources.size() <= 10
            && d.openItemsAcknowledged == true
            && d.preparedByName is string && d.preparedByName.size() <= 200
            && d.approvedAt == null && d.approvedBy == null && d.approvedByName == null
            && d.approvedByRole == null && d.selfApproved == null && d.sourcesReadAt == null
            && d.withdrawnAt == null && d.withdrawnBy == null && d.withdrawReason == ''
            && d.createdBy == request.auth.uid && d.createdAt == request.time;
      }

      allow read: if financialMember(companyId);

      allow create: if financialMember(companyId) && draftValid(request.resource.data) && updateStamped();

      // WITHDRAW — the only client update: a DRAFT, by an approver or its
      // preparer, with a reason; nothing captured moves (changedKeys).
      allow update: if (budgetApprover(companyId) || (financialMember(companyId) && resource.data.createdBy == request.auth.uid))
          && resource.data.status == 'draft'
          && request.resource.data.status == 'withdrawn'
          && changedKeys().hasOnly(['status', 'withdrawnAt', 'withdrawnBy', 'withdrawReason', 'revision', 'updatedAt', 'updatedBy'])
          && request.resource.data.withdrawnBy == request.auth.uid
          && request.resource.data.withdrawnAt == request.time
          && request.resource.data.withdrawReason is string
          && request.resource.data.withdrawReason.trim().size() > 0
          && request.resource.data.withdrawReason.size() <= 500
          && updateStamped() && revisionIncremented();

      allow delete: if false;
    }

    // BOQ items — the project's measured Bill of Quantities: description,
    // quantity, unit, cost code (mandatory spine, frozen name snapshot), and —
    // once priced — a rate with a DERIVED amount (ADR-32 Part 1).
    match /companies/{companyId}/projects/{projectId}/boqItems/{itemId} {
      function corePreserved() {
        return request.resource.data.currency  == resource.data.currency
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.revision  == resource.data.revision;
      }
      // rate and amount travel together: both null (unpriced), or both
      // non-negative numbers with amount == quantity × rate to the cent.
      function pricingValid() {
        return (request.resource.data.rate == null
        && request.resource.data.amount == null)
            || (request.resource.data.rate is number
        && request.resource.data.rate >= 0
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && cents(request.resource.data.quantity * request.resource.data.rate)
           == cents(request.resource.data.amount));
      }
      // Shape required of every stored ACTIVE state (create and edit alike).
      function shapeValid() {
        return request.resource.data.revision == 1
            && request.resource.data.itemNumber is string
            && request.resource.data.itemNumber.size() <= 40
            && request.resource.data.section is string
            && request.resource.data.description is string
            && request.resource.data.description.trim().size() > 0
            && request.resource.data.unit is string
            && request.resource.data.unit.size() > 0
            && request.resource.data.unit.size() <= 40
            // A measurement, not money — non-negative; zero is a real
            // measured quantity.
            && request.resource.data.quantity is number
            && request.resource.data.quantity >= 0
            && pricingValid()
            // Cost-code spine: MANDATORY on every item (frozen name snapshot).
            && request.resource.data.costCodeId is string
            && request.resource.data.costCodeId.size() > 0
            && request.resource.data.costCodeName is string
            && request.resource.data.costCodeName.size() > 0
            && request.resource.data.notes is string
            && currencyShaped();
      }
      // Quant 1B provenance (ADR-52): the LATEST explicit application of a measured
      // total — preserved exactly as stored, or freshly caller-stamped with THIS write.
      // `evidence` is the client fingerprint, shape-checked only.
      function quantAppliedShape(q) {
        return q is map
            && q.keys().hasOnly(['at', 'by', 'quantity', 'measurementCount', 'evidence'])
            && q.keys().hasAll(['at', 'by', 'quantity', 'measurementCount', 'evidence'])
            && q.at is timestamp
            && q.by is string && q.by.size() > 0
            && q.quantity is number && q.quantity >= 0
            && q.measurementCount is int && q.measurementCount >= 1
            && q.evidence is string && q.evidence.size() > 0 && q.evidence.size() <= 128;
      }
      function quantAppliedPreserved() {
        return !('quantApplied' in request.resource.data)
            || (('quantApplied' in resource.data) && request.resource.data.quantApplied == resource.data.quantApplied);
      }
      function quantAppliedFresh() {
        return quantAppliedShape(request.resource.data.quantApplied)
            && request.resource.data.quantApplied.by == request.auth.uid
            && request.resource.data.quantApplied.at == request.time
            && request.resource.data.quantApplied.quantity == request.resource.data.quantity;
      }

      allow read: if financialMember(companyId);

      allow create: if financialMember(companyId)
          && shapeValid()
          && request.resource.data.status == 'active'
          && createStamped()
          && updateStamped()
          // Void stamps cannot be forged at creation.
          && request.resource.data.voidedAt == null
          && request.resource.data.voidedBy == null
          // Provenance is written only by an application to an existing item.
          && !('quantApplied' in request.resource.data);

      allow update: if financialMember(companyId) && corePreserved() && updateStamped() && (
            // (a) ACTIVE EDIT — content (measurement, pricing, cost
            //     code, labels) is freely editable while active, but
            //     the status may not move and no void stamp may be
            //     forged. `quantApplied` is either untouched or a
            //     fresh, caller-stamped record of THIS write.
            (
              resource.data.status == 'active'
              && request.resource.data.status == 'active'
              && shapeValid()
              && request.resource.data.voidedAt == resource.data.voidedAt
              && request.resource.data.voidedBy == resource.data.voidedBy
              && (quantAppliedPreserved() || quantAppliedFresh())
            )
            ||
            // (b) ACTIVE -> VOID (terminal) — void audit fields only; a voided item is
            //     immutable retained history.
            (
              resource.data.status == 'active'
              && voidedWithReason()
            )
          );

      allow delete: if false;
    }

    // Purchase Orders — supplier commitments against company cost codes. Financial
    // roles only (ADR-56). Lifecycle RULES-ENFORCED (ADR-57, M2-B1): born draft,
    // draft-only content edits, stamps-only transitions, identity and money frozen
    // after send, whole-cent headers; delete blocked. What rules cannot verify
    // (lineItems, the cancel policy) is docs/SECURITY.md → Deferred Control 35.
    match /companies/{companyId}/projects/{projectId}/purchaseOrders/{poId} {
      // Exact key set of a document the app creates (hooks/usePurchaseOrders.jsx).
      // The three M3-A source keys (ADR-61) are OPTIONAL at create: absent on a
      // manual or legacy PO, all present on an award-raised one.
      function exactKeys() {
        return request.resource.data.keys().hasOnly(['poNumber', 'status', 'supplierName', 'supplierId', 'description', 'lineItems', 'subtotal', 'gst', 'total', 'currency', 'revision', 'notes', 'sentAt', 'sentBy', 'closedAt', 'closedBy', 'cancelledAt', 'cancelledBy', 'externalRefs', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'sourceTenderPackageId', 'sourceTenderBidId', 'sourceTenderNumber', 'lastMaterialEditBy', 'lastMaterialEditAt'])
            && request.resource.data.keys().hasAll(['poNumber', 'status', 'supplierName', 'supplierId', 'description', 'lineItems', 'subtotal', 'gst', 'total', 'currency', 'revision', 'notes', 'sentAt', 'sentBy', 'closedAt', 'closedBy', 'cancelledAt', 'cancelledBy', 'externalRefs', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy']);
      }
      // M3-A (ADR-61): an award-raised PO cites its source — all three keys absent
      // (manual / legacy), or all present and get()/getAfter()-verified against the
      // awarded package and its winning bid (docs/SECURITY.md → Deferred Control 38).
      function tenderPkgPath() {
        return /databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/tenderPackages/$(request.resource.data.sourceTenderPackageId);
      }
      function tenderBidPath() {
        return /databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/tenderBids/$(request.resource.data.sourceTenderBidId);
      }
      function sourceAbsent() {
        return !request.resource.data.keys().hasAny(['sourceTenderPackageId', 'sourceTenderBidId', 'sourceTenderNumber']);
      }
      function sourceTenderValid() {
        let d = request.resource.data;
        let pkg = get(tenderPkgPath()).data;
        let bid = get(tenderBidPath()).data;
        return d.sourceTenderPackageId is string
            && d.sourceTenderPackageId.size() > 0
            && d.sourceTenderBidId is string
            && d.sourceTenderBidId.size() > 0
            && d.sourceTenderNumber is string
            && d.sourceTenderNumber.size() > 0
            && pkg.status == 'awarded'
            && pkg.awardedBidId == d.sourceTenderBidId
            && pkg.tenderNumber == d.sourceTenderNumber
            && bid.tenderPackageId == d.sourceTenderPackageId
            && bid.status == 'received'
            && bid.bidderContactId == d.supplierId
            && bid.bidderName == d.supplierName
            && getAfter(tenderPkgPath()).data.raisedPoId == poId;
      }
      // Identity written once. `supplierId` is null on a pre-Contacts PO
      // (ADR-15) and is never backfilled.
      function identityShapeValid() {
        let d = request.resource.data;
        return d.poNumber is string
            && d.poNumber.matches('^PO-[0-9]{4,}$')
            && d.supplierName is string
            && d.supplierName.size() > 0
            && d.supplierName.size() <= 200
            && (d.supplierId == null || (d.supplierId is string && d.supplierId.size() > 0))
            && d.currency is string
            && d.currency.matches('^[A-Z]{3}$')
            && d.revision is number
            && d.externalRefs is map;
      }
      // Authored content; bounds stop unbounded strings. The line COUNT is the honest
      // ceiling on `lineItems` (no iteration — Deferred Control 35).
      function contentShapeValid() {
        let d = request.resource.data;
        return d.description is string
            && d.description.size() <= 2000
            && d.notes is string
            && d.notes.size() <= 5000
            && d.lineItems is list
            && d.lineItems.size() >= 1
            && d.lineItems.size() <= 200;
      }
      function moneyTypesValid() {
        let d = request.resource.data;
        return d.subtotal is number
            && d.gst is number
            && d.total is number
            && d.subtotal >= 0
            && d.gst >= 0
            && d.total >= 0;
      }
      // subtotal + gst == total EXACTLY in cents; gst is 10% of subtotal half-up, or
      // ONE cent below on a half-cent boundary only — the app's own roundMoney output
      // (ADR-57). GST_RATE is a flat 10% regardless of currency.
      function moneyBalanced() {
        let d = request.resource.data;
        let sub = cents(d.subtotal);
        let gst = cents(d.gst);
        return sub + gst == cents(d.total)
            && (gst == gstCents(sub)
        || (sub % 10 == 5 && gst == gstCents(sub) - 1));
      }
      function moneyValid() {
        return moneyTypesValid() && moneyBalanced();
      }
      // Born draft, stamped by its creator, every lifecycle stamp null.
      function createValid() {
        let d = request.resource.data;
        return d.status == 'draft'
            && d.createdBy == request.auth.uid
            && d.createdAt == request.time
            && d.sentAt == null
            && d.sentBy == null
            && d.closedAt == null
            && d.closedBy == null
            && d.cancelledAt == null
            && d.cancelledBy == null;
      }
      // The identity no update may rewrite. Optional keys are read through
      // get(key, null) on BOTH sides so a pre-ADR-57 document (no `*By` stamps,
      // possibly no `externalRefs`) compares equal and stays writable.
      function corePreserved() {
        let d = request.resource.data;
        let p = resource.data;
        return d.poNumber == p.poNumber
            && d.supplierName == p.supplierName
            && d.get('supplierId', null) == p.get('supplierId', null)
            && d.get('currency', null) == p.get('currency', null)
            && d.get('revision', null) == p.get('revision', null)
            && d.get('externalRefs', null) == p.get('externalRefs', null)
            && d.get('sourceTenderPackageId', null) == p.get('sourceTenderPackageId', null)
            && d.get('sourceTenderBidId', null) == p.get('sourceTenderBidId', null)
            && d.get('sourceTenderNumber', null) == p.get('sourceTenderNumber', null)
            && d.createdAt == p.createdAt
            && d.createdBy == p.createdBy;
      }

      allow read: if financialMember(companyId);

      allow create: if financialMember(companyId)
          && exactKeys()
          && createValid()
          && stampedAtCreate()
          && updateStamped()
          && identityShapeValid()
          && contentShapeValid()
          && moneyValid()
          && exists(projectPath(companyId, projectId))
          && request.resource.data.currency == resolvedCurrency(companyId, projectId)
          && (sourceAbsent() || sourceTenderValid());

      // `resource != null` first — a denied create is also measured against
      // this rule (see the supplierInvoices note on the 1000-expression ceiling).
      allow update: if resource != null
          && financialMember(companyId) && corePreserved() && updateStamped() && (
            // (a) DRAFT EDIT — the authored content and the derived header only
            //     (updatePurchaseOrder); status and every stamp are outside the list.
            (
              resource.data.status == 'draft'
              && changedKeys().hasOnly(['description', 'notes', 'lineItems', 'subtotal', 'gst', 'total', 'updatedAt', 'updatedBy', 'lastMaterialEditBy', 'lastMaterialEditAt'])
              && materialStamped(['description', 'lineItems', 'subtotal', 'gst', 'total'])
              && contentShapeValid()
              && moneyValid()
            )
            ||
            // (b) SEND — THE FREEZE AND COMMITMENT POINT, from draft (or the reserved
            //     pending_approval). Stamps only; a draft with no line cannot be sent.
            (
              resource.data.status in ['draft', 'pending_approval']
              && request.resource.data.status == 'sent'
              && resource.data.lineItems is list
              && resource.data.lineItems.size() >= 1
              && changedKeys().hasOnly(['status', 'sentAt', 'sentBy', 'updatedAt', 'updatedBy'])
              && request.resource.data.sentBy == request.auth.uid
              && request.resource.data.sentAt == request.time
              && independentOfStampedPreparers(companyId)
            )
            ||
            // (c) CLOSE — sent only. Stamps only.
            (
              resource.data.status == 'sent'
              && request.resource.data.status == 'closed'
              && changedKeys().hasOnly(['status', 'closedAt', 'closedBy', 'updatedAt', 'updatedBy'])
              && request.resource.data.closedBy == request.auth.uid
              && request.resource.data.closedAt == request.time
            )
            ||
            // (d) CANCEL (terminal) — from any non-terminal status; stamps only (no reason
            //     field exists). Open claims / invoices are NOT checked here (DC35).
            (
              resource.data.status in ['draft', 'pending_approval', 'sent']
              && request.resource.data.status == 'cancelled'
              && changedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy', 'updatedAt', 'updatedBy'])
              && request.resource.data.cancelledBy == request.auth.uid
              && request.resource.data.cancelledAt == request.time
            )
          );

      allow delete: if false;
    }

    // Progress Claims — ADR-93 (Phase 2 step 3). A claim is CREATED, its draft
    // EDITED, APPROVED and REJECTED — and linked to its supplier invoice — only
    // by the trusted supplier-finance backend (functions/src/supplierFinance/),
    // which derives every figure, holds one open claim per PO and certifies
    // under the claim's own calculation version. The ONE client write left is
    // the content-free SUBMIT: draft → submitted, the caller's own stamps at
    // server time, revision + 1, nothing else (the line set must exist).
    // *As written before ADR-93:* create, draft edit, approve, reject and the
    // ADR-68 link / unlink / reconcile branches were client writes here.
    match /companies/{companyId}/projects/{projectId}/progressClaims/{claimId} {
      allow read: if financialMember(companyId);
      allow create: if false;
      allow update: if resource != null
          && financialMember(companyId)
          && commercialActive(companyId)
          && updateStamped()
          && revisionIncremented()
          && resource.data.status == 'draft'
          && request.resource.data.status == 'submitted'
          && resource.data.lineItems is list
          && resource.data.lineItems.size() >= 1
          && changedKeys().hasOnly(['status', 'submittedAt', 'submittedBy', 'revision', 'updatedAt', 'updatedBy'])
          && request.resource.data.submittedBy == request.auth.uid
          && request.resource.data.submittedAt == request.time;
      allow delete: if false;
    }

    // Supplier Invoices — ADR-93 (Phase 2 step 3). Created, edited, approved,
    // posted and cancelled, and paired with their claim, ONLY by the trusted
    // supplier-finance backend, which verifies everything stored under the
    // invoice's own calculation version before it becomes authoritative. No
    // client write of any kind. *As written before ADR-93:* the ADR-40 / ADR-68
    // create, draft-edit, transition and pairing branches were client writes.
    match /companies/{companyId}/projects/{projectId}/supplierInvoices/{invoiceId} {
      allow read: if financialMember(companyId);
      allow create, update, delete: if false;
    }

    // Variations — type-discriminated client (CV) / supplier (SV) change control
    // (ADR-18). Financial roles only. Lifecycle RULES-ENFORCED (ADR-59, M2-B3):
    // born draft, a get()-verified PO for PO-linked supplier variations, draft-only
    // edits, stamps-only transitions, SIGNED whole-cent headers never clamped,
    // revision +1, the ADR-34 RFI link draft-only; delete blocked. What rules
    // cannot verify is docs/SECURITY.md → Deferred Control 37.
    match /companies/{companyId}/projects/{projectId}/variations/{variationId} {
      function variationMember() {
        return request.auth != null
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['company_admin', 'project_manager', 'qs'];
      }
      function isDate(v) {
        return v is string && (v == '' || v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
      }
      function text(v, n) {
        return v is string && v.size() <= n;
      }
      // ADR-90: a variation is CREATED, its draft EDITED, APPROVED (certified
      // figures, commitment stamps) and given its legacy commitment stamps ONLY by
      // the trusted backend (functions/src/variations/) — no client path to any of
      // the four, so no client writes a line, a figure, a cost code, the
      // originating-RFI link, `calcVersion` (ADR-91) or a commitment key. Rules keep
      // the read and the three CONTENT-FREE transitions below.

      allow read: if variationMember();

      allow create: if false;

      // `resource != null` first — a denied create is also measured here. Every
      // branch's hasOnly on changedKeys() freezes everything the branch does not own.
      allow update: if resource != null
          && variationMember() && commercialActive(companyId) && updateStamped() && revisionIncremented() && (
            // (b) SUBMIT — THE SUBMITTED-MONEY FREEZE POINT; stamps and the submitted date only.
            (
              resource.data.status == 'draft'
              && request.resource.data.status == 'submitted'
              && resource.data.lineItems is list
              && resource.data.lineItems.size() >= 1
              && changedKeys().hasOnly(['status', 'submittedDate', 'submittedAt', 'submittedBy', 'revision', 'updatedAt', 'updatedBy'])
              && isDate(request.resource.data.submittedDate)
              && request.resource.data.submittedBy == request.auth.uid
              && request.resource.data.submittedAt == request.time
            )
            ||
            // (d) REJECT (terminal) — stamps plus the optional notes.
            (
              resource.data.status in ['submitted', 'under_review']
              && request.resource.data.status == 'rejected'
              && changedKeys().hasOnly(['status', 'rejectedAt', 'rejectedBy', 'assessmentNotes', 'revision', 'updatedAt', 'updatedBy'])
              && request.resource.data.rejectedBy == request.auth.uid
              && request.resource.data.rejectedAt == request.time
              && text(request.resource.data.assessmentNotes, 5000)
            )
            ||
            // (e) WITHDRAW (terminal) — stamps only.
            (
              resource.data.status in ['draft', 'submitted', 'under_review']
              && request.resource.data.status == 'withdrawn'
              && changedKeys().hasOnly(['status', 'withdrawnAt', 'withdrawnBy', 'revision', 'updatedAt', 'updatedBy'])
              && request.resource.data.withdrawnBy == request.auth.uid
              && request.resource.data.withdrawnAt == request.time
            )
          );

      allow delete: if false;
    }

    // Forecast Lines — one input document per cost code (uncommittedCostToComplete,
    // notes, stamps); every forecast figure is derived at read time. Financial
    // roles only (commercially sensitive); idempotent upsert; delete blocked.
    match /companies/{companyId}/projects/{projectId}/forecastLines/{costCodeId} {
      allow read, create, update: if request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['company_admin', 'project_manager', 'qs'];
      allow delete: if false;
    }

    // Project Commercial Baseline — the CONTRACT REVENUE baseline (ADR-20): the
    // Margin foundation inputs in ONE document with the deterministic id
    // `baseline` (no other commercial/* id has a rule). Financial roles only —
    // tighter than the member-readable project document. Delete blocked.
    // SHIELD 2B1 (ADR-70) hardened the shape: exact keys, non-negative money,
    // typed dates / client, caller + server stamps, immutable provenance — and
    // the legacy `originalApprovedBudget` scalar FREEZES once an approved
    // budget version exists (version 1's snapshot is then the original).
    // ADR-96 — corrections of the original contract value: written only by
    // the trusted backend (contractValueOperation); read by financial roles.
    match /companies/{companyId}/projects/{projectId}/contractValueRevisions/{revisionId} {
      allow read: if financialMember(companyId);
      allow create, update, delete: if false;
    }

    // ADR-97 — estimate revisions (header + line chunks) and rate breakdowns:
    // written only by the trusted backend (estimateOperation); read by
    // financial roles. `estimateState` matches no rule (server-only).
    match /companies/{companyId}/projects/{projectId}/estimates/{document=**} {
      allow read: if financialMember(companyId);
      allow write: if false;
    }
    match /companies/{companyId}/projects/{projectId}/estimateItemInputs/{itemId} {
      allow read: if financialMember(companyId);
      allow write: if false;
    }

    match /companies/{companyId}/projects/{projectId}/commercial/baseline {
      function baselineShape() {
        let d = request.resource.data;
        return d.keys().hasOnly(['originalContractValue', 'originalApprovedBudget', 'contractStartDate', 'contractCompletionDate', 'clientId', 'clientName', 'notes', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'originalContractValueVersion', 'originalContractValueRevisedAt', 'originalContractValueRevisedBy', 'originalContractValueRevisionId'])
            && d.originalContractValue is number
            && d.originalContractValue >= 0
            && (d.get('originalApprovedBudget', null) == null
        || (d.originalApprovedBudget is number && d.originalApprovedBudget >= 0))
            && (d.get('contractStartDate', null) == null || d.contractStartDate is timestamp)
            && (d.get('contractCompletionDate', null) == null || d.contractCompletionDate is timestamp)
            && (d.get('clientId', null) == null || (d.clientId is string && d.clientId.size() <= 200))
            && (d.get('clientName', null) == null || (d.clientName is string && d.clientName.size() <= 200))
            && d.get('notes', '') is string
            && d.get('notes', '').size() <= 2000
            && updateStamped();
      }
      // Once a budget version is approved, the legacy scalar is history: it
      // may only stay what it was (null on a baseline created afterwards).
      function legacyOriginalFrozen(previous) {
        return !exists(approvedBudgetPath(companyId, projectId))
            || request.resource.data.get('originalApprovedBudget', null) == previous;
      }

      allow read: if financialMember(companyId);

      // ADR-96 (G5): the original contract value is set up by this create; the
      // four correction-provenance keys are the backend's and absent here.
      allow create: if financialMember(companyId)
          && baselineShape()
          && createStamped()
          && legacyOriginalFrozen(null)
          && !request.resource.data.keys().hasAny(['originalContractValueVersion', 'originalContractValueRevisedAt', 'originalContractValueRevisedBy', 'originalContractValueRevisionId']);

      allow update: if financialMember(companyId)
          && baselineShape()
          && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
          && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
          && legacyOriginalFrozen(resource.data.get('originalApprovedBudget', null))
          // ADR-96 (G5): once established, the original contract value and its
          // provenance change ONLY through the audited correction process
          // (contractValueOperation); the other baseline fields stay editable.
          && request.resource.data.originalContractValue == resource.data.originalContractValue
          && request.resource.data.get('originalContractValueVersion', null) == resource.data.get('originalContractValueVersion', null)
          && request.resource.data.get('originalContractValueRevisedAt', null) == resource.data.get('originalContractValueRevisedAt', null)
          && request.resource.data.get('originalContractValueRevisedBy', null) == resource.data.get('originalContractValueRevisedBy', null)
          && request.resource.data.get('originalContractValueRevisionId', null) == resource.data.get('originalContractValueRevisionId', null);

      allow delete: if false;
    }

    // Client Invoices — accounts-receivable invoices to the head-contract client;
    // CI-#### from the company counters block below.
    match /companies/{companyId}/projects/{projectId}/clientInvoices/{invoiceId} {
      function corePreserved() {
        return request.resource.data.invoiceNumber == resource.data.invoiceNumber
            && docCoreFrozen();
      }
      // Client retention (ADR-88): the four fields are ALL absent (an invoice written
      // before it, or by an older build) or all pinned — retention within the subtotal,
      // its GST the invoice's own GST in proportion (to within half a cent: doubles
      // carry the product exactly enough at ANY size, so there is no upper limit;
      // the backend requires the exact figure before posting against the invoice),
      // gross and receivable reconciling. Frozen at issue by the key lists below.
      function retentionValid() {
        let d = request.resource.data;
        // Supported range (lib/money.js): 999,999,999,999.99 ex-GST.
        return d.get('subtotal', 0) <= 999999999999.99
            && (!d.keys().hasAny(['retention', 'retentionGst', 'retentionTotal', 'receivableTotal'])
                || retentionPinned(d, cents(d.subtotal), cents(d.gstTotal), cents(d.retention)));
      }
      function retentionPinned(d, s, g, r) {
        return centExact(d.subtotal) && centExact(d.gstTotal) && centExact(d.grossTotal)
            && centExact(d.retention) && centExact(d.retentionGst)
            && centExact(d.retentionTotal) && centExact(d.receivableTotal)
            && s >= 0 && g >= 0 && r >= 0 && r <= s
            // Retention only for a company activated for client finance.
            && (r == 0 || ciActive(companyId))
            && cents(d.grossTotal) == s + g
            && (r == 0 ? cents(d.retentionGst) == 0
                       : math.abs(cents(d.retentionGst) - g * 1.0 * r / s) <= 0.5)
            && cents(d.retentionGst) >= 0 && cents(d.retentionGst) <= g
            && cents(d.retentionTotal) == r + cents(d.retentionGst)
            && cents(d.receivableTotal) == s + g - cents(d.retentionTotal);
      }
      // ADR-87: an invoice carrying a posted credit note or retention release cannot
      // be voided — those are voided first. No ledger: nothing was ever posted.
      function ledgerClear() {
        return !exists(ciLedgerPath(companyId, projectId, invoiceId))
            || (get(ciLedgerPath(companyId, projectId, invoiceId)).data.get('creditedSubtotalCents', 0) == 0
                && get(ciLedgerPath(companyId, projectId, invoiceId)).data.get('releasedRetentionCents', 0) == 0);
      }

      allow read: if financialMember(companyId);

      allow create: if financialMember(companyId)
          && retentionValid()
          && request.resource.data.status == 'draft'
          && request.resource.data.docType == 'invoice'
          && request.resource.data.invoiceNumber is string
          && currencyShaped()
          && request.resource.data.revision is number
          && createStamped()
          && updateStamped()
          // Lifecycle stamps cannot be forged at creation.
          && request.resource.data.issuedAt == null
          && request.resource.data.issuedBy == null
          && request.resource.data.voidedAt == null
          && request.resource.data.voidedBy == null;

      allow update: if financialMember(companyId) && corePreserved() && updateStamped() && (
            // (a) DRAFT EDIT — content only; the status and lifecycle stamps cannot move.
            (
              resource.data.status == 'draft'
              && request.resource.data.status == 'draft'
              && retentionValid()
              && request.resource.data.issuedAt == resource.data.issuedAt
              && request.resource.data.issuedBy == resource.data.issuedBy
              && request.resource.data.voidedAt == resource.data.voidedAt
              && request.resource.data.voidedBy == resource.data.voidedBy
            )
            ||
            // (b) DRAFT -> ISSUED. A separate operation carrying no
            //     content change whatsoever.
            (
              resource.data.status == 'draft'
              && request.resource.data.status == 'issued'
              && changedKeys().hasOnly(['status', 'issuedAt', 'issuedBy', 'updatedAt', 'updatedBy'])
              && request.resource.data.issuedBy == request.auth.uid
              && request.resource.data.issuedAt == request.time
            )
            ||
            // (c) DRAFT -> VOID (terminal). An ISSUED invoice is voided only by the
            //     trusted backend (voidClientInvoice, Phase 2 step 5 / D8), which
            //     refuses while its ledger records any money — receipts included.
            (
              resource.data.status == 'draft'
              && voidedWithReason()
              && ledgerClear()
            )
          );

      allow delete: if false;
    }

    // Client invoice LEDGERS (ADR-87 / ADR-88) — ONE document per invoice (the id IS
    // the invoice id): running totals, in whole cents, of everything posted against
    // it. Written ONLY by the trusted backend (ADR-89, Admin SDK), in the transaction
    // that posts or voids one entry. No client can create, change or delete one.
    match /companies/{companyId}/projects/{projectId}/clientInvoiceLedgers/{invoiceId} {
      allow read: if financialMember(companyId);
      allow write: if false;
    }

    // Client Refunds (CRF-####) and Client Receipt Applications (CRA-####) — Phase 2
    // step 5 (D6–D8). Written ONLY by the trusted backend, with the ledger(s) they
    // move and one audit event; read like the other client-finance registers.
    match /companies/{companyId}/projects/{projectId}/clientRefunds/{refundId} {
      allow read: if financialMember(companyId);
      allow write: if false;
    }
    match /companies/{companyId}/projects/{projectId}/clientReceiptApplications/{applicationId} {
      allow read: if financialMember(companyId);
      allow write: if false;
    }

    // Client Credit Notes (ADR-87) — reductions against ONE ISSUED Client Invoice;
    // CCN-#### from the company counters. A client drafts, edits a draft and voids
    // a DRAFT. POSTING and voiding a POSTED note are the trusted backend's
    // (ADR-89): it re-derives every line and total and moves the ledger with it.
    match /companies/{companyId}/projects/{projectId}/clientCreditNotes/{creditNoteId} {
      allow read: if financialMember(companyId);
      allow create: if financialMember(companyId)
          && ciDraft(companyId, projectId, 'credit_note', 'creditNumber')
          && createStamped()
          && lifecycleUnstamped();
      allow update: if resource != null && financialMember(companyId)
          && ciDraftUpdate(companyId, projectId, 'credit_note', 'creditNumber');
      allow delete: if false;
    }

    // Client Retention Releases (ADR-88) — authorisations making retention ALREADY
    // WITHHELD on ONE issued Client Invoice receivable; CRR-#### from the company
    // counters. Same split as credit notes: drafts by the client, posting and
    // voiding a posted release by the trusted backend (ADR-89).
    match /companies/{companyId}/projects/{projectId}/clientRetentionReleases/{releaseId} {
      allow read: if financialMember(companyId);
      allow create: if financialMember(companyId)
          && ciDraft(companyId, projectId, 'client_retention_release', 'releaseNumber')
          && createStamped()
          && lifecycleUnstamped();
      allow update: if resource != null && financialMember(companyId)
          && ciDraftUpdate(companyId, projectId, 'client_retention_release', 'releaseNumber');
      allow delete: if false;
    }

    // Client Receipts — cash actually received from a client, with EMBEDDED
    // allocations against issued Client Invoices; CR-#### from the company counters.
    match /companies/{companyId}/projects/{projectId}/clientReceipts/{receiptId} {
      function corePreserved() {
        return request.resource.data.receiptNumber == resource.data.receiptNumber
            && docCoreFrozen();
      }
      // Shape required of every stored state (create and draft edit alike).
      function shapeValid() {
        return request.resource.data.docType == 'receipt'
            && request.resource.data.receiptNumber is string
            && request.resource.data.revision is number
            // A receipt without a client is not a record — clientId/clientName
            // are REQUIRED non-empty strings, never null.
            && request.resource.data.clientId is string
            && request.resource.data.clientId.size() > 0
            && request.resource.data.clientName is string
            && request.resource.data.clientName.size() > 0
            && currencyShaped()
            && request.resource.data.receiptDate is string
            && request.resource.data.receiptDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.paymentMethod is string
            && request.resource.data.paymentMethod.size() > 0
            && request.resource.data.paymentMethod.size() <= 40
            && request.resource.data.allocations is list
            && request.resource.data.allocations.size() <= 100
            // Supported range (lib/money.js): ten maximum invoices.
            && request.resource.data.amount <= 9999999999999.9
            && amountInvariant();
      }

      allow read: if financialMember(companyId);

      allow create: if financialMember(companyId)
          && shapeValid()
          && request.resource.data.status == 'draft'
          && createStamped()
          && updateStamped()
          // Lifecycle stamps cannot be forged at creation.
          && lifecycleUnstamped();

      // ADR-89: a client edits a DRAFT or voids a DRAFT. POSTING a receipt, and
      // voiding a POSTED one, are the trusted backend's — it records what each
      // allocation adds to its invoice's ledger, so a decision that depends on
      // receipts never has to scan them. A posted or void receipt admits no client write.
      allow update: if resource != null && financialMember(companyId) && corePreserved() && updateStamped()
          && resource.data.status == 'draft' && (
            // (a) DRAFT EDIT — content only; the status and lifecycle stamps cannot move.
            (
              request.resource.data.status == 'draft'
              && shapeValid()
              && lifecycleStampsFrozen()
            )
            ||
            // (b) DRAFT -> VOID (terminal) — no money moved, no ledger.
            (
              request.resource.data.status == 'void'
              && voidedWithReason()
            )
          );

      allow delete: if false;
    }

    // Supplier Payments — ADR-94 (Phase 2 step 4). Created, edited, posted and
    // voided ONLY by the trusted backend, which caps every allocation by what
    // remains payable on the invoice ledger (Deferred Control 18). No client
    // write. *As written before ADR-94:* create, draft edit, post and void were
    // client writes holding only the scalar allocation invariant.
    match /companies/{companyId}/projects/{projectId}/supplierPayments/{paymentId} {
      allow read: if financialMember(companyId);
      allow create, update, delete: if false;
    }

    // Supplier Credit Notes — ADR-94 (Phase 2 step 4). Created, edited, posted
    // and voided ONLY by the trusted backend through the invoice ledger: the
    // cumulative cap (Deferred Control 25), credits on retained invoices (G1)
    // and dependency-safe voids (G3). No client write. *As written before
    // ADR-94:* create, draft edit, post and void were client writes against a
    // get() of a zero-retention target invoice.
    match /companies/{companyId}/projects/{projectId}/supplierCreditNotes/{creditNoteId} {
      allow read: if financialMember(companyId);
      allow create, update, delete: if false;
    }

    // Cash Flow timing lines — authored monthly GROSS cash forecasts (planning
    // records: no counter, no posting); they never reference another financial
    // document — the cost-side link is the cost-code spine.
    match /companies/{companyId}/projects/{projectId}/cashFlowLines/{lineId} {
      function corePreserved() {
        return request.resource.data.currency  == resource.data.currency
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.basis     == resource.data.basis
            && request.resource.data.revision  == resource.data.revision;
      }
      // Shape required of every stored ACTIVE state (create and edit alike).
      function shapeValid() {
        return request.resource.data.basis == 'gross'
            && request.resource.data.revision == 1
            && request.resource.data.monthKey is string
            && request.resource.data.monthKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
            && request.resource.data.direction in ['in', 'out']
            // Positive gross cash only — a reduction is a line in the opposite
            // direction, never a negative amount.
            && request.resource.data.amount is number
            && request.resource.data.amount > 0
            // Ex-GST source coverage: null (manual lines) or a non-negative
            // number. Which types require which is client-enforced.
            && (request.resource.data.sourceAmountExGst == null
        || (request.resource.data.sourceAmountExGst is number
            && request.resource.data.sourceAmountExGst >= 0))
            && request.resource.data.sourceType is string
            && request.resource.data.sourceType.size() > 0
            && request.resource.data.sourceType.size() <= 40
            && request.resource.data.sourceRef is string
            && request.resource.data.counterpartyName is string
            // Cost-code spine: both null/'' together, or both real together.
            && ((request.resource.data.costCodeId == null
         && request.resource.data.costCodeName == '')
        || (request.resource.data.costCodeId is string
            && request.resource.data.costCodeId.size() > 0
            && request.resource.data.costCodeName is string
            && request.resource.data.costCodeName.size() > 0))
            && request.resource.data.description is string
            && request.resource.data.description.trim().size() > 0
            && request.resource.data.notes is string
            && currencyShaped();
      }

      allow read: if financialMember(companyId);

      allow create: if financialMember(companyId)
          && shapeValid()
          && request.resource.data.status == 'active'
          && createStamped()
          && updateStamped()
          // Void stamps cannot be forged at creation.
          && request.resource.data.voidedAt == null
          && request.resource.data.voidedBy == null;

      allow update: if financialMember(companyId) && corePreserved() && updateStamped() && (
            // (a) ACTIVE EDIT — content only; the status may not move and no void stamp
            //     may be forged.
            (
              resource.data.status == 'active'
              && request.resource.data.status == 'active'
              && shapeValid()
              && request.resource.data.voidedAt == resource.data.voidedAt
              && request.resource.data.voidedBy == resource.data.voidedBy
            )
            ||
            // (b) ACTIVE -> VOID (terminal) — void audit fields only; a voided line is
            //     immutable retained history.
            (
              resource.data.status == 'active'
              && voidedWithReason()
            )
          );

      allow delete: if false;
    }

    // Tender Packages — a named scope of cost codes put to market, TP-#### from
    // the company counters. No amounts and no currency — the money is on the bids.
    match /companies/{companyId}/projects/{projectId}/tenderPackages/{packageId} {
      function corePreserved() {
        return request.resource.data.tenderNumber == resource.data.tenderNumber
            && request.resource.data.createdAt    == resource.data.createdAt
            && request.resource.data.createdBy    == resource.data.createdBy
            && request.resource.data.revision     == resource.data.revision;
      }
      // '' (no closing date) or a YYYY-MM-DD shape. That the date is future,
      // past, or sane is NOT checked — it is informational only.
      function closingDateValid() {
        return request.resource.data.closingDate == ''
            || (request.resource.data.closingDate is string
        && request.resource.data.closingDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
      }
      // Shape required of every stored draft state (create and draft edit).
      function shapeValid() {
        return request.resource.data.tenderNumber is string
            && request.resource.data.tenderNumber.size() > 0
            && request.resource.data.revision == 1
            && request.resource.data.name is string
            && request.resource.data.name.trim().size() > 0
            && request.resource.data.description is string
            && request.resource.data.scope is string
            && request.resource.data.notes is string
            // ≥1 cost code — the cost-code spine; element shape is client-only.
            && request.resource.data.costCodes is list
            && request.resource.data.costCodes.size() >= 1
            && request.resource.data.costCodes.size() <= 100
            && closingDateValid();
      }
      // The awarded bid this award update points at.
      function awardedBid() {
        return get(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/tenderBids/$(request.resource.data.awardedBidId)).data;
      }
      // M3-A (ADR-61): the one CURRENT purchase order raised from this award.
      // Absent or null on every package until a PO is raised.
      function raisedPoPath(id) {
        return /databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/purchaseOrders/$(id);
      }
      function backlinkPreserved() {
        let d = request.resource.data;
        let p = resource.data;
        return d.get('raisedPoId', null) == p.get('raisedPoId', null)
            && d.get('raisedPoNumber', null) == p.get('raisedPoNumber', null)
            && d.get('raisedPoAt', null) == p.get('raisedPoAt', null)
            && d.get('raisedPoBy', null) == p.get('raisedPoBy', null);
      }
      // The PO this raise links, as it stands AFTER the commit (getAfter): a draft
      // CREATED IN THIS COMMIT, numbered as recorded, citing THIS package and bid.
      function raisedPoValid() {
        let d = request.resource.data;
        let po = getAfter(raisedPoPath(d.raisedPoId)).data;
        return d.raisedPoId is string
            && d.raisedPoId.size() > 0
            && d.raisedPoNumber is string
            && d.raisedPoNumber.size() > 0
            && d.raisedPoBy == request.auth.uid
            && d.raisedPoAt == request.time
            && po.status == 'draft'
            && po.createdAt == request.time
            && po.poNumber == d.raisedPoNumber
            && po.sourceTenderPackageId == packageId
            && po.sourceTenderBidId == resource.data.awardedBidId;
      }

      allow read: if financialMember(companyId);

      allow create: if financialMember(companyId)
          && shapeValid()
          && request.resource.data.status == 'draft'
          && stampedAtCreate()
          && createStamped()
          && updateStamped()
          // Lifecycle stamps and award/cancel fields cannot be forged
          // at creation.
          && request.resource.data.issuedAt == null
          && request.resource.data.issuedBy == null
          && request.resource.data.awardedAt == null
          && request.resource.data.awardedBy == null
          && request.resource.data.cancelledAt == null
          && request.resource.data.cancelledBy == null
          && request.resource.data.awardedBidId == null
          && request.resource.data.awardedBidderName == null
          && request.resource.data.awardNotes == ''
          && request.resource.data.cancelReason == ''
          // No PO link can be forged at creation (keys absent or null).
          && request.resource.data.get('raisedPoId', null) == null
          && request.resource.data.get('raisedPoNumber', null) == null
          && request.resource.data.get('raisedPoAt', null) == null
          && request.resource.data.get('raisedPoBy', null) == null;

      allow update: if financialMember(companyId) && corePreserved() && updateStamped() && (
            // (a) DRAFT EDIT — commercial content freely editable while draft; the status
            //     may not move and no stamp or award / cancel field may be forged.
            (
              resource.data.status == 'draft'
              && request.resource.data.status == 'draft'
              && shapeValid()
              && materialStamped(['name', 'description', 'scope', 'costCodes'])
              && request.resource.data.issuedAt == resource.data.issuedAt
              && request.resource.data.issuedBy == resource.data.issuedBy
              && request.resource.data.awardedAt == resource.data.awardedAt
              && request.resource.data.awardedBy == resource.data.awardedBy
              && request.resource.data.cancelledAt == resource.data.cancelledAt
              && request.resource.data.cancelledBy == resource.data.cancelledBy
              && request.resource.data.awardedBidId == resource.data.awardedBidId
              && request.resource.data.awardedBidderName == resource.data.awardedBidderName
              && request.resource.data.awardNotes == resource.data.awardNotes
              && request.resource.data.cancelReason == resource.data.cancelReason
              && backlinkPreserved()
            )
            ||
            // (b) DRAFT -> ISSUED — stamps only; the reviewed scope freezes here.
            (
              resource.data.status == 'draft'
              && request.resource.data.status == 'issued'
              && changedKeys().hasOnly(['status', 'issuedAt', 'issuedBy', 'updatedAt', 'updatedBy'])
              && request.resource.data.issuedBy == request.auth.uid
              && request.resource.data.issuedAt == request.time
            )
            ||
            // (c) ISSUED EDIT — the closingDate / notes carve-out ONLY; commercial scope
            //     stays frozen (extending an informational closing date must not force
            //     cancel-and-recreate).
            (
              resource.data.status == 'issued'
              && request.resource.data.status == 'issued'
              && changedKeys().hasOnly(['closingDate', 'notes', 'updatedAt', 'updatedBy'])
              && closingDateValid()
              && request.resource.data.notes is string
            )
            ||
            // (d) ISSUED -> AWARDED (terminal) — the decision record. The bid get() stops
            //     awarding a nonexistent, other-package, void or forged-bidder bid;
            //     requiring the CURRENT status 'issued' stops a second award.
            (
              resource.data.status == 'issued'
              && request.resource.data.status == 'awarded'
              && changedKeys().hasOnly(['status', 'awardedBidId', 'awardedBidderName', 'awardNotes', 'awardedAt', 'awardedBy', 'updatedAt', 'updatedBy'])
              && request.resource.data.awardedBy == request.auth.uid
              && independentOfStampedPreparers(companyId)
              && request.resource.data.awardedAt == request.time
              && request.resource.data.awardNotes is string
              && request.resource.data.awardedBidId is string
              && request.resource.data.awardedBidId.size() > 0
              && awardedBid().tenderPackageId == packageId
              && awardedBid().status == 'received'
              && request.resource.data.awardedBidderName == awardedBid().bidderName
            )
            ||
            // (e) DRAFT|ISSUED -> CANCELLED (terminal). Touches only the
            //     cancel audit fields, with a real reason.
            (
              (resource.data.status == 'draft' || resource.data.status == 'issued')
              && request.resource.data.status == 'cancelled'
              && changedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy', 'cancelReason', 'updatedAt', 'updatedBy'])
              && request.resource.data.cancelledBy == request.auth.uid
              && request.resource.data.cancelledAt == request.time
              && request.resource.data.cancelReason is string
              && request.resource.data.cancelReason.trim().size() > 0
            )
            ||
            // (f) RAISE PO (M3-A, ADR-61) — an AWARDED package records the ONE draft PO
            //     raised from it, only in the transaction that creates it (getAfter).
            (
              resource.data.status == 'awarded'
              && request.resource.data.status == 'awarded'
              && changedKeys().hasOnly(['raisedPoId', 'raisedPoNumber', 'raisedPoAt', 'raisedPoBy', 'updatedAt', 'updatedBy'])
              && resource.data.get('raisedPoId', null) == null
              && raisedPoValid()
            )
            ||
            // (g) RE-RAISE — only once the linked PO is CANCELLED (get()), never to the
            //     same PO; the cancelled PO keeps its source keys.
            (
              resource.data.status == 'awarded'
              && request.resource.data.status == 'awarded'
              && changedKeys().hasOnly(['raisedPoId', 'raisedPoNumber', 'raisedPoAt', 'raisedPoBy', 'updatedAt', 'updatedBy'])
              && resource.data.get('raisedPoId', null) is string
              && request.resource.data.raisedPoId != resource.data.raisedPoId
              && get(raisedPoPath(resource.data.raisedPoId)).data.status == 'cancelled'
              && raisedPoValid()
            )
          );

      allow delete: if false;
    }

    // Tender Bids — manual transcriptions of bids against an ISSUED package,
    // priced per cost code ex-GST. Random ids, no counter; project-level with a
    // tenderPackageId reference so rules verify containment via get().
    match /companies/{companyId}/projects/{projectId}/tenderBids/{bidId} {
      // The document identity that no update of any kind may rewrite: package
      // linkage, both frozen snapshots, bidder identity, currency, creation.
      function corePreserved() {
        return request.resource.data.tenderPackageId == resource.data.tenderPackageId
            && request.resource.data.tenderNumber    == resource.data.tenderNumber
            && request.resource.data.bidderContactId == resource.data.bidderContactId
            && request.resource.data.bidderName      == resource.data.bidderName
            && request.resource.data.currency        == resource.data.currency
            && request.resource.data.createdAt       == resource.data.createdAt
            && request.resource.data.createdBy       == resource.data.createdBy
            && request.resource.data.revision        == resource.data.revision;
      }
      // The parent package, from the SAME project path as this bid — so a bid
      // can never graft onto another project's (or company's) package.
      function parentPackage(pkgId) {
        return get(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/tenderPackages/$(pkgId)).data;
      }
      // The bidder contact named on a create.
      function bidderContact() {
        return get(/databases/$(database)/documents/companies/$(companyId)/contacts/$(request.resource.data.bidderContactId)).data;
      }
      // Shape required of every stored received state (create and edit alike).
      function shapeValid() {
        return request.resource.data.tenderPackageId is string
            && request.resource.data.tenderPackageId.size() > 0
            && request.resource.data.tenderNumber is string
            && request.resource.data.tenderNumber.size() > 0
            && request.resource.data.bidderContactId is string
            && request.resource.data.bidderContactId.size() > 0
            && request.resource.data.bidderName is string
            && request.resource.data.bidderName.size() > 0
            && request.resource.data.bidDate is string
            && request.resource.data.bidDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.bidderRef is string
            && request.resource.data.exclusions is string
            && request.resource.data.notes is string
            // ≥1 priced line; element shape is client-only (see block note).
            && request.resource.data.lineItems is list
            && request.resource.data.lineItems.size() >= 1
            && request.resource.data.lineItems.size() <= 100
            && currencyShaped()
            && request.resource.data.revision == 1;
      }

      allow read: if financialMember(companyId);

      allow create: if financialMember(companyId)
          && shapeValid()
          && request.resource.data.status == 'received'
          && createStamped()
          && updateStamped()
          // Void stamps cannot be forged at creation.
          && request.resource.data.voidedAt == null
          && request.resource.data.voidedBy == null
          && request.resource.data.voidReason == ''
          // Parent package must exist IN THIS PROJECT and be issued —
          // no bids on draft, awarded, or cancelled packages.
          && parentPackage(request.resource.data.tenderPackageId).status == 'issued'
          // The tenderNumber snapshot cannot be forged.
          && request.resource.data.tenderNumber == parentPackage(request.resource.data.tenderPackageId).tenderNumber
          // The bidder must be a real supplier/subcontractor contact in
          // this company, and the name snapshot must match it.
          && bidderContact().contactTypes.hasAny(['supplier', 'subcontractor'])
          && request.resource.data.bidderName == bidderContact().displayName;

      allow update: if financialMember(companyId) && corePreserved() && updateStamped() && (
            // (a) RECEIVED EDIT — transcription corrections while the parent package is
            //     STILL ISSUED; the status may not move and no void stamp may be forged.
            //     Once the package is awarded or cancelled, bids freeze.
            (
              resource.data.status == 'received'
              && request.resource.data.status == 'received'
              && shapeValid()
              && request.resource.data.voidedAt == resource.data.voidedAt
              && request.resource.data.voidedBy == resource.data.voidedBy
              && request.resource.data.voidReason == resource.data.voidReason
              && parentPackage(resource.data.tenderPackageId).status == 'issued'
            )
            ||
            // (b) RECEIVED -> VOID (terminal), only while the package is still issued;
            //     void audit fields only, with a real reason.
            (
              resource.data.status == 'received'
              && voidedWithReason()
              && parentPackage(resource.data.tenderPackageId).status == 'issued'
            )
          );

      allow delete: if false;
    }

    // Programme baseline HEADERS — Constrapp GANTT™ 1B (ADR-66). The lifecycle
    // record of one approved-programme baseline; its payload is the sibling
    // programmeBaselineSnapshots/{baselineId}, created in the SAME commit.
    match /companies/{companyId}/projects/{projectId}/programmeBaselines/{baselineId} {
      // Read audience — the programme's, includes qs.
      function baselineReader() {
        return sameCompany(companyId) && memberRole() in ['company_admin', 'project_manager', 'qs'];
      }
      // Capture AND approve audience — the programme writers; EXCLUDES qs.
      function baselineWriter() {
        return sameCompany(companyId) && memberRole() in ['company_admin', 'project_manager'];
      }
      function snapshotPath() {
        return /databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/programmeBaselineSnapshots/$(baselineId);
      }
      function text(v, n) {
        return v is string && v.trim().size() > 0 && v.size() <= n;
      }
      function exactKeys() {
        return request.resource.data.keys().hasOnly([
         'name', 'reason', 'status', 'activityCount',
         'approvedAt', 'approvedBy', 'withdrawnAt', 'withdrawnBy', 'withdrawReason',
         'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
               ])
            && request.resource.data.keys().hasAll([
         'name', 'reason', 'status', 'activityCount',
         'approvedAt', 'approvedBy', 'withdrawnAt', 'withdrawnBy', 'withdrawReason',
         'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
               ]);
      }
      // The captured identity no update of any kind may rewrite.
      function corePreserved() {
        return request.resource.data.name == resource.data.name
            && request.resource.data.reason == resource.data.reason
            && request.resource.data.activityCount == resource.data.activityCount
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.createdBy == resource.data.createdBy;
      }

      allow read: if baselineReader();

      // CAPTURE — born draft, revision 1, caller + server stamps, with the snapshot
      // written in the same commit (getAfter: same caller, time and activityCount).
      allow create: if baselineWriter()
          && exactKeys()
          && text(request.resource.data.name, 120)
          && text(request.resource.data.reason, 500)
          && request.resource.data.status == 'draft'
          && request.resource.data.activityCount is int
          && request.resource.data.activityCount >= 1
          && request.resource.data.activityCount <= 2000
          && request.resource.data.approvedAt == null
          && request.resource.data.approvedBy == null
          && request.resource.data.withdrawnAt == null
          && request.resource.data.withdrawnBy == null
          && request.resource.data.withdrawReason == ''
          && request.resource.data.revision == 1
          && createStamped()
          && updateStamped()
          && getAfter(snapshotPath()).data.activityCount == request.resource.data.activityCount
          && getAfter(snapshotPath()).data.capturedBy == request.auth.uid
          && getAfter(snapshotPath()).data.capturedAt == request.time;

      // The ONLY updates: draft → approved | withdrawn, stamps-only with revision + 1.
      // Both are terminal, so an approved baseline is immutable history.
      allow update: if baselineWriter() && corePreserved() && updateStamped() && revisionIncremented()
          && resource.data.status == 'draft'
          && (
            (
              request.resource.data.status == 'approved'
              && changedKeys().hasOnly(['status', 'approvedAt', 'approvedBy', 'revision', 'updatedAt', 'updatedBy'])
              && request.resource.data.approvedBy == request.auth.uid
              && request.resource.data.approvedAt == request.time
            )
            ||
            (
              request.resource.data.status == 'withdrawn'
              && changedKeys().hasOnly(['status', 'withdrawnAt', 'withdrawnBy', 'withdrawReason', 'revision', 'updatedAt', 'updatedBy'])
              && request.resource.data.withdrawnBy == request.auth.uid
              && request.resource.data.withdrawnAt == request.time
              && text(request.resource.data.withdrawReason, 500)
            )
          );

      allow delete: if false;
    }

    // Programme baseline SNAPSHOTS — Constrapp GANTT™ 1B (ADR-66). ONE
    // immutable document per baseline: a bounded list of minimal activity
    // entries (dates, status, progress, revision, order, cost-code key — no
    // financial field). Create-only, paired with its header; never updated,
    // never deleted. Rules pin the list size and the FIRST and LAST entries
    // only (DC42).
    match /companies/{companyId}/projects/{projectId}/programmeBaselineSnapshots/{baselineId} {
      function snapshotReader() {
        return sameCompany(companyId) && memberRole() in ['company_admin', 'project_manager', 'qs'];
      }
      function snapshotWriter() {
        return sameCompany(companyId) && memberRole() in ['company_admin', 'project_manager'];
      }
      function headerPath() {
        return /databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/programmeBaselines/$(baselineId);
      }
      // ONE entry: exact keys, a real activity in THIS project (one read), the ADR-29
      // date / milestone invariants, the status set, bounded progress, revision, order.
      function entryValid(e) {
        return e is map
            && e.keys().hasOnly(['activityId', 'name', 'isMilestone', 'plannedStart', 'plannedFinish', 'status', 'percentComplete', 'revision', 'sortOrder', 'costCodeId'])
            && e.keys().hasAll(['activityId', 'name', 'isMilestone', 'plannedStart', 'plannedFinish', 'status', 'percentComplete', 'revision', 'sortOrder', 'costCodeId'])
            && e.activityId is string
            && e.activityId.size() > 0
            && e.name is string
            && e.name.trim().size() > 0
            && e.name.size() <= 120
            && e.isMilestone is bool
            && isIsoDate(e.plannedStart)
            && isIsoDate(e.plannedFinish)
            && e.plannedFinish >= e.plannedStart
            && (!e.isMilestone || e.plannedFinish == e.plannedStart)
            && e.status in ['not_started', 'in_progress', 'on_hold', 'completed', 'cancelled']
            && e.percentComplete is int
            && e.percentComplete >= 0
            && e.percentComplete <= 100
            && e.revision is int
            && e.revision >= 1
            && e.sortOrder is number
            && (e.costCodeId == null || (e.costCodeId is string && e.costCodeId.size() > 0))
            && exists(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/activities/$(e.activityId));
      }
      function activitiesValid() {
        let a = request.resource.data.activities;
        return a is list
            && a.size() >= 1
            && a.size() <= 2000
            && a.size() == request.resource.data.activityCount
            && entryValid(a[0])
            && entryValid(a[a.size() - 1]);
      }

      allow read: if snapshotReader();

      // Created ONLY together with its draft header: same caller, same
      // server time, same activityCount (getAfter).
      allow create: if snapshotWriter()
          && request.resource.data.keys().hasOnly(['activityCount', 'capturedAt', 'capturedBy', 'activities'])
          && request.resource.data.keys().hasAll(['activityCount', 'capturedAt', 'capturedBy', 'activities'])
          && request.resource.data.activityCount is int
          && request.resource.data.capturedBy == request.auth.uid
          && request.resource.data.capturedAt == request.time
          && activitiesValid()
          && getAfter(headerPath()).data.status == 'draft'
          && getAfter(headerPath()).data.activityCount == request.resource.data.activityCount
          && getAfter(headerPath()).data.createdBy == request.auth.uid
          && getAfter(headerPath()).data.createdAt == request.time;

      // IMMUTABLE. No update of any kind, no delete.
      allow update: if false;
      allow delete: if false;
    }

    // Project Timeline activities — the project programme (ADR-29; ADR-65
    // predecessors + revision contract).
    match /companies/{companyId}/projects/{projectId}/activities/{activityId} {
      // Read audience — includes qs.
      function programmeReader() {
        return sameCompany(companyId) && memberRole() in ['company_admin', 'project_manager', 'qs'];
      }
      // Write audience — deliberately EXCLUDES qs.
      function programmeWriter() {
        return sameCompany(companyId) && memberRole() in ['company_admin', 'project_manager'];
      }
      function corePreserved() {
        return request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.createdBy == resource.data.createdBy;
      }
      // EXACT shape — hasOnly + hasAll (the ADR-27 lesson). `predecessors` (ADR-65) is
      // OPTIONAL: admitted by hasOnly, not required by hasAll (pre-1A2 documents pass).
      function exactKeys() {
        return request.resource.data.keys().hasOnly([
         'name', 'description', 'isMilestone', 'status',
         'plannedStart', 'plannedFinish', 'actualStart', 'actualFinish',
         'percentComplete', 'responsibleContactId', 'responsibleName',
         'costCodeId', 'costCodeName', 'sortOrder', 'notes', 'predecessors',
         'cancelReason', 'cancelledAt', 'cancelledBy',
         'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
               ])
            && request.resource.data.keys().hasAll([
         'name', 'description', 'isMilestone', 'status',
         'plannedStart', 'plannedFinish', 'actualStart', 'actualFinish',
         'percentComplete', 'responsibleContactId', 'responsibleName',
         'costCodeId', 'costCodeName', 'sortOrder', 'notes',
         'cancelReason', 'cancelledAt', 'cancelledBy',
         'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
               ]);
      }
      // ONE predecessor entry (ADR-65): exact keys, a non-empty id that is not this
      // activity, FS only, integer lag 0..365, source must EXIST in THIS project.
      // Applied to the FIRST and LAST entries only — the honest ceiling (DC41).
      function predecessorEntryValid(e) {
        return e is map
            && e.keys().hasOnly(['activityId', 'type', 'lagDays'])
            && e.keys().hasAll(['activityId', 'type', 'lagDays'])
            && e.activityId is string
            && e.activityId.size() > 0
            && e.activityId != activityId
            && e.type == 'FS'
            && e.lagDays is int
            && e.lagDays >= 0
            && e.lagDays <= 365
            && exists(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/activities/$(e.activityId));
      }
      function predecessorsValid() {
        let p = request.resource.data.get('predecessors', []);
        return p is list
            && p.size() <= 20
            && (p.size() == 0
        || (predecessorEntryValid(p[0]) && predecessorEntryValid(p[p.size() - 1])));
      }
      // Shape of every stored NON-CANCELLED state; `revision` is checked by the
      // create / update rules (1 at create, +1 on update — ADR-65), not here.
      function shapeValid() {
        return exactKeys()
            && request.resource.data.revision is int
            && predecessorsValid()
            && request.resource.data.name is string
            && request.resource.data.name.trim().size() > 0
            && request.resource.data.name.size() <= 120
            && request.resource.data.description is string
            && request.resource.data.description.size() <= 500
            && request.resource.data.notes is string
            && request.resource.data.notes.size() <= 500
            && request.resource.data.isMilestone is bool
            // Closed status set; `cancelled` is reachable only via the branch
            // below, so it is excluded from every ordinary write.
            && request.resource.data.status in ['not_started', 'in_progress', 'on_hold', 'completed']
            // Programme dates are DATE-ONLY strings. The finish is INCLUSIVE,
            // and string comparison is exact for zero-padded ISO.
            && isIsoDate(request.resource.data.plannedStart)
            && isIsoDate(request.resource.data.plannedFinish)
            && request.resource.data.plannedFinish >= request.resource.data.plannedStart
            // A milestone is a point in time, not a one-day activity.
            && (!request.resource.data.isMilestone
        || request.resource.data.plannedFinish == request.resource.data.plannedStart)
            && (request.resource.data.actualStart == null
        || isIsoDate(request.resource.data.actualStart))
            && (request.resource.data.actualFinish == null
        || isIsoDate(request.resource.data.actualFinish))
            && (request.resource.data.actualStart == null
        || request.resource.data.actualFinish == null
        || request.resource.data.actualFinish >= request.resource.data.actualStart)
            // Manually authored progress — bounded whole percent.
            && request.resource.data.percentComplete is int
            && request.resource.data.percentComplete >= 0
            && request.resource.data.percentComplete <= 100
            && (!request.resource.data.isMilestone
        || request.resource.data.percentComplete == 0
        || request.resource.data.percentComplete == 100)
            // Status invariants — status, progress and actual dates may not
            // contradict each other.
            && (request.resource.data.status != 'not_started'
        || (request.resource.data.percentComplete == 0
            && request.resource.data.actualStart == null
            && request.resource.data.actualFinish == null))
            && (request.resource.data.status != 'in_progress'
        || request.resource.data.actualStart != null)
            && (request.resource.data.status != 'completed'
        || (request.resource.data.percentComplete == 100
            && request.resource.data.actualFinish != null))
            // Responsible party: a Contacts link with a FROZEN name snapshot — both empty
            // or both real. Never a user account (users/{uid} is client-read-only, ADR-27).
            && ((request.resource.data.responsibleContactId == null
         && request.resource.data.responsibleName == '')
        || (request.resource.data.responsibleContactId is string
            && request.resource.data.responsibleContactId.size() > 0
            && request.resource.data.responsibleName is string
            && request.resource.data.responsibleName.trim().size() > 0
            && request.resource.data.responsibleName.size() <= 120))
            // Cost-code spine: the same both-or-neither idiom.
            && ((request.resource.data.costCodeId == null
         && request.resource.data.costCodeName == '')
        || (request.resource.data.costCodeId is string
            && request.resource.data.costCodeId.size() > 0
            && request.resource.data.costCodeName is string
            && request.resource.data.costCodeName.trim().size() > 0
            && request.resource.data.costCodeName.size() <= 120))
            && request.resource.data.sortOrder is number;
      }

      allow read: if programmeReader();

      allow create: if programmeWriter()
          && shapeValid()
          && request.resource.data.revision == 1
          && createStamped()
          && updateStamped()
          // Cancellation cannot be forged at creation.
          && request.resource.data.cancelReason == ''
          && request.resource.data.cancelledAt == null
          && request.resource.data.cancelledBy == null;

      // Every update carries EXACTLY the next revision (ADR-65): a blind write
      // that does not know the stored revision is refused by the RULES. The
      // Stage-1 transitional ruleset relaxes this ONE line while the 1A1
      // bundle is still served (scripts/build-transitional-rules.mjs).
      allow update: if programmeWriter() && corePreserved() && updateStamped()
          && revisionIncremented() // ADR-65 FINAL: revision +1 is REQUIRED on every activity update
          && (
            // (a) ORDINARY EDIT — content and status freely editable, INCLUDING BACKWARDS,
            //     while not cancelled; no cancellation stamp may be forged.
            (
              resource.data.status != 'cancelled'
              && shapeValid()
              && request.resource.data.cancelReason == resource.data.cancelReason
              && request.resource.data.cancelledAt == resource.data.cancelledAt
              && request.resource.data.cancelledBy == resource.data.cancelledBy
            )
            ||
            // (b) CANCELLATION (terminal) — the only exit; cancellation audit fields only,
            //     so a cancelled activity is immutable retained history.
            (
              resource.data.status != 'cancelled'
              && request.resource.data.status == 'cancelled'
              && changedKeys().hasOnly(['status', 'cancelReason', 'cancelledAt', 'cancelledBy', 'revision', 'updatedAt', 'updatedBy'])
              && request.resource.data.cancelledBy == request.auth.uid
              && request.resource.data.cancelledAt == request.time
              && request.resource.data.cancelReason is string
              && request.resource.data.cancelReason.trim().size() > 0
              && request.resource.data.cancelReason.size() <= 500
            )
          );

      allow delete: if false;
    }

    // Retention Releases — ADR-94 (Phase 2 step 4). Created, edited, posted and
    // voided ONLY by the trusted backend through the invoice ledger: the
    // cumulative cap (Deferred Control 24), GST as a share of the stored
    // retention GST (ADR-91 Decision 4) and dependency-safe voids (G3). No
    // client write. *As written before ADR-94:* create, draft edit, post and
    // void were client writes with a per-document cap.
    match /companies/{companyId}/projects/{projectId}/retentionReleases/{releaseId} {
      allow read: if financialMember(companyId);
      allow create, update, delete: if false;
    }

    // ── Drawings — a MASTER is the stable identity of a sheet; its `revisions`
    // subcollection holds the immutable issues; the master points at the current one.
    match /companies/{companyId}/projects/{projectId}/drawings/{drawingId} {
      function drawingWriter() {
        return sameCompany(companyId)
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['company_admin', 'project_manager'];
      }
      function masterCorePreserved() {
        return request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.revisionSchemaVersion == resource.data.revisionSchemaVersion;
      }
      // Authored identity, validated identically at create and at edit.
      function identityShape() {
        return request.resource.data.drawingNumber is string
            && request.resource.data.drawingNumber.trim().size() > 0
            && request.resource.data.drawingNumber.size() <= 60
            && request.resource.data.title is string
            && request.resource.data.title.trim().size() > 0
            && request.resource.data.title.size() <= 200
            && request.resource.data.discipline in ['architectural', 'structural', 'civil', 'mechanical', 'electrical', 'hydraulic', 'landscape', 'other']
            && request.resource.data.description is string
            && request.resource.data.description.size() <= 2000;
      }

      allow read: if projectReader(companyId, projectId);

      allow create: if drawingWriter()
          && identityShape()
          && request.resource.data.status == 'active'
          // Born empty — the first revision is promoted afterwards.
          && request.resource.data.currentRevisionId == null
          && request.resource.data.currentRevisionCode == ''
          && request.resource.data.currentRevisionIssuedDate == null
          && request.resource.data.revisionCount == 0
          && request.resource.data.revisionSchemaVersion == 1
          && request.resource.data.withdrawnAt == null
          && request.resource.data.withdrawnBy == null
          && request.resource.data.withdrawReason == ''
          && createStamped()
          && updateStamped();

      allow update: if drawingWriter() && masterCorePreserved() && updateStamped() && (
            // (a) IDENTITY EDIT — number/title/discipline/description.
            //     The pointer, the count, and the status stay put.
            (
              resource.data.status == 'active'
              && changedKeys().hasOnly(['drawingNumber', 'title', 'discipline', 'description', 'updatedAt', 'updatedBy'])
              && identityShape()
            )
            ||
            // (b) PROMOTION — a newly issued revision becomes current; revisionCount moves
            //     by EXACTLY +1 (revisionSequence stays dense and monotonic).
            (
              resource.data.status == 'active'
              && changedKeys().hasOnly(['currentRevisionId', 'currentRevisionCode', 'currentRevisionIssuedDate', 'revisionCount', 'updatedAt', 'updatedBy'])
              && request.resource.data.revisionCount == resource.data.revisionCount + 1
              && request.resource.data.currentRevisionId is string
              && request.resource.data.currentRevisionId.size() > 0
              && request.resource.data.currentRevisionCode is string
              && request.resource.data.currentRevisionCode.size() > 0
              && request.resource.data.currentRevisionIssuedDate is string
              && request.resource.data.currentRevisionIssuedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            )
            ||
            // (c) REINSTATEMENT — the current revision is withdrawn and an earlier one
            //     EXPLICITLY nominated: the pointer must move and the count must not
            //     (reinstating is not issuing), and a current revision must ALREADY exist
            //     so `revisionCount` stays the sequence high-water mark that
            //     revisionSequence is derived from.
            (
              resource.data.status == 'active'
              && resource.data.currentRevisionId != null
              && changedKeys().hasOnly(['currentRevisionId', 'currentRevisionCode', 'currentRevisionIssuedDate', 'updatedAt', 'updatedBy'])
              && request.resource.data.currentRevisionId is string
              && request.resource.data.currentRevisionId.size() > 0
              && request.resource.data.currentRevisionId != resource.data.currentRevisionId
              && request.resource.data.currentRevisionCode is string
              && request.resource.data.currentRevisionCode.size() > 0
              && request.resource.data.currentRevisionIssuedDate is string
              && request.resource.data.currentRevisionIssuedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            )
            ||
            // (d) WITHDRAWAL (terminal) — the master is recalled with NO current revision
            //     (current withdrawn with no replacement, or an empty master retired).
            (
              resource.data.status == 'active'
              && request.resource.data.status == 'withdrawn'
              && changedKeys().hasOnly(['status', 'currentRevisionId', 'currentRevisionCode', 'currentRevisionIssuedDate', 'withdrawnAt', 'withdrawnBy', 'withdrawReason', 'updatedAt', 'updatedBy'])
              && request.resource.data.currentRevisionId == null
              && request.resource.data.currentRevisionCode == ''
              && request.resource.data.currentRevisionIssuedDate == null
              && request.resource.data.withdrawnBy == request.auth.uid
              && request.resource.data.withdrawnAt == request.time
              && request.resource.data.withdrawReason is string
              && request.resource.data.withdrawReason.trim().size() > 0
            )
          );

      allow delete: if false;

      // ── Drawing revisions (immutable issues) — the helper functions above are in
      // scope here (functions declared in an outer match are visible to nested matches).
      match /revisions/{revisionId} {
        // The one storage path this revision may claim, built from the path segments
        // (never another tenant, project, drawing or a caller-chosen filename).
        function expectedStoragePath() {
          return 'companies/' + companyId
               + '/projects/' + projectId
               + '/drawings/' + drawingId
               + '/' + revisionId
               + '/original.' + request.resource.data.fileExt;
        }
        // Content type and stored extension must agree — the extension is what
        // the Storage object is named, so a disagreement means the object name
        // lies about its own bytes.
        function fileShape() {
          return request.resource.data.fileName is string
              && request.resource.data.fileName.size() > 0
              && request.resource.data.fileName.size() <= 255
              && request.resource.data.fileSize is int
              && request.resource.data.fileSize > 0
              && request.resource.data.fileSize <= 52428800
              && (
           (request.resource.data.contentType == 'application/pdf' && request.resource.data.fileExt == 'pdf')
        || (request.resource.data.contentType == 'image/png'       && request.resource.data.fileExt == 'png')
        || (request.resource.data.contentType == 'image/jpeg'      && request.resource.data.fileExt == 'jpg')
         )
              && request.resource.data.storagePath == expectedStoragePath();
        }

        allow read: if projectReader(companyId, projectId);

        // Every revision is born CURRENT — it is created by the promotion
        // transaction, which supersedes the previous current in the same commit.
        allow create: if drawingWriter()
            && request.resource.data.revisionCode is string
            && request.resource.data.revisionCode.trim().size() > 0
            && request.resource.data.revisionCode.size() <= 12
            && request.resource.data.revisionSequence is int
            && request.resource.data.revisionSequence > 0
            && request.resource.data.revisionDate is string
            && request.resource.data.revisionDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.status == 'current'
            && request.resource.data.notes is string
            && request.resource.data.notes.size() <= 2000
            && fileShape()
            // Reserved for a future takeoff module — never authored here.
            && request.resource.data.pageCount == null
            && request.resource.data.sheetSize == ''
            // No lifecycle stamp can be forged at creation.
            && request.resource.data.supersededAt == null
            && request.resource.data.supersededBy == null
            && request.resource.data.supersededByRevisionId == null
            && request.resource.data.withdrawnAt == null
            && request.resource.data.withdrawnBy == null
            && request.resource.data.withdrawReason == ''
            && request.resource.data.revision == 1
            && createStamped()
            && updateStamped();

        // Each branch is `hasOnly`-restricted to its own stamps, which is what
        // makes the file identity and the authored identity IMMUTABLE.
        allow update: if drawingWriter() && updateStamped() && (
              // (a) CURRENT -> SUPERSEDED, when a newer revision is issued.
              (
                resource.data.status == 'current'
                && request.resource.data.status == 'superseded'
                && changedKeys().hasOnly(['status', 'supersededAt', 'supersededBy', 'supersededByRevisionId', 'updatedAt', 'updatedBy'])
                && request.resource.data.supersededBy == request.auth.uid
                && request.resource.data.supersededAt == request.time
                && request.resource.data.supersededByRevisionId is string
                && request.resource.data.supersededByRevisionId.size() > 0
                && request.resource.data.supersededByRevisionId != revisionId
              )
              ||
              // (b) SUPERSEDED -> CURRENT — the explicit reinstatement half of withdrawing a
              //     current revision; supersession stamps cleared, never rewritten.
              (
                resource.data.status == 'superseded'
                && request.resource.data.status == 'current'
                && changedKeys().hasOnly(['status', 'supersededAt', 'supersededBy', 'supersededByRevisionId', 'updatedAt', 'updatedBy'])
                && request.resource.data.supersededAt == null
                && request.resource.data.supersededBy == null
                && request.resource.data.supersededByRevisionId == null
              )
              ||
              // (c) -> WITHDRAWN (terminal), from current or superseded,
              //     with a NON-WHITESPACE reason.
              (
                resource.data.status in ['current', 'superseded']
                && request.resource.data.status == 'withdrawn'
                && changedKeys().hasOnly(['status', 'withdrawnAt', 'withdrawnBy', 'withdrawReason', 'updatedAt', 'updatedBy'])
                && request.resource.data.withdrawnBy == request.auth.uid
                && request.resource.data.withdrawnAt == request.time
                && request.resource.data.withdrawReason is string
                && request.resource.data.withdrawReason.trim().size() > 0
              )
            );

        allow delete: if false;
      }
    }

    // ── General Project Documents — the flat non-drawing register; a replacement
    // is a NEW record and the old one is superseded with a forward link.
    match /companies/{companyId}/projects/{projectId}/documents/{documentId} {
      // Roles that may write documents AND read `internal` ones. The two sets
      // coincide by definition: "internal" means visible to the people who
      // administer the register.
      function internalMember() {
        return sameCompany(companyId)
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['company_admin', 'project_manager', 'qs'];
      }
      function docCorePreserved() {
        return request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.revision  == resource.data.revision;
      }
      function metadataShape() {
        return request.resource.data.name is string
            && request.resource.data.name.trim().size() > 0
            && request.resource.data.name.size() <= 200
            && request.resource.data.category in ['specification', 'contract', 'subcontract', 'report', 'certificate', 'safety', 'schedule', 'manual', 'correspondence', 'other']
            && request.resource.data.visibility in ['project', 'internal']
            && request.resource.data.versionLabel is string
            && request.resource.data.versionLabel.size() <= 40
            && (request.resource.data.documentDate == null
        || (request.resource.data.documentDate is string
            && request.resource.data.documentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
            && request.resource.data.notes is string
            && request.resource.data.notes.size() <= 2000;
      }
      function expectedStoragePath() {
        return 'companies/' + companyId
             + '/projects/' + projectId
             + '/documents/' + documentId
             + '/original.' + request.resource.data.fileExt;
      }
      function fileShape() {
        return request.resource.data.fileName is string
            && request.resource.data.fileName.size() > 0
            && request.resource.data.fileName.size() <= 255
            && request.resource.data.fileSize is int
            && request.resource.data.fileSize > 0
            && request.resource.data.fileSize <= 26214400
            && (
         (request.resource.data.contentType == 'application/pdf' && request.resource.data.fileExt == 'pdf')
              || (request.resource.data.contentType == 'image/png'       && request.resource.data.fileExt == 'png')
              || (request.resource.data.contentType == 'image/jpeg'      && request.resource.data.fileExt == 'jpg')
               )
            && request.resource.data.storagePath == expectedStoragePath();
      }

      allow read: if internalMember()
          || (projectReader(companyId, projectId) && resource.data.visibility == 'project' && resource.data.status == 'active');

      allow create: if internalMember()
          && metadataShape()
          && fileShape()
          && request.resource.data.status == 'active'
          && request.resource.data.supersededByDocumentId == null
          && request.resource.data.withdrawnAt == null
          && request.resource.data.withdrawnBy == null
          && request.resource.data.withdrawReason == ''
          && request.resource.data.revision == 1
          && createStamped()
          && updateStamped();

      allow update: if internalMember() && docCorePreserved() && updateStamped() && (
            // (a) METADATA EDIT — the file is never re-pointed.
            (
              resource.data.status == 'active'
              && changedKeys().hasOnly(['name', 'category', 'visibility', 'versionLabel', 'documentDate', 'notes', 'updatedAt', 'updatedBy'])
              && metadataShape()
              // ADR-75: no client may reduce visibility (project -> internal).
              && (resource.data.visibility == 'internal' || request.resource.data.visibility == 'project')
            )
            ||
            // (b) ACTIVE -> SUPERSEDED, linking forward to the record
            //     that replaces it. Both files are preserved.
            (
              resource.data.status == 'active'
              && request.resource.data.status == 'superseded'
              && changedKeys().hasOnly(['status', 'supersededByDocumentId', 'updatedAt', 'updatedBy'])
              && request.resource.data.supersededByDocumentId is string
              && request.resource.data.supersededByDocumentId.size() > 0
              && request.resource.data.supersededByDocumentId != documentId
            )
            ||
            // (c) -> WITHDRAWN (terminal), with a NON-WHITESPACE reason.
            (
              resource.data.status in ['active', 'superseded']
              && request.resource.data.status == 'withdrawn'
              && changedKeys().hasOnly(['status', 'withdrawnAt', 'withdrawnBy', 'withdrawReason', 'updatedAt', 'updatedBy'])
              && request.resource.data.withdrawnBy == request.auth.uid
              && request.resource.data.withdrawnAt == request.time
              && request.resource.data.withdrawReason is string
              && request.resource.data.withdrawReason.trim().size() > 0
            )
          );

      allow delete: if false;
    }

    // RFIs — Requests for Information (ADR-33): who asked what, of whom, against
    // which drawing revision or document, when due, and the answer.
    match /companies/{companyId}/projects/{projectId}/rfis/{rfiId} {
      // One audience for reads and writes.
      function rfiMember() {
        return sameCompany(companyId) && memberRole() in ['company_admin', 'project_manager', 'qs'];
      }
      function corePreserved() {
        return request.resource.data.rfiNumber == resource.data.rfiNumber
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.revision  == resource.data.revision;
      }
      // ⚠️ EXPRESSION BUDGET (1000 per request): this block validates ~34 fields plus
      // two existence lookups, so every shape helper takes the candidate map `d` ONCE
      // and the exact-key check is `hasAll` + `size()` (no field may be added,
      // renamed or omitted — the ADR-27 lesson). Do not "tidy" these back into the
      // longer form.
      function exactKeys(d) {
        return d.keys().hasAll([
         'rfiNumber', 'status',
         'title', 'question', 'raisedDate', 'raisedByName',
         'referenceType', 'referenceDrawingId', 'referenceRevisionId', 'referenceDocumentId',
         'referenceLabel', 'referenceRevisionCode',
         'costCodeId', 'costCodeName',
         'assignedToContactId', 'assignedToName', 'dueDate',
         'raisedAt', 'raisedBy',
         'answer', 'answerDate', 'answeredAt', 'answeredBy',
         'closeOutNote', 'closedAt', 'closedBy',
         'cancelReason', 'cancelledAt', 'cancelledBy',
         'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
               ])
            && d.size() == 34;
      }
      function nonBlank(v, max) {
        return v is string && v.trim().size() > 0 && v.size() <= max;
      }
      // The reference — shape AND existence.
      function referenceValid(d) {
        return (
         d.referenceType == 'none'
         && d.referenceDrawingId == null
         && d.referenceRevisionId == null
         && d.referenceDocumentId == null
         && d.referenceLabel == ''
         && d.referenceRevisionCode == ''
               )
            || (
         d.referenceType == 'drawing'
         && d.referenceDrawingId is string
         && d.referenceDrawingId.size() > 0
         && d.referenceRevisionId is string
         && d.referenceRevisionId.size() > 0
         && d.referenceDocumentId == null
         && nonBlank(d.referenceLabel, 200)
         && nonBlank(d.referenceRevisionCode, 40)
         && exists(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/drawings/$(d.referenceDrawingId))
         && exists(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/drawings/$(d.referenceDrawingId)/revisions/$(d.referenceRevisionId))
               )
            || (
         d.referenceType == 'document'
         && d.referenceDocumentId is string
         && d.referenceDocumentId.size() > 0
         && d.referenceDrawingId == null
         && d.referenceRevisionId == null
         && nonBlank(d.referenceLabel, 200)
         && d.referenceRevisionCode == ''
         && exists(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/documents/$(d.referenceDocumentId))
               );
      }
      // The question block — validated at create and at draft edit.
      function questionShape(d) {
        return nonBlank(d.title, 200)
            && nonBlank(d.question, 5000)
            && isIsoDate(d.raisedDate)
            && nonBlank(d.raisedByName, 120)
            && referenceValid(d)
            // Cost-code spine: both-or-neither.
            && ((d.costCodeId == null && d.costCodeName == '')
        || (d.costCodeId is string && d.costCodeId.size() > 0
            && nonBlank(d.costCodeName, 120)));
      }
      // The management block — assignee (a CONTACT, never a user — ADR-27)
      // with a frozen name snapshot, both-or-neither; optional due date not
      // before the raised date.
      function managementShape(d) {
        return ((d.assignedToContactId == null && d.assignedToName == '')
        || (d.assignedToContactId is string && d.assignedToContactId.size() > 0
            && nonBlank(d.assignedToName, 120)))
            && (d.dueDate == null
        || (isIsoDate(d.dueDate) && d.dueDate >= d.raisedDate));
      }
      // Every lifecycle stamp empty — required at create. Preserved through
      // the draft phase by the draft-edit allow-list, which cannot touch them.
      function noLifecycleStamps(d) {
        return d.raisedAt == null && d.raisedBy == null
            && d.answer == '' && d.answerDate == null
            && d.answeredAt == null && d.answeredBy == null
            && d.closeOutNote == '' && d.closedAt == null && d.closedBy == null
            && d.cancelReason == '' && d.cancelledAt == null && d.cancelledBy == null;
      }
      // Raise gate AND the standing invariant of every OPEN RFI: a real assignee and
      // a real due date — changeable on an open management edit, never cleared.
      function raiseReady(d) {
        return d.assignedToContactId is string
            && d.assignedToContactId.size() > 0
            && nonBlank(d.assignedToName, 120)
            && isIsoDate(d.dueDate);
      }

      allow read: if rfiMember();

      allow create: if rfiMember()
          && exactKeys(request.resource.data)
          && request.resource.data.revision == 1
          && request.resource.data.status == 'draft'
          && request.resource.data.rfiNumber is string
          && request.resource.data.rfiNumber.matches('^RFI-[0-9]{4,}$')
          && questionShape(request.resource.data)
          && managementShape(request.resource.data)
          && noLifecycleStamps(request.resource.data)
          && createStamped()
          && updateStamped();

      allow update: if rfiMember() && corePreserved() && updateStamped() && (
            // (a) DRAFT EDIT — question block, reference, cost code, assignee and due date
            //     editable; the hasOnly allow-list keeps the status, the number and every
            //     lifecycle stamp fixed, so no stamp can be forged and no key added.
            (
              resource.data.status == 'draft'
              && changedKeys().hasOnly([
                   'title', 'question', 'raisedDate', 'raisedByName',
                   'referenceType', 'referenceDrawingId', 'referenceRevisionId', 'referenceDocumentId',
                   'referenceLabel', 'referenceRevisionCode',
                   'costCodeId', 'costCodeName',
                   'assignedToContactId', 'assignedToName', 'dueDate',
                   'updatedAt', 'updatedBy'
                 ])
              && questionShape(request.resource.data)
              && managementShape(request.resource.data)
            )
            ||
            // (b) RAISE — draft → open; needs an assignee and a due date ALREADY on the
            //     stored draft. Status and raise stamps only — the question block freezes.
            (
              resource.data.status == 'draft'
              && request.resource.data.status == 'open'
              && changedKeys().hasOnly(['status', 'raisedAt', 'raisedBy', 'updatedAt', 'updatedBy'])
              && raiseReady(request.resource.data)
              && request.resource.data.raisedBy == request.auth.uid
              && request.resource.data.raisedAt == request.time
            )
            ||
            // (c) OPEN MANAGEMENT EDIT — assignee and due date ONLY; reassign and re-date
            //     are allowed, CLEARING either is not (raiseReady()).
            (
              resource.data.status == 'open'
              && changedKeys().hasOnly(['assignedToContactId', 'assignedToName', 'dueDate', 'updatedAt', 'updatedBy'])
              && managementShape(request.resource.data)
              && raiseReady(request.resource.data)
            )
            ||
            // (d) ANSWER — open → answered. Non-whitespace answer,
            //     authored answerDate >= raisedDate, stamps only.
            (
              resource.data.status == 'open'
              && request.resource.data.status == 'answered'
              && changedKeys().hasOnly(['status', 'answer', 'answerDate', 'answeredAt', 'answeredBy', 'updatedAt', 'updatedBy'])
              && nonBlank(request.resource.data.answer, 5000)
              && isIsoDate(request.resource.data.answerDate)
              && request.resource.data.answerDate >= resource.data.raisedDate
              && request.resource.data.answeredBy == request.auth.uid
              && request.resource.data.answeredAt == request.time
            )
            ||
            // (e) CLOSE — answered → closed (terminal). Optional
            //     close-out note; stamps only.
            (
              resource.data.status == 'answered'
              && request.resource.data.status == 'closed'
              && changedKeys().hasOnly(['status', 'closeOutNote', 'closedAt', 'closedBy', 'updatedAt', 'updatedBy'])
              && request.resource.data.closeOutNote is string
              && request.resource.data.closeOutNote.size() <= 1000
              && request.resource.data.closedBy == request.auth.uid
              && request.resource.data.closedAt == request.time
            )
            ||
            // (f) CANCEL — draft/open → cancelled (terminal). NOT from
            //     answered. Non-whitespace reason; stamps only.
            (
              resource.data.status in ['draft', 'open']
              && request.resource.data.status == 'cancelled'
              && changedKeys().hasOnly(['status', 'cancelReason', 'cancelledAt', 'cancelledBy', 'updatedAt', 'updatedBy'])
              && nonBlank(request.resource.data.cancelReason, 500)
              && request.resource.data.cancelledBy == request.auth.uid
              && request.resource.data.cancelledAt == request.time
            )
          );

      allow delete: if false;
    }

    // PULSE™ acknowledgements — ONE management record per indicator (ADR-49), keyed
    // by the indicator id: a note, a REQUIRED review-by date and the evidence keys.
    match /companies/{companyId}/projects/{projectId}/pulseAcknowledgements/{indicatorId} {
      // Read audience — the PULSE tab's roles, includes qs.
      function pulseReader() {
        return sameCompany(companyId) && memberRole() in ['company_admin', 'project_manager', 'qs'];
      }
      // Write audience — deliberately EXCLUDES qs.
      function pulseWriter() {
        return sameCompany(companyId) && memberRole() in ['company_admin', 'project_manager'];
      }
      function corePreserved() {
        return request.resource.data.indicatorId == resource.data.indicatorId
            && request.resource.data.createdAt   == resource.data.createdAt
            && request.resource.data.createdBy   == resource.data.createdBy;
      }
      // Every update carries exactly the next revision.
      function nextRevision() {
        return request.resource.data.revision is int
            && request.resource.data.revision == resource.data.revision + 1;
      }
      // EXACT shape — hasOnly + hasAll together mean no field may be added,
      // renamed, or omitted (the ADR-27 lesson).
      function exactKeys() {
        return request.resource.data.keys().hasOnly([
         'indicatorId', 'status', 'evidenceKeys', 'note', 'reviewBy',
         'acknowledgedAt', 'acknowledgedBy', 'withdrawnAt', 'withdrawnBy',
         'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
               ])
            && request.resource.data.keys().hasAll([
         'indicatorId', 'status', 'evidenceKeys', 'note', 'reviewBy',
         'acknowledgedAt', 'acknowledgedBy', 'withdrawnAt', 'withdrawnBy',
         'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
               ]);
      }
      // The nine PULSE indicator ids (lib/pulse.js → INDICATOR): the six of
      // 1A (ADR-47) plus the three schedule indicators of 1C (ADR-67) — the
      // document id AND the stored field, which must agree.
      function indicatorValid() {
        return indicatorId in [
         'forecastOverBudget', 'forecastIncomplete', 'negativeGrossProfit',
         'overdueActivities', 'blockedActivities', 'dependencyReview', 'baselineSlippage',
         'pastDueSupplierInvoices', 'pendingVariationExposure'
               ]
            && request.resource.data.indicatorId == indicatorId;
      }
      // The content of an ACTIVE acknowledgement — required at create and at
      // every re-acknowledgement. Element types and truthfulness of
      // evidenceKeys are NOT checkable here.
      function activeShape() {
        return exactKeys()
            && indicatorValid()
            && request.resource.data.status == 'active'
            && request.resource.data.evidenceKeys is list
            && request.resource.data.evidenceKeys.size() <= 200
            && request.resource.data.note is string
            && request.resource.data.note.trim().size() > 0
            && request.resource.data.note.size() <= 500
            && isIsoDate(request.resource.data.reviewBy)
            && request.resource.data.acknowledgedBy == request.auth.uid
            && request.resource.data.acknowledgedAt == request.time
            && request.resource.data.withdrawnAt == null
            && request.resource.data.withdrawnBy == null;
      }

      allow read: if pulseReader();

      allow create: if pulseWriter()
          && activeShape()
          && request.resource.data.revision == 1
          && createStamped()
          && updateStamped();

      allow update: if pulseWriter() && corePreserved() && updateStamped() && nextRevision() && (
            // (a) RE-ACKNOWLEDGE — from active OR withdrawn; a fresh statement with fresh
            //     stamps replaces the previous one (no history — ADR-49).
            (
              activeShape()
            )
            ||
            // (b) WITHDRAW — active → withdrawn; stamps and status only, so the acknowledged
            //     content stays as the record. withdrawn → withdrawn is excluded.
            (
              resource.data.status == 'active'
              && request.resource.data.status == 'withdrawn'
              && changedKeys().hasOnly(['status', 'withdrawnAt', 'withdrawnBy', 'revision', 'updatedAt', 'updatedBy'])
              && request.resource.data.withdrawnBy == request.auth.uid
              && request.resource.data.withdrawnAt == request.time
            )
          );

      allow delete: if false;
    }

    // ── Quant™ takeoff pages (ADR-51) — one document per (drawing, revision, page),
    // id `{drawingId}_{revisionId}_{page}` RECOMPUTED from the stored fields; holds
    // the canonical geometry and CURRENT calibration. NON-FINANCIAL.
    match /companies/{companyId}/projects/{projectId}/takeoffPages/{takeoffPageId} {
      function quantMember() {
        return sameCompany(companyId) && memberRole() in ['company_admin', 'project_manager', 'qs'];
      }
      // Every update carries exactly the next revision.
      function nextRevision() {
        return request.resource.data.revision is int
            && request.resource.data.revision == resource.data.revision + 1;
      }
      // EXACT shape — hasOnly + hasAll (the ADR-27 lesson).
      function exactKeys(d) {
        return d.keys().hasOnly([
         'drawingId', 'revisionId', 'page', 'source', 'pageWidth', 'pageHeight', 'pageRotation',
         'calibration', 'calibrationRevision', 'calibratedAt', 'calibratedBy',
         'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
               ])
            && d.keys().hasAll([
         'drawingId', 'revisionId', 'page', 'source', 'pageWidth', 'pageHeight', 'pageRotation',
         'calibration', 'calibrationRevision', 'calibratedAt', 'calibratedBy',
         'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
               ]);
      }
      // The document id IS the sheet identity.
      function identityValid(d) {
        return d.drawingId is string && d.drawingId.size() > 0
            && d.revisionId is string && d.revisionId.size() > 0
            && d.page is int && d.page >= 1
            && takeoffPageId == d.drawingId + '_' + d.revisionId + '_' + string(d.page);
      }
      // The referenced drawing and revision must exist and NEITHER may be withdrawn
      // (checked on the INCOMING document at create, the STORED identity at update).
      // Reads are deliberately NOT gated: a withdrawn sheet's takeoff stays history.
      function sourceLive(d) {
        return exists(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/drawings/$(d.drawingId))
            && get(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/drawings/$(d.drawingId)).data.status != 'withdrawn'
            && exists(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/drawings/$(d.drawingId)/revisions/$(d.revisionId))
            && get(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/drawings/$(d.drawingId)/revisions/$(d.revisionId)).data.status != 'withdrawn';
      }
      function geometryValid(d) {
        return d.source in ['pdf', 'image']
            && d.pageWidth is number && d.pageWidth > 0
            && d.pageHeight is number && d.pageHeight > 0
            && d.pageRotation in [0, 90, 180, 270];
      }
      function pointValid(p) {
        return p is map && p.keys().hasOnly(['x', 'y']) && p.x is number && p.y is number;
      }
      function calibrationValid(c) {
        return c is map
            && c.keys().hasOnly(['pointA', 'pointB', 'pageDistance', 'realDistance', 'unit'])
            && c.keys().hasAll(['pointA', 'pointB', 'pageDistance', 'realDistance', 'unit'])
            && pointValid(c.pointA) && pointValid(c.pointB)
            && c.pageDistance is number && c.pageDistance > 0
            && c.realDistance is number && c.realDistance > 0
            && c.unit in ['mm', 'm'];
      }
      // Identity, geometry and creation stamps never move.
      function corePreserved() {
        return request.resource.data.drawingId    == resource.data.drawingId
            && request.resource.data.revisionId   == resource.data.revisionId
            && request.resource.data.page         == resource.data.page
            && request.resource.data.source       == resource.data.source
            && request.resource.data.pageWidth    == resource.data.pageWidth
            && request.resource.data.pageHeight   == resource.data.pageHeight
            && request.resource.data.pageRotation == resource.data.pageRotation
            && request.resource.data.createdAt    == resource.data.createdAt
            && request.resource.data.createdBy    == resource.data.createdBy;
      }

      allow read: if quantMember();

      allow create: if quantMember()
          && exactKeys(request.resource.data)
          && identityValid(request.resource.data)
          && sourceLive(request.resource.data)
          && geometryValid(request.resource.data)
          && request.resource.data.revision == 1
          && createStamped()
          && updateStamped()
          && (
               // (a) UNCALIBRATED BIRTH — made before the first count
               //     on a page nobody has calibrated.
               (
                 request.resource.data.calibration == null
                 && request.resource.data.calibrationRevision == 0
                 && request.resource.data.calibratedAt == null
                 && request.resource.data.calibratedBy == null
               )
               ||
               // (b) FIRST CALIBRATION.
               (
                 calibrationValid(request.resource.data.calibration)
                 && request.resource.data.calibrationRevision == 1
                 && request.resource.data.calibratedBy == request.auth.uid
                 && request.resource.data.calibratedAt == request.time
               )
             );

      // The ONLY update is a (re-)calibration: calibration + revision exactly +1 and
      // nothing else; a sheet whose revision or drawing is withdrawn is history.
      allow update: if quantMember()
          && exactKeys(request.resource.data)
          && corePreserved()
          && sourceLive(resource.data)
          && updateStamped()
          && nextRevision()
          && changedKeys().hasOnly(['calibration', 'calibrationRevision', 'calibratedAt', 'calibratedBy', 'revision', 'updatedAt', 'updatedBy'])
          && calibrationValid(request.resource.data.calibration)
          && request.resource.data.calibrationRevision == resource.data.calibrationRevision + 1
          && request.resource.data.calibratedBy == request.auth.uid
          && request.resource.data.calibratedAt == request.time;

      allow delete: if false;
    }

    // ── Quant™ takeoff measurements (ADR-51) — a length, area or count in the
    // canonical coordinates of one page; the quantity is NEVER stored (derived
    // from `points` and the calibration SNAPSHOT). NON-FINANCIAL; BOQ link ADR-52.
    match /companies/{companyId}/projects/{projectId}/takeoffMeasurements/{measurementId} {
      function quantMember() {
        return sameCompany(companyId) && memberRole() in ['company_admin', 'project_manager', 'qs'];
      }
      // Every update carries exactly the next revision.
      function nextRevision() {
        return request.resource.data.revision is int
            && request.resource.data.revision == resource.data.revision + 1;
      }
      // `boqItemId` (ADR-52) and `deductions` (ADR-54) are OPTIONAL: present on later
      // writes, absent on earlier documents, which stay valid.
      function exactKeys(d) {
        return d.keys().hasOnly([
         'takeoffPageId', 'drawingId', 'revisionId', 'page', 'kind', 'points', 'label',
         'costCodeId', 'costCodeName', 'calibration', 'boqItemId', 'deductions',
         'status', 'voidReason', 'voidedAt', 'voidedBy',
         'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
               ])
            && d.keys().hasAll([
         'takeoffPageId', 'drawingId', 'revisionId', 'page', 'kind', 'points', 'label',
         'costCodeId', 'costCodeName', 'calibration',
         'status', 'voidReason', 'voidedAt', 'voidedBy',
         'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
               ]);
      }
      // The BOQ link (ADR-52): absent / null, or an active item IN THIS PROJECT sharing
      // the measurement's cost code. Unit compatibility and the aggregate are DC33.
      function linkValid(d) {
        return !('boqItemId' in d)
            || d.boqItemId == null
            || (
         d.boqItemId is string && d.boqItemId.size() > 0 && d.boqItemId.size() <= 128
         && exists(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/boqItems/$(d.boqItemId))
         && get(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/boqItems/$(d.boqItemId)).data.status == 'active'
         && get(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/boqItems/$(d.boqItemId)).data.costCodeId == d.costCodeId
               );
      }
      // The drawing and revision exist and NEITHER is withdrawn — checked at create
      // and on the STORED identity for an active edit; never for a read or a void.
      function sourceLive(d) {
        return exists(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/drawings/$(d.drawingId))
            && get(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/drawings/$(d.drawingId)).data.status != 'withdrawn'
            && exists(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/drawings/$(d.drawingId)/revisions/$(d.revisionId))
            && get(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/drawings/$(d.drawingId)/revisions/$(d.revisionId)).data.status != 'withdrawn';
      }
      // The sheet identity: consistent with the page id, every referenced document
      // real and live. The page must ALREADY exist (exists() sees committed state).
      function sourceValid(d) {
        return d.drawingId is string && d.drawingId.size() > 0
            && d.revisionId is string && d.revisionId.size() > 0
            && d.page is int && d.page >= 1
            && d.takeoffPageId == d.drawingId + '_' + d.revisionId + '_' + string(d.page)
            && exists(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/takeoffPages/$(d.takeoffPageId))
            && sourceLive(d);
      }
      function snapshotValid(c) {
        return c is map
            && c.keys().hasOnly(['revision', 'pageDistance', 'realDistance', 'unit'])
            && c.keys().hasAll(['revision', 'pageDistance', 'realDistance', 'unit'])
            && c.revision is int && c.revision >= 1
            && c.pageDistance is number && c.pageDistance > 0
            && c.realDistance is number && c.realDistance > 0
            && c.unit in ['mm', 'm'];
      }
      // Deductions (ADR-54): absent, or a bounded LIST on an AREA; element content is
      // client-only — rules cannot iterate a list (DC32).
      function deductionsValid(d) {
        return !('deductions' in d)
            || (d.kind == 'area' && d.deductions is list && d.deductions.size() <= 50);
      }
      // The editable content, validated identically at create and at edit.
      function contentValid(d) {
        return d.kind in ['length', 'area', 'count']
            && deductionsValid(d)
            && d.points is list
            && d.points.size() <= 500
            && (
         (d.kind == 'length' && d.points.size() >= 2)
              || (d.kind == 'area'   && d.points.size() >= 3)
              || (d.kind == 'count'  && d.points.size() >= 1)
               )
            && d.label is string && d.label.trim().size() > 0 && d.label.size() <= 120
            && d.costCodeId is string && d.costCodeId.size() > 0
            && exists(/databases/$(database)/documents/companies/$(companyId)/costCodes/$(d.costCodeId))
            && d.costCodeName is string && d.costCodeName.trim().size() > 0 && d.costCodeName.size() <= 200
            && (
         (d.kind == 'count' && d.calibration == null)
              || (d.kind != 'count' && snapshotValid(d.calibration))
               );
      }
      function corePreserved() {
        return request.resource.data.takeoffPageId == resource.data.takeoffPageId
            && request.resource.data.drawingId     == resource.data.drawingId
            && request.resource.data.revisionId    == resource.data.revisionId
            && request.resource.data.page          == resource.data.page
            && request.resource.data.kind          == resource.data.kind
            && request.resource.data.createdAt     == resource.data.createdAt
            && request.resource.data.createdBy     == resource.data.createdBy;
      }

      allow read: if quantMember();

      allow create: if quantMember()
          && exactKeys(request.resource.data)
          && sourceValid(request.resource.data)
          && contentValid(request.resource.data)
          && linkValid(request.resource.data)
          && request.resource.data.status == 'active'
          && request.resource.data.voidReason == ''
          && request.resource.data.voidedAt == null
          && request.resource.data.voidedBy == null
          && request.resource.data.revision == 1
          && createStamped()
          && updateStamped();

      allow update: if quantMember()
          && exactKeys(request.resource.data)
          && corePreserved()
          && updateStamped()
          && nextRevision()
          && (
            // (a) ACTIVE EDIT — geometry, label, cost code, the calibration snapshot and
            //     the BOQ link may change; the status may not, no void stamp may be forged,
            //     and the sheet must still be LIVE. The link target is re-verified whenever
            //     the link OR the cost code moves.
            (
              resource.data.status == 'active'
              && request.resource.data.status == 'active'
              && changedKeys().hasOnly(['points', 'label', 'costCodeId', 'costCodeName', 'calibration', 'boqItemId', 'deductions', 'revision', 'updatedAt', 'updatedBy'])
              && sourceLive(resource.data)
              && contentValid(request.resource.data)
              && (!changedKeys().hasAny(['boqItemId', 'costCodeId']) || linkValid(request.resource.data))
            )
            ||
            // (b) ACTIVE → VOID (terminal, reasoned). Stamps and status
            //     only, so a voided measurement is immutable history.
            //     Permitted whatever the revision's status: voiding a
            //     measurement on a withdrawn sheet is housekeeping.
            (
              resource.data.status == 'active'
              && request.resource.data.status == 'void'
              && changedKeys().hasOnly(['status', 'voidReason', 'voidedAt', 'voidedBy', 'revision', 'updatedAt', 'updatedBy'])
              && request.resource.data.voidedBy == request.auth.uid
              && request.resource.data.voidedAt == request.time
              && request.resource.data.voidReason is string
              && request.resource.data.voidReason.trim().size() > 0
            )
          );

      allow delete: if false;
    }

    // Project counters — PER-PROJECT sequential numbering (today only `rfis`);
    // financial counters stay company-wide. Same audience and tenant gate as the
    // company counters; +1-only integrity is NOT enforced (DC6 / DC27). Delete blocked.
    match /companies/{companyId}/projects/{projectId}/counters/{counterId} {
      allow read, create, update: if financialMember(companyId);
      allow delete: if false;
    }

    // Contacts — the company directory (third-party PII). Financial roles read and
    // write; delete blocked (archive via isActive: false).
    match /companies/{companyId}/contacts/{contactId} {
      allow read, create, update: if request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['company_admin', 'project_manager', 'qs'];
      allow delete: if false;
    }

    // Counters — COMPANY-WIDE sequential document numbering for every financial
    // collection (RFIs use the per-project block above). Read / write restricted
    // to the roles that create numbered documents; +1-only integrity is NOT
    // enforced (DC6).
    // ADR-96 — the company's approval-segregation policy: readable by its
    // members (the app explains a refusal), written only by the operator tool.
    match /companies/{companyId}/approvalPolicy/{policyId} {
      allow read: if sameCompany(companyId);
      allow create, update, delete: if false;
    }

    match /companies/{companyId}/counters/{counterId} {
      // ADR-90: the two variation counters, (Phase 2 step 5) the refund and
      // receipt-application counters, and (ADR-93 / ADR-94) the five supplier
      // registers' counters are read and advanced ONLY by the trusted backend —
      // no client reads or writes them.
      allow read, create, update: if request.auth != null
          && !(counterId in ['variationsClient', 'variationsSupplier', 'clientRefunds', 'clientReceiptApplications', 'progressClaims', 'supplierInvoices', 'supplierCreditNotes', 'retentionReleases', 'supplierPayments'])
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['company_admin', 'project_manager', 'qs'];
      allow delete: if false;
    }
  }
}
