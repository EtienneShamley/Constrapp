# Emulator / automated-test project (demo-constrap-test). NON-SECRET.
# The invitation link base for emulator-generated invitations.
APP_BASE_URL=http://localhost:5173
EMAIL_FROM=Constrap <noreply@localhost>
TEAM_MANAGEMENT_ENABLED=true
# ADR-74 — the file-link revocation worker. The emulator suite injects a fake
# bucket and never runs the scheduled function against Storage.
FILE_LINK_REVOCATION_ENABLED=true
STORAGE_BUCKET=
# ADR-75 — periodic reconciliation is OFF here too; the suite passes the
# interval to the worker directly.
FILE_LINK_RECONCILE_INTERVAL_HOURS=0
FILE_LINK_WORKER_SERVICE_ACCOUNT=file-link-worker@demo-constrap-test.iam.gserviceaccount.com
# ADR-77 — the approveFinalAccount callable is enabled for the emulator suite.
FINAL_ACCOUNT_APPROVAL_ENABLED=true
# ADR-81 — the transferBoqToBudget callable is enabled for the emulator suite.
BOQ_BUDGET_TRANSFER_ENABLED=true
# ADR-89 — the four client-finance callables are enabled for the emulator suite.
CLIENT_FINANCE_POSTING_ENABLED=true
# ADR-89 — the two client-receipt callables are enabled for the emulator suite.
CLIENT_RECEIPT_POSTING_ENABLED=true
# ADR-89 (S6) — receipts open to every company for the emulator suite.
CLIENT_RECEIPT_ALL_COMPANIES=true
# Phase 2 step 5 — client refunds and receipt applications enabled for the emulator suite.
CLIENT_SETTLEMENT_ENABLED=true
VARIATION_PROCESSING_ENABLED=true
# ADR-93 / ADR-94: the supplier-finance callables, ON for the emulator suites.
SUPPLIER_FINANCE_PROCESSING_ENABLED=true
CONTRACT_VALUE_REVISION_ENABLED=true
# ADR-97: the estimating callable, ON for the emulator suites.
ESTIMATING_ENABLED=true
