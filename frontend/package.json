{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "test:boq": "node scripts/boq-dev.mjs",
    "test:credit-notes": "node scripts/credit-notes-dev.mjs",
    "test:quant": "node scripts/quant-dev.mjs",
    "test:tender": "node scripts/tender-dev.mjs",
    "test:team": "node scripts/team-dev.mjs",
    "rules:transitional": "node scripts/build-transitional-rules.mjs",
    "rules:transitional:check": "node scripts/build-transitional-rules.mjs --check",
    "functions:calc": "node scripts/build-final-account-bundle.mjs",
    "functions:calc:check": "node scripts/build-final-account-bundle.mjs --check",
    "functions:transfer-calc": "node scripts/build-boq-transfer-bundle.mjs",
    "functions:transfer-calc:check": "node scripts/build-boq-transfer-bundle.mjs --check",
    "functions:finance-calc": "node scripts/build-client-finance-bundle.mjs",
    "functions:finance-calc:check": "node scripts/build-client-finance-bundle.mjs --check",
    "functions:variation-calc": "node scripts/build-variation-bundle.mjs",
    "functions:variation-calc:check": "node scripts/build-variation-bundle.mjs --check",
    "functions:supplier-finance-calc": "node scripts/build-supplier-finance-bundle.mjs",
    "functions:supplier-finance-calc:check": "node scripts/build-supplier-finance-bundle.mjs --check",
    "functions:estimating-calc": "node scripts/build-estimating-bundle.mjs",
    "functions:estimating-calc:check": "node scripts/build-estimating-bundle.mjs --check",
    "test:unit": "vitest run --config vitest.config.js",
    "test:rules": "node scripts/emulators-isolated.mjs firestore,storage \"vitest run --config vitest.rules.config.js\"",
    "test:functions": "node scripts/emulators-isolated.mjs auth,firestore,functions \"vitest run --config vitest.functions.config.js\"",
    "test:functions:node22": "node scripts/require-node-major.mjs 22 && npm run test:functions",
    "functions:lint": "npm --prefix functions run lint",
    "functions:test": "npm --prefix functions test",
    "functions:test:node22": "node scripts/require-node-major.mjs 22 && npm --prefix functions test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "firebase": "^12.15.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.34.2",
    "globals": "^17.6.0",
    "rolldown": "1.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "24.19.0"
  }
}
