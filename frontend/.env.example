VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Firebase App Check (ADR-72) — reCAPTCHA Enterprise SITE key (public, like the
# values above). Required in production: the team-management callables refuse
# every request without a valid App Check token.
VITE_FIREBASE_APPCHECK_SITE_KEY=
# DEV ONLY: an App Check debug token registered in the Firebase console for
# local development against the real project. Never set in a production build.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
